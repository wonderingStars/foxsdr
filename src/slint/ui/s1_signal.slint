// SCREEN LANE S1 (wave 8; docs/multi-radio-records/screen-s1-signal.md): the receive controls whose engine commands had no control on screen, each drawn by a KPanel appended to the body of the SIGNAL
// section the person looks in (main.slint): the I/Q correction under Source; the meter's unit, the CW pitch and peak filter, the passband's presets and shape, the squelches and the frequency tracking under
// Radio; the noise-reduction method, the notch bank, the audio high-pass and low-pass, the equaliser and the stereo placement under Audio filters. The host (s1_publish.cpp) builds the rows from the engine's
// state of the selected radio and answers `act(id, text)`; an empty list draws nothing.
import { KRow } from "system_bank.slint";

export global LaneS1 {
    in property <[KRow]> rows-source;     // SIGNAL, Source: the I/Q correction
    in property <[KRow]> rows-radio;      // SIGNAL, Radio: meter unit, CW, passband, squelches, tracking and the multiplex
    in property <[KRow]> rows-audio;      // SIGNAL, Audio filters: noise-reduction method, notches, high-pass and low-pass, equaliser, stereo placement
    callback act(string, string);
}
