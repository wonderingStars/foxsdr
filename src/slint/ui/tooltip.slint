// The one tooltip. Every interactive component carries `in property <string> tooltip` and shows it after the
// pointer has rested on it: the Workbench IA gives window keys, deck keys, lamps and gestures their explanatory
// sentences, and the inventory lists each one. The delay and look are shared so a skin changes them in one place
// (Theme.menu / Theme.knob-ring / Theme.fg-soft).
//
// THE TIP LAYER. A tip is NOT a PopupWindow: Slint 1.18.1 makes a PopupWindow modal, so the first click after a
// tip appeared was eaten by the popup (measured in phase 1 by the spectrum family; the plugin kit's dense key
// panels suffered most). A TipTimer instead writes the global TipState (what to say, where, who asked), and ONE
// TipLayer, the LAST element of every Window, draws the TooltipFace from it. The layer has no TouchArea, so the
// click goes through to the key under the pointer.
//
// Use, INSIDE the component, after the TouchArea it watches:
//   area := TouchArea { ... }
//   TipTimer { x: 0px; y: 0px; hovered: area.has-hover; text: root.tooltip; anchor-h: root.height; }
// and, once per Window, as its last element:
//   TipLayer { x: 0px; y: 0px; win-w: root.width; win-h: root.height; }
// Inside a PopupWindow (a Menu's items, a dropdown's rows) the layer would sit UNDER the popup: those few use
// PopupTipTimer (the same properties) and end the popup's content with a PopupTipLayer { area-w: ...; area-h: ...; } that draws their tip.
import { Theme } from "theme.slint";

// The tip's face, for anything that wants to draw one in a popup of its own.
export component TooltipFace inherits Rectangle {
    in property <string> text;
    width: body.preferred-width;
    height: body.preferred-height;
    background: Theme.menu;
    border-width: Theme.hairline;
    border-color: Theme.knob-ring;
    border-radius: Theme.radius;
    drop-shadow-blur: Theme.shadows ? 10px : 0px;
    drop-shadow-offset-y: Theme.shadows ? 4px : 0px;
    drop-shadow-color: Theme.shadows ? Theme.well-deep.with-alpha(0.7) : transparent;
    body := HorizontalLayout {
        padding-left: 10px; padding-right: 10px; padding-top: 6px; padding-bottom: 6px;
        Text {
            text: root.text;
            color: Theme.fg-soft;
            font-family: Theme.font-ui;
            font-size: Theme.font-small;
            wrap: word-wrap;
            max-width: 360px;
        }
    }
}

// The one tip on screen: written by the TipTimer that asked, drawn by the TipLayer.
export global TipState {
    in-out property <bool> shown;
    in-out property <length> x;
    in-out property <length> y; in-out property <length> anchor-y;   // anchor-y: the top of the item the tip is for (drive fixes 4: a tip that does not fit below it opens ABOVE it, not over it)
    in-out property <string> text;
    in-out property <int> owner;          // the id of the TipTimer that opened the tip (0 = none)
    in-out property <int> next-id;        // the counter each TipTimer takes its id from when it is created
    in-out property <int> beat;           // the owner bumps it while it lives; the layer hides a tip whose owner went away
    // THE ONE CLOCK. A tip owner carries no Timer of its own: a Slint timer that is already due when the page holding it is rebuilt by
    // ANOTHER timer's callback (the host's 33 ms tick, a drive's input timer) is still called once afterwards, on a component that
    // has been destroyed, and crashed (Slint 1.18.1; the Outputs page's TCI port row, drive s4-outputs). The TipLayer lives as long as
    // the window and owns the only timer; it keeps `now` (milliseconds of the animation clock) up to date. An owner reads `now` in a binding and acts in a `changed` handler,
    // which goes away with the owner.
    in-out property <float> now;          // the animation clock in ms, refreshed every 20 ms while `watch-until` is ahead of it or a tip is on screen
    in-out property <float> watch-until;  // an owner that waits for its 600 ms asks the clock to run until this time
    in-out property <bool> in-popup;      // the owner lives inside a PopupWindow: x / y / anchor-y are in the popup's frame and that popup's PopupTipLayer draws the tip, not the window's TipLayer
}

// Opens the tip below its parent after 600 ms of hover and closes it when the pointer leaves. Writes TipState
// (the TipLayer draws it). Sits at its parent's origin (x: 0 y: 0, zero-sized), so its absolute-position is the
// parent's.
export component TipTimer {
    in property <bool> hovered;
    in property <string> text;
    in property <length> anchor-h;          // the parent's height: the tip opens 6px under it
    in property <length> anchor-x: 0px;
    in property <bool> in-popup: false;     // PopupTipTimer sets it
    // true while THIS timer's tip is the one on screen
    out property <bool> shown: TipState.shown && TipState.owner == root.my-id;
    // the owner id: the next number of the global counter, taken once when the instance is created
    private property <int> my-id;
    x: 0px; y: 0px; width: 0px; height: 0px;
    init => {
        TipState.next-id += 1;
        root.my-id = TipState.next-id;
    }
    // WAITING for the 600 ms: the pointer rests on the parent, there is something to say and the tip is not already open.
    private property <bool> wanting: root.hovered && root.text != "" && !root.shown;
    private property <float> since: -1;         // the clock's time when the wait began (-1: not waiting)
    // `ripe` reads the clock only while the owner waits, so a hundred idle owners are not re-evaluated every 20 ms
    private property <bool> ripe: root.since >= 0 && root.wanting && TipState.now - root.since >= 600;
    changed wanting => {
        if (root.wanting) {
            TipState.now = animation-tick() / 1ms;
            root.since = TipState.now;
            TipState.watch-until = Math.max(TipState.watch-until, TipState.now + 700);
        } else { root.since = -1; }
    }
    changed ripe => {
        if (root.ripe) {
            TipState.text = root.text;
            TipState.x = root.absolute-position.x + root.anchor-x;
            TipState.y = root.absolute-position.y + root.anchor-h + 6px; TipState.anchor-y = root.absolute-position.y;
            TipState.owner = root.my-id;
            TipState.in-popup = root.in-popup;
            TipState.beat += 1;
            TipState.shown = true;
        }
    }
    // while this owner has the tip it vouches for it on every beat of the clock; a parent that is removed while hovered (a sheet that closes
    // under the pointer) stops vouching and the layer takes the tip down
    private property <float> vouch: root.shown ? TipState.now : -1;
    changed vouch => {
        if (root.shown) {
            // A TIP THAT HAS BEEN LEFT BEHIND: the item moved (a note appeared above it, a page jumped) and a pointer that has not moved keeps `hovered` true, so the tip would
            // stay where the item was, over whatever is there now ("Receiver latitude" over the Longitude field, drive fixes 3, item 7). The tip closes; if the pointer really is still
            // on the item the wait for 600 ms starts again and the tip opens under the item's new place.
            if (Math.abs(TipState.x - (root.absolute-position.x + root.anchor-x)) > 1px || Math.abs(TipState.y - (root.absolute-position.y + root.anchor-h + 6px)) > 1px) { TipState.shown = false; }
            else { TipState.beat += 1; }
        }
    }
    changed hovered => {
        if (!self.hovered && root.shown) { TipState.shown = false; }
    }
}

// A one-line piece of text that elides when its box is short of the words and then says the whole of itself in the tip (docs 6.62, the clip sweep: the receiver strip's hint lines, the
// counter plate's caption, the age axis). It sits where the Text sat: a layout reads its natural width as the preferred width and no minimum, so a longer translation never widens the row; a
// parent that is not a layout gives it an explicit width and height. The text is never shortened, only given a tip.
export component ElidedHint inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.dim;
    in property <string> family: Theme.font-ui;
    in property <length> font-size: Theme.font-hint;
    in property <int> font-weight: 400;
    in property <length> letter-spacing: 0px;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    // `pointer: false` for a hint that sits over something that owns the pointer (the counter plate's right-click menu): it then draws no TouchArea of its own and the owner says when
    // the pointer is over it through `hovered`.
    in property <bool> pointer: true;
    in property <bool> hovered;
    out property <bool> elided: label.preferred-width > label.width + 0.5px;
    property <bool> own-hover;
    min-width: 0px;
    preferred-width: label.preferred-width;
    preferred-height: label.preferred-height;
    label := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.ink;
        font-family: root.family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        letter-spacing: root.letter-spacing;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.pointer : TouchArea { changed has-hover => { root.own-hover = self.has-hover; } }
    TipTimer { x: 0px; y: 0px; hovered: root.pointer ? root.own-hover : root.hovered; text: root.elided ? root.text : ""; anchor-h: root.height; }
}

// The layer: the LAST element of a Window, zero-sized at its origin, drawing the tip over everything (torn-off
// pages and sheets included). `win-w` / `win-h` are the window's size, which a component cannot read itself.
// No TouchArea: the pointer events go through to what is under the tip.
export component TipLayer {
    in property <length> win-w;
    in property <length> win-h;
    private property <int> seen-beat: -1;
    x: 0px; y: 0px; width: 0px; height: 0px;
    if TipState.shown && !TipState.in-popup : TooltipFace {
        text: TipState.text;
        x: max(0px, min(TipState.x, root.win-w - self.width));
        y: TipState.y + self.height > root.win-h ? max(0px, TipState.anchor-y - 6px - self.height) : max(0px, TipState.y);   // below the item when it fits, else above it (the status bar's chips sit on the window's bottom edge)
    }
    // THE ONE CLOCK of the tips (see TipState): ticks while an owner waits for its 600 ms or a tip is on screen, and sleeps otherwise.
    Timer {
        interval: 20ms;
        running: TipState.now < TipState.watch-until || TipState.shown;
        triggered => { TipState.now = animation-tick() / 1ms; }
    }
    Timer {
        interval: 400ms;
        running: TipState.shown;
        triggered => {
            if (TipState.beat == root.seen-beat) { TipState.shown = false; }
            root.seen-beat = TipState.beat;
        }
    }
}

// The tip for a TipTimer that lives inside a PopupWindow (a Menu's items, the palette's rows, a dropdown's rows). It is NOT a popup of its own and has no Timer of its own
// (the TipLayer's one clock runs it, as for every tip owner): a PopupWindow is modal in Slint 1.18.1, so a tip opened as one took the pointer from the row under it,
// the row lost its hover, the tip closed, the hover came back on the next pointer move and 600 ms later the tip opened again - a tip that flashed under a pointer that was
// only resting (problem report b277ab24). It writes TipState exactly as TipTimer does; the popup draws the tip with a PopupTipLayer as the last element of its content
// (the window's TipLayer is under the popup).
export component PopupTipTimer inherits TipTimer { in-popup: true; }

// The window's TipLayer is UNDER a popup, so a popup that holds rows with tips ends with one of these: the same face, from the same TipState, placed in the popup's own
// frame. Zero-sized, no TouchArea (the pointer goes through to the row). A popup clips what it draws to its own rectangle, so the tip is kept inside the popup (above the
// row when there is no room below it, pushed left when it would pass the right edge).
export component PopupTipLayer {
    in property <length> area-w;            // the popup's content size
    in property <length> area-h;
    x: 0px; y: 0px; width: 0px; height: 0px;
    if TipState.shown && TipState.in-popup : TooltipFace {
        text: TipState.text;
        x: max(0px, min(TipState.x - root.absolute-position.x, root.area-w - self.width));
        y: TipState.y - root.absolute-position.y + self.height > root.area-h ? max(0px, TipState.anchor-y - root.absolute-position.y - 6px - self.height) : TipState.y - root.absolute-position.y;   // below the row when it fits in the popup, else above it
    }
}
