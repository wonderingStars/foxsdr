// FoxSDR Slint front end - THE RADIO WORKSPACE (docs/multi-radio-screen-design.md 3.4, built in stage S3; docs/multi-radio-records/screen-s3.md).
//
//   WorkspaceBar     the bar over the view (RECEIVER tab, and every tab in a compact window; only when more than one radio is open), as many 30 px rows as the width asks: "Layout" One / Side by side / 2 x 2,
//                    the page keys "Radios 1-4" "Radios 5-8" (only when a radio lives beyond the first page), "Link tuning", "Start together", in a compact window the radios' selector, STOP keys and
//                    MASTER lamps, and the small-window notice. (Stage S5 made it wrap; it was one 30 px row, clipped at 800 px.)
//   RadioWorkspace   the grid of RadioPanes: Two = two columns side by side, Four = 2 x 2, 6 px gaps. One is NOT drawn here: layout One is the receiver view of MainWindow, untouched.
//   WorkspaceModel   what the host publishes (the layout it chose, the page, the radios' panes in ONE model by radio slot) and every gesture that comes back, each with the radio's number.
//
// A pane exists only while its radio is on screen: panes are made per radio slot, so a pane's own state (its splitter) is kept for the radio in WorkspaceModel.splits and is back when its page comes
// back. A pane's gestures are the host's: it aims each at the pane's radio (FoxCommand.target) and does not move the selection; the header, the tag and the readout row select (the pane says
// select-requested), and so does a right-click (the menu is the selected radio's).
//
// STAGE S4 (docs/multi-radio-records/screen-s4.md): the model also carries the strip's selector, the MASTER lamps, the Audio mix rows, the Add-a-radio card and the question before a running radio
// is removed (the components that draw them are in radio_strip.slint and here). An empty cell draws the card "Add a radio" (RADIO_ADD) when a radio can be added, else the quiet well it drew in S3.
// The layout and the page are the host's to decide (the keys only ask): the host sets `layout` and `page` back, so a refused or clamped choice never leaves the keys lying.
import { Theme } from "theme.slint";
import { Caption, SegGroup, SegKey, Key } from "keys.slint";
import { RadioPane, RadioPaneData } from "radio_pane.slint";
import { SelectorKeys, StopKeys, MasterLamps } from "radio_strip.slint";
import { WorkspaceModel, WorkspaceCell, StripRadio, MasterLamp, MixRow, AddChoice } from "workspace_model.slint";
export { WorkspaceModel, WorkspaceCell, StripRadio, MasterLamp, MixRow, AddChoice }



// THE BAR'S MEASURES: each group of the bar reports its own width here (a group that is not drawn is not counted: the bar knows which ones it has). A global, because a group is made by an `if`
// and the bar cannot name an element inside one.
global BarMetrics {
    in-out property <[length]> w: [0px, 0px, 0px, 0px, 0px, 0px, 0px, 0px];
}

// One group of the bar: a row of controls that reports its width. The bar places the groups by those widths and starts a new row when the next one does not fit (below).
component BarGroup inherits Rectangle {
    in property <int> index;
    out property <length> pw: row.preferred-width;
    height: 30px;
    init => { BarMetrics.w[root.index] = root.pw; }
    changed pw => { BarMetrics.w[root.index] = root.pw; }
    row := HorizontalLayout {
        spacing: 8px;
        alignment: start;
        @children
    }
}

// THE WORKSPACE BAR (docs/multi-radio-records/screen-s3.md, screen-s5.md): over the receiver view, and in a compact window over every tab. Its groups are
//   0 "Layout" and the keys One / Side by side / 2 x 2          (RECEIVER tab)
//   1 the page keys "Radios 1-4" ...                            (RECEIVER tab, when a radio lives beyond the first page)
//   2 "Link tuning"                                             (RECEIVER tab)
//   3 "Start together"                                          (RECEIVER tab)
//   4 the selector "R1 R2 R3 R4", 5 STOP Rn and STOP ALL, 6 the MASTER lamps       (a compact window, on every tab: the strip has no room for them)
//   7 the small-window notice                                   (RECEIVER tab)
// NOTHING IS CLIPPED. The groups are placed left to right by their own widths and a group that does not fit the rest of the row starts the next one, so the bar is as many 30 px rows as the width asks for
// (one in a wide window, up to four at 800 px) and its height is `bar-h`, which the views under it start below. A group wider than the bar alone is cut at its edge (none is, down to the smallest window).
export component WorkspaceBar inherits Rectangle {
    in property <bool> compact;                      // the window's strip is compact (narrower than 1760 px): the radios' block lives here, as groups 4 to 6
    in property <bool> receiver: true;               // the RECEIVER tab: groups 0 to 3 and 7; on another tab (compact windows only) the radios' groups alone
    private property <length> pad: 8px;
    private property <length> gap: 10px;
    private property <length> right: root.width - root.pad;
    private property <length> room: max(0px, root.width - 2 * root.pad);
    // which groups are drawn, and how wide each is (never wider than the bar)
    private property <bool> s0: root.receiver;
    private property <bool> s1: root.receiver && WorkspaceModel.page-labels.length > 1;
    private property <bool> s2: root.receiver;
    private property <bool> s3: root.receiver;
    private property <bool> s4: root.compact;
    private property <bool> s5: root.compact;
    private property <bool> s6: root.compact;
    private property <bool> s7: root.receiver && WorkspaceModel.notice != "";
    private property <length> w0: root.s0 ? min(BarMetrics.w[0], root.room) : 0px;
    private property <length> w1: root.s1 ? min(BarMetrics.w[1], root.room) : 0px;
    private property <length> w2: root.s2 ? min(BarMetrics.w[2], root.room) : 0px;
    private property <length> w3: root.s3 ? min(BarMetrics.w[3], root.room) : 0px;
    private property <length> w4: root.s4 ? min(BarMetrics.w[4], root.room) : 0px;
    private property <length> w5: root.s5 ? min(BarMetrics.w[5], root.room) : 0px;
    private property <length> w6: root.s6 ? min(BarMetrics.w[6], root.room) : 0px;
    private property <length> w7: root.s7 ? min(BarMetrics.w[7], root.room) : 0px;
    // where each group starts and which row it is on: a group goes after the one before it when it fits the rest of the row, else it starts the next row; an empty group takes no room
    pure function place-x(prev-end: length, w: length) -> length {
        if (w == 0px) { return prev-end; }
        if (prev-end <= root.pad) { return root.pad; }
        if (prev-end + root.gap + w <= root.right) { return prev-end + root.gap; }
        return root.pad;
    }
    pure function place-row(prev-row: int, prev-end: length, w: length) -> int {
        if (w == 0px) { return prev-row; }
        if (prev-end <= root.pad) { return prev-row; }
        if (prev-end + root.gap + w <= root.right) { return prev-row; }
        return prev-row + 1;
    }
    private property <length> x0: root.place-x(root.pad, root.w0);
    private property <int> r0: 0;
    private property <length> e0: root.w0 == 0px ? root.pad : root.x0 + root.w0;
    private property <length> x1: root.place-x(root.e0, root.w1);
    private property <int> r1: root.place-row(root.r0, root.e0, root.w1);
    private property <length> e1: root.w1 == 0px ? root.e0 : root.x1 + root.w1;
    private property <length> x2: root.place-x(root.e1, root.w2);
    private property <int> r2: root.place-row(root.r1, root.e1, root.w2);
    private property <length> e2: root.w2 == 0px ? root.e1 : root.x2 + root.w2;
    private property <length> x3: root.place-x(root.e2, root.w3);
    private property <int> r3: root.place-row(root.r2, root.e2, root.w3);
    private property <length> e3: root.w3 == 0px ? root.e2 : root.x3 + root.w3;
    private property <length> x4: root.place-x(root.e3, root.w4);
    private property <int> r4: root.place-row(root.r3, root.e3, root.w4);
    private property <length> e4: root.w4 == 0px ? root.e3 : root.x4 + root.w4;
    private property <length> x5: root.place-x(root.e4, root.w5);
    private property <int> r5: root.place-row(root.r4, root.e4, root.w5);
    private property <length> e5: root.w5 == 0px ? root.e4 : root.x5 + root.w5;
    private property <length> x6: root.place-x(root.e5, root.w6);
    private property <int> r6: root.place-row(root.r5, root.e5, root.w6);
    private property <length> e6: root.w6 == 0px ? root.e5 : root.x6 + root.w6;
    private property <length> x7: root.place-x(root.e6, root.w7);
    private property <int> r7: root.place-row(root.r6, root.e6, root.w7);
    out property <int> rows: root.r7 + 1;
    out property <length> bar-h: root.rows * 30px;
    // the bar tells the model how tall it is, so the view under it starts below it (written when the bar is made and whenever it changes)
    init => { WorkspaceModel.bar-h = root.bar-h; }
    changed bar-h => { WorkspaceModel.bar-h = root.bar-h; }
    height: root.bar-h;
    background: Theme.strip;
    accessible-role: groupbox;
    accessible-label: @tr("Layout");
    Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line; }
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height; clip: true;   // the bar holds its width: what does not fit is cut, never widens the window
        if root.s0 : BarGroup {
            index: 0; x: root.x0; y: root.r0 * 30px; width: root.w0;
            VerticalLayout { alignment: center; Caption { label: @tr("Layout"); font-size: Theme.font-tiny; } }
            VerticalLayout {
                alignment: center;
                SegGroup {
                    small: true;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        SegKey { label: @tr("One"); small: true; min-w: 0px; on: WorkspaceModel.layout == 0; tooltip: @tr("Show one radio, as before"); clicked => { WorkspaceModel.layout-selected(0); } }
                        SegKey { label: @tr("Side by side"); small: true; min-w: 0px; on: WorkspaceModel.layout == 1; tooltip: @tr("Show two radios side by side"); clicked => { WorkspaceModel.layout-selected(1); } }
                        SegKey { label: "2 x 2"; small: true; min-w: 0px; on: WorkspaceModel.layout == 2; tooltip: @tr("Show four radios in a 2 x 2 grid"); clicked => { WorkspaceModel.layout-selected(2); } }   // not-translated: the key's caption, as the design has it
                    }
                }
            }
        }
        // THE PAGE KEYS: one per page, the page shown is lit; only when a radio lives beyond the first page
        if root.s1 : BarGroup {
            index: 1; x: root.x1; y: root.r1 * 30px; width: root.w1;
            VerticalLayout {
                alignment: center;
                SegGroup {
                    small: true;
                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        for label[i] in WorkspaceModel.page-labels : SegKey { label: label; small: true; min-w: 0px; on: WorkspaceModel.page == i; tooltip: WorkspaceModel.page-tips[i]; clicked => { WorkspaceModel.page-selected(i); } }
                    }
                }
            }
        }
        // STAGE S5: Link tuning (an option, off by default) and Start together (RUN to every open radio)
        if root.s2 : BarGroup {
            index: 2; x: root.x2; y: root.r2 * 30px; width: root.w2;
            VerticalLayout {
                alignment: center;
                Key {
                    label: WorkspaceModel.link-text; small: true; min-w: 0px; on: WorkspaceModel.link-on; tooltip: WorkspaceModel.link-tip;
                    accessible-checkable: true; accessible-checked: WorkspaceModel.link-on;
                    clicked => { WorkspaceModel.link-toggled(); }
                }
            }
        }
        if root.s3 : BarGroup {
            index: 3; x: root.x3; y: root.r3 * 30px; width: root.w3;
            VerticalLayout {
                alignment: center;
                Key { label: WorkspaceModel.together-text; small: true; min-w: 0px; enabled: WorkspaceModel.together-enabled; tooltip: WorkspaceModel.together-tip; clicked => { WorkspaceModel.together-clicked(); } }
            }
        }
        // STAGE S4, moved here by S5: in a compact window the radios' block is three groups of this bar, on every tab
        if root.s4 : BarGroup { index: 4; x: root.x4; y: root.r4 * 30px; width: root.w4; VerticalLayout { alignment: center; SelectorKeys { } } }
        if root.s5 : BarGroup { index: 5; x: root.x5; y: root.r5 * 30px; width: root.w5; VerticalLayout { alignment: center; StopKeys { } } }
        if root.s6 : BarGroup { index: 6; x: root.x6; y: root.r6 * 30px; width: root.w6; VerticalLayout { alignment: center; MasterLamps { } } }
        // THE SMALL-WINDOW NOTICE: the multi-pane layout was chosen and the window is too small for it, so One is shown
        if root.s7 : BarGroup {
            index: 7; x: root.x7; y: root.r7 * 30px; width: root.w7;
            VerticalLayout {
                alignment: center;
                Text {
                    text: WorkspaceModel.notice;
                    color: Theme.chip-warn-fg;
                    font-size: Theme.font-small;
                    overflow: elide;
                    min-width: 0px;
                    accessible-role: text;
                    accessible-label: WorkspaceModel.notice;
                }
            }
        }
    }
}

// THE CARD "ADD A RADIO" (RADIO_ADD): the devices not already held, one key each, and "Look for radios again". In an empty cell (`slot` is its 1-based number, the radio the engine is asked for) and in the sheet the
// status bar's key opens (`slot` 0: the lowest free). A refusal is shown as the engine worded it, unchanged, under the keys.
export component AddRadioCard inherits Rectangle {
    in property <int> slot;
    in property <bool> titled: true;                 // the sheet carries its own title
    in property <string> label;
    background: root.titled ? Theme.well-deep : transparent;
    border-width: root.titled ? Theme.hairline : 0px;
    border-color: Theme.line;
    accessible-role: groupbox;
    accessible-label: root.label;
    preferred-height: body.preferred-height;
    body := VerticalLayout {
        padding: root.titled ? 14px : 0px;
        spacing: 8px;
        alignment: start;
        if root.titled : Text {
            text: WorkspaceModel.add-title;
            font-family: Theme.font-ui;
            font-size: 13px;
            font-weight: Theme.weight-semibold;
            color: Theme.fg;
            overflow: elide;
        }
        Text {
            text: WorkspaceModel.add-hint;
            font-size: Theme.font-small;
            color: Theme.muted;
            wrap: word-wrap;
        }
        Flickable {
            vertical-stretch: 0;
            preferred-height: list.preferred-height;
            viewport-height: list.preferred-height;
            list := VerticalLayout {
                spacing: 4px;
                alignment: start;
                for c[i] in WorkspaceModel.add-choices : HorizontalLayout {
                    alignment: start;
                    Key { label: c.caption; accessible-label: c.accessible; small: true; min-w: 0px; clicked => { WorkspaceModel.add-chosen(root.slot, i); } }
                }
                if WorkspaceModel.add-choices.length == 0 : Text { text: WorkspaceModel.add-none; font-size: Theme.font-small; color: Theme.dim; wrap: word-wrap; }
            }
        }
        if WorkspaceModel.add-note != "" : Text {
            text: WorkspaceModel.add-note;
            color: Theme.chip-warn-fg;
            font-size: Theme.font-small;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: WorkspaceModel.add-note;
        }
        HorizontalLayout {
            alignment: start;
            Key { label: WorkspaceModel.add-rescan; ghost: true; small: true; min-w: 0px; clicked => { WorkspaceModel.add-rescan-clicked(); } }
        }
    }
}

// An empty slot: the card when a radio can be added, else the quiet well with the slot's name.
component EmptySlot inherits Rectangle {
    in property <string> label;
    in property <int> slot;                          // 1-based
    in property <string> card-label;                 // "Add a radio to pane 3"
    background: Theme.well-deep;
    border-width: Theme.hairline;
    border-color: Theme.line;
    clip: true;
    if !WorkspaceModel.can-add : Rectangle {
        accessible-role: groupbox;
        accessible-label: root.label;
        Text {
            text: root.label;
            horizontal-alignment: center;
            vertical-alignment: center;
            font-family: Theme.font-mono;
            font-size: Theme.font-small;
            color: Theme.dim;
        }
    }
    if WorkspaceModel.can-add : AddRadioCard { x: 0px; y: 0px; width: parent.width; height: parent.height; slot: root.slot; label: root.card-label; }
}

export component RadioWorkspace inherits Rectangle {
    private property <int> psize: WorkspaceModel.shown-layout == 2 ? 4 : 2;     // the panes of a page
    private property <int> first: WorkspaceModel.page * root.psize;               // the first radio slot on the page
    private property <length> gap: 6px;
    private property <int> rows: WorkspaceModel.shown-layout == 2 ? 2 : 1;
    // the size of one pane: two columns in both layouts, one or two rows
    out property <length> cell-w: (root.width - root.gap) / 2;
    out property <length> cell-h: root.rows == 2 ? (root.height - root.gap) / 2 : root.height;
    // the host fits each pane's pictures to this size: written when the grid is made (an `if` makes it with the size already settled, so no change is seen) and whenever it changes
    init => { WorkspaceModel.cell-w = root.cell-w; WorkspaceModel.cell-h = root.cell-h; }
    changed cell-w => { WorkspaceModel.cell-w = root.cell-w; }
    changed cell-h => { WorkspaceModel.cell-h = root.cell-h; }
    background: Theme.bg;
    clip: true;

    for cell[slot] in WorkspaceModel.cells : Rectangle {
        x: Math.mod(slot - root.first, 2) * (root.cell-w + root.gap);
        y: Math.floor((slot - root.first) / 2) * (root.cell-h + root.gap);
        width: root.cell-w;
        height: root.cell-h;
        if slot >= root.first && slot < root.first + root.psize && cell.occupied : pane := RadioPane {
            width: parent.width;
            height: parent.height;
            data: cell.pane;
            selected: slot + 1 == WorkspaceModel.selected-radio;
            ribbon-size: WorkspaceModel.ribbon-size;
            split-ratio: WorkspaceModel.splits[slot];
            // A right-click's position comes from the pane relative to the pane; the host gets it in the window's own coordinates.
            select-requested(r) => { WorkspaceModel.select-requested(r); }
            stop-clicked(r) => { WorkspaceModel.stop-clicked(r); }
            spectrum-hover(r, x, y) => { WorkspaceModel.spectrum-hover(r, x, y); }
            spectrum-clicked(r, x, shift) => { WorkspaceModel.spectrum-clicked(r, x, shift); }
            spectrum-double-clicked(r, x) => { WorkspaceModel.spectrum-double-clicked(r, x); }
            spectrum-menu-requested(r, x, px, py) => { WorkspaceModel.spectrum-menu-requested(r, x, pane.absolute-position.x + px, pane.absolute-position.y + py); }
            band-dragged(r, dx) => { WorkspaceModel.band-dragged(r, dx); }
            edge-dragged(r, h) => { WorkspaceModel.edge-dragged(r, h); }
            spectrum-wheel(r, x, n, shift) => { WorkspaceModel.spectrum-wheel(r, x, n, shift); }
            waterfall-hover(r, x, y) => { WorkspaceModel.waterfall-hover(r, x, y); }
            waterfall-clicked(r, x, shift) => { WorkspaceModel.waterfall-clicked(r, x, shift); }
            waterfall-panned(r, dx) => { WorkspaceModel.waterfall-panned(r, dx); }
            waterfall-double-clicked(r) => { WorkspaceModel.waterfall-double-clicked(r); }
            waterfall-menu-requested(r, x, px, py) => { WorkspaceModel.waterfall-menu-requested(r, x, pane.absolute-position.x + px, pane.absolute-position.y + py); }
            waterfall-wheel(r, x, n, shift) => { WorkspaceModel.waterfall-wheel(r, x, n, shift); }
            marker-hovered(r, i) => { WorkspaceModel.marker-hovered(r, i); }
            split-changed(r, v) => { WorkspaceModel.splits[r - 1] = v; }
            link-clicked(r) => { WorkspaceModel.pane-link-clicked(r); }
            close-clicked(r) => { WorkspaceModel.remove-requested(r); }
        }
        if slot >= root.first && slot < root.first + root.psize && !cell.occupied : EmptySlot {
            width: parent.width;
            height: parent.height;
            label: cell.label;
            slot: slot + 1;
            card-label: cell.card-label;
        }
    }
}
