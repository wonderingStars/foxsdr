        lamp-amber-cap: #e2d2a6, lamp-red: #E0603F, lamp-red-cap: #e2bfa6, lamp-yellow: #e9c379,
        lamp-yellow-cap: #e4d8b5, chip-bg: #646E45, chip-fg: #F1EEDD, chip-line: #2C321E,
        chip-good-bg: #455730, chip-good-fg: #9FE870, chip-good-line: #6a924a, chip-warn-bg: #504d28,
        chip-warn-fg: #e9c379, chip-warn-line: #8a7232, chip-err-bg: #504128, chip-err-fg: #f0b09f,
        chip-err-line: #8a4e32, key-bg: #646E45, key-line: #2C321E, key-fg: #F1EEDD,
        key-disabled-bg: #343B24, key-disabled-fg: #abab8c, danger-bg: #93301C, danger-line: #1C2012,
        danger-strong-line: #E0603F, danger-fg: #FFF4E6, danger-glyph: #f9d6c5, hazard-line: #937833,
        hazard-stripe: #504d28, plate-line: #D6BF5E, plate-fg: #D6BF5E, slider-track: #5D6641,
        slider-fill: #D6BF5E, slider-knob: #F1EEDD, slider-knob-ring: #343B24, slider-disabled-fill: #76795e,
        slider-disabled-knob: #909274, level-bar: #9FE870, meter-face: #E9E4CF, meter-ink: #1C1F12,
        meter-needle: #93301C, meter-led-low: #9FE870, meter-led-mid: #E0A93F, meter-led-high: #E0603F,
        meter-peak: #D6BF5E, trace-live: #B6E36A, trace-peak: #E0A93F, trace-average: #E3DFC9,
        radio-1: #4da3ff, radio-2: #f5a524, radio-3: #3ddc84, radio-4: #b48cff,
        radio-ink: #23271A, vfo: #D6BF5E, vfo-fill: #D6BF5E22, bandplan: #545530,
        bandplan-fg: #ebe9d9, mark: #b6a552, mark-fill: #b6a55222, bookmark: #D6BF5E,
        bookmark-tick: #D6BF5E, marker: #E3DFC9, cursor: #E3DFC966, cursor-chip-bg: #0F140Bdd,
        cursor-chip-line: #2C321E, graticule: #3e452b, axis-fg: #abab8c, wf-floor: #0F140B,
        wf-mid: #2C4414, wf-high: #79A52C, wf-hot: #E0EE7A, wf-peak: #ffffff,
        wf-vfo: #E0A93F, wf-key-bg: #0F140Bdd,
        font-ui: "JetBrains Mono", font-mono: "JetBrains Mono",   // not-translated: typeface names, not words
        radius: 2px, radius-panel: 2px, radius-seg: 2px, radius-seg-key: 2px, radius-chip: 3px, radius-dome: 10px, radius-menu-item: 2px,
        digit-face: DigitFace.plain, lamp-glow: false, shadows: false, hairline: 1px,
