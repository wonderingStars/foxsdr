// FoxSDR Slint front end - THE THEME: one struct, many fillings.
//
// The handover's rule: a theme is a set of property values on ONE component library, so the 21 themes
// of the design canvas are 21 fillings of the same struct. Every colour, font, radius and signature
// drawing switch a component may use lives in `Skin`; `Theme` is the global every component reads
// (`Theme.bg`, `Theme.accent`, ...) and holds the filling in force (`Theme.skin`). Workbench - row 16,
// "the arrangement I'd build" - is the filling here, lifted from the sheets' <helmet><style> blocks
// (Workbench.dc.html, Workbench-PluginKit.dc.html). A skin (Cupertino, Obsidian, Atelier, Vitrine,
// Horology - the owner has not chosen) is added as ANOTHER `Skin` value and installed with one
// assignment `Theme.skin = ...` (from .slint or from C++ through the exported global): no component
// changes. tests/test_slint_theme.cpp proves that with a second, trivial filling.
//
// METRICS (key heights, panel widths, font sizes) are NOT part of the skin in phase 1: the Workbench
// arrangement is the one layout, and the artboards' pixel measurements are what the render tests check.
// They are constants on `Theme` so a later density setting has one place to change.

// The two typefaces, vendored under third_party/fonts (SIL OFL 1.1, licence texts beside them) and embedded into the
// build by the Slint compiler: importing a font file registers it under its family name, so "Inter" and
// "JetBrains Mono" below resolve to these files on every machine, not to whatever the OS has installed.
import "../../../third_party/fonts/Inter-Regular.ttf";
import "../../../third_party/fonts/Inter-Medium.ttf";
import "../../../third_party/fonts/Inter-SemiBold.ttf";
import "../../../third_party/fonts/JetBrainsMono-Regular.ttf";
import "../../../third_party/fonts/JetBrainsMono-Medium.ttf";
import "../../../third_party/fonts/JetBrainsMono-SemiBold.ttf";

export enum DigitFace { plain, drum, nixie }
export enum MeterStyle { classic, analogue, led-ladder, peak }

export struct Skin {
    // ---- grounds ----
    bg: color,              // body, rail, window ground
    strip: color,           // receiver strip, status bar, table heading row
    panel: color,           // .panel, open section body, splitter, palette field
    panel-alt: color,       // sections panel, .seg ground
    card: color,            // update / team-message card, table band row
    well: color,            // spectrum ground
    well-deep: color,       // waterfall ground
    field: color,           // counter ground, text fields, decoder output, figure cells
    menu: color,            // menus, torn-off window title strips, chip ground, key ground
    menu-hot: color,        // hovered menu item
    table-selected: color,  // selected table row ground
    card-warn: color,       // warning card ground
    card-warn-line: color,
    card-err: color,        // error card ground
    card-err-line: color,
    backdrop: color,        // the dimmed sheet backdrop behind a dialog

    // ---- lines ----
    line: color,            // every 1px divider
    line-strong: color,     // key / chip / seg borders
    line-faint: color,      // spectrum graticule
    knob-ring: color,       // lamp-off ring, torn-off window border, cursor chip border, counter dots, menu border

    // ---- text ----
    fg: color,
    fg-soft: color,
    muted: color,           // captions, chevrons, table headings
    dim: color,             // hints, axis labels, status-bar keys
    faint: color,           // F-key hints, unit row, maker mark
    nudge: color,           // digit nudge arrows
    disabled: color,        // disabled key / menu-item text
    focus: color,           // keyboard focus ring

    // ---- accent (amber on Workbench) ----
    accent: color,
    accent-ink: color,      // text on an accent key
    accent-soft: color,     // tuned readout, bookmarks, warn chip text, plate-key text
    accent-hover: color,
    digit: color,           // counter numerals
    digit-glow: color,      // their glow (transparent = none)
    digit-dim: color,       // dimmed leading zero

    // ---- lamps: dot colour, and the caption colour while lit ----
    lamp-off: color,
    lamp-ring: color,
    lamp-green: color,
    lamp-green-cap: color,
    lamp-amber: color,
    lamp-amber-cap: color,
    lamp-red: color,
    lamp-red-cap: color,
    lamp-yellow: color,
    lamp-yellow-cap: color,

    // ---- chips ----
    chip-bg: color,
    chip-fg: color,
    chip-line: color,
    chip-good-bg: color,
    chip-good-fg: color,
    chip-good-line: color,
    chip-warn-bg: color,
    chip-warn-fg: color,
    chip-warn-line: color,
    chip-err-bg: color,
    chip-err-fg: color,
    chip-err-line: color,

    // ---- keys ----
    key-bg: color,
    key-line: color,
    key-fg: color,
    key-disabled-bg: color,
    key-disabled-fg: color,
    danger-bg: color,       // the STOP key and .btn.danger
    danger-line: color,
    danger-strong-line: color, // the STOP dome's border
    danger-fg: color,
    danger-glyph: color,
    hazard-line: color,     // BIAS TEE
    hazard-stripe: color,
    plate-line: color,      // .btn.plate: outlined accent key
    plate-fg: color,

    // ---- sliders and bars ----
    slider-track: color,
    slider-fill: color,
    slider-knob: color,
    slider-knob-ring: color,
    slider-disabled-fill: color,
    slider-disabled-knob: color,
    level-bar: color,       // the volume level bar

    // ---- meters ----
    meter-face: color,
    meter-ink: color,
    meter-needle: color,
    meter-led-low: color,
    meter-led-mid: color,
    meter-led-high: color,
    meter-peak: color,

    // ---- spectrum ----
    trace-live: color,
    trace-peak: color,
    trace-average: color,
    // ---- the radios of the multi-radio screen: R1 blue, R2 amber, R3 green, R4 violet; radios 5 to 8 reuse them by position (the tag carries the number) ----
    radio-1: color,
    radio-2: color,
    radio-3: color,
    radio-4: color,
    radio-ink: color,       // the R-tag's number on the radio's colour: at least 4.5 to 1 against all four (measured in docs/multi-radio-records/screen-s3.md)
    vfo: color,
    vfo-fill: color,
    bandplan: color,
    bandplan-fg: color,
    mark: color,            // plugin marks
    mark-fill: color,       // a span mark's tint
    bookmark: color,        // bookmark names
    bookmark-tick: color,
    marker: color,          // user markers M<n>
    cursor: color,          // cursor readout line
    cursor-chip-bg: color,
    cursor-chip-line: color,
    graticule: color,
    axis-fg: color,

    // ---- waterfall ----
    wf-floor: color,
    wf-mid: color,
    wf-high: color,
    wf-hot: color,
    wf-peak: color,
    wf-vfo: color,
    wf-key-bg: color,       // the strength key plate

    // ---- type + shape ----
    font-ui: string,
    font-mono: string,
    radius: length,         // keys, fields, palette
    radius-panel: length,   // panels, cards, counter, rail keys, torn-off windows
    radius-seg: length,     // a segmented group
    radius-seg-key: length, // a key inside it
    radius-chip: length,    // pill
    radius-dome: length,    // the STOP key
    radius-menu-item: length,

    // ---- signature drawing switches ----
    digit-face: DigitFace,  // plain figures, a drum counter, or nixie tubes
    lamp-glow: bool,        // lit lamps cast a soft glow
    shadows: bool,          // drop shadows under knobs, menus, torn-off windows
    hairline: length,       // the divider thickness
}

// Row 16, Workbench: the neutral base every premium skin is drawn on.
export global Workbench {
    out property <Skin> value: {
        bg: #15171b, strip: #191c21, panel: #1d2026, panel-alt: #1a1d22, card: #20242b, well: #0d0f12, well-deep: #06070a,
        field: #0f1114, menu: #262a32, menu-hot: #363b45, table-selected: #2a2414,
        card-warn: #2a2312, card-warn-line: #6b4d16, card-err: #2a1717, card-err-line: #6b2a2a, backdrop: #08090b9e,
        line: #2b2f37, line-strong: #363b45, line-faint: #1e2229, knob-ring: #434955,
        fg: #e6e8ec, fg-soft: #c9ced6, muted: #9aa3ad, dim: #7d8694, faint: #5c6370, nudge: #6c7480, disabled: #8a93a0, focus: #7ad7ff,
        accent: #f5a524, accent-ink: #1b1400, accent-soft: #f5c66b, accent-hover: #ffc66a, digit: #ffb84d, digit-glow: #f5a52455, digit-dim: #5c5345,
        lamp-off: #2b2f37, lamp-ring: #434955, lamp-green: #3ddc84, lamp-green-cap: #cfead9, lamp-amber: #f5a524, lamp-amber-cap: #f3dcae,
        lamp-red: #ff5c5c, lamp-red-cap: #ffc9c9, lamp-yellow: #ffd27a, lamp-yellow-cap: #f3e2b8,
        chip-bg: #262a32, chip-fg: #c9ced6, chip-line: #363b45, chip-good-bg: #163626, chip-good-fg: #7fe6ad, chip-good-line: #1f5a3c,
        chip-warn-bg: #3a2a0e, chip-warn-fg: #f5c66b, chip-warn-line: #6b4d16, chip-err-bg: #3a1d1d, chip-err-fg: #ff9b9b, chip-err-line: #6b2a2a,
        key-bg: #262a32, key-line: #363b45, key-fg: #e6e8ec, key-disabled-bg: #1d2026, key-disabled-fg: #8a93a0,
        danger-bg: #3a1d1d, danger-line: #6b2a2a, danger-strong-line: #8a3434, danger-fg: #ffd4d4, danger-glyph: #ff8a8a,
        hazard-line: #6b4d16, hazard-stripe: #2e2a1c, plate-line: #f5a524, plate-fg: #f5c66b,
        slider-track: #2b2f37, slider-fill: #f5a524, slider-knob: #e6e8ec, slider-knob-ring: #1d2026, slider-disabled-fill: #5a606b, slider-disabled-knob: #8a93a0,
        level-bar: #3ddc84,
        meter-face: #0f1114, meter-ink: #c9ced6, meter-needle: #f5a524, meter-led-low: #3ddc84, meter-led-mid: #f5a524, meter-led-high: #ff5c5c, meter-peak: #ffd27a,
        trace-live: #7ad7ff, trace-peak: #ff9f43, trace-average: #f1ead6, radio-1: #4da3ff, radio-2: #f5a524, radio-3: #3ddc84, radio-4: #b48cff, radio-ink: #15171b, vfo: #f5a524, vfo-fill: #f5a52422, bandplan: #2a3b5a, bandplan-fg: #8fb3e0,
        mark: #d4b060, mark-fill: #d4b06022, bookmark: #f5c66b, bookmark-tick: #f5a524, marker: #e6e8ec, cursor: #e6e8ec66,
        cursor-chip-bg: #0d0f12dd, cursor-chip-line: #434955, graticule: #1e2229, axis-fg: #7d8694,
        wf-floor: #0a1430, wf-mid: #1b3a6a, wf-high: #2e86c1, wf-hot: #f5a524, wf-peak: #ffffff, wf-vfo: #ffd27a, wf-key-bg: #0d0f12dd,
        font-ui: "Inter", font-mono: "JetBrains Mono",   // not-translated: typeface names, not words
        radius: 6px, radius-panel: 8px, radius-seg: 7px, radius-seg-key: 5px, radius-chip: 10px, radius-dome: 10px, radius-menu-item: 5px,
        digit-face: DigitFace.plain, lamp-glow: true, shadows: true, hairline: 1px,
    };
}

// Night Watch, the second filling (docs 6.61): the classic window's red-black look (gui/theme.cpp makeNight), ported end to end as the proof that a skin
// carries the whole window with no component change. Every shade is red, so a night-adapted eye keeps its dark adaptation: no white, no green, no blue.
// The mapping from the classic's 49 roles: Bg -> bg, Frame -> strip, Panel -> panel, PanelHead -> panel-alt, Deck -> card, Well -> well, DigitBg -> field,
// MenuBg/MenuHi -> menu/menu-hot, Border -> line, CtrlBorder -> line-strong, MenuBorder -> knob-ring, Label/Text/Muted -> fg/fg-soft/muted, Accent -> accent,
// Digit/DigitDim -> digit/digit-dim, Ctrl/CtrlText -> key-bg/key-fg, StopBg -> danger-bg, Trace/Grid -> trace-live/graticule, WfLow..WfTop -> wf-*, Mono
// typeface, flat keys (small radius, no shadow), neon counter face. test_slint_theme holds the reading pairs to the classic test's 4.5:1.
export global NightWatch {
    out property <Skin> value: {
        bg: #070303, strip: #140606, panel: #100505, panel-alt: #170808, card: #1c0a09, well: #040101, well-deep: #020000,
        field: #0a0202, menu: #1c0a09, menu-hot: #3a1410, table-selected: #2a0f0a,
        card-warn: #2a0f0a, card-warn-line: #6b2a1c, card-err: #3a0e0b, card-err-line: #8a2014, backdrop: #020000b0,
        line: #3a1410, line-strong: #4a1a14, line-faint: #240d0a, knob-ring: #5a1a12,
        fg: #ff8a72, fg-soft: #e87766, muted: #cf5d4d, dim: #b04c3e, faint: #8a3a2e, nudge: #a04436, disabled: #9a4538, focus: #ffd2c6,
        accent: #ff6a4c, accent-ink: #1a0402, accent-soft: #ff8a70, accent-hover: #ff8a70, digit: #ff5a3c, digit-glow: #ff5a3c55, digit-dim: #3a100a,
        lamp-off: #3a1410, lamp-ring: #5a1a12, lamp-green: #ff7a62, lamp-green-cap: #ffd2c6, lamp-amber: #ff6a4c, lamp-amber-cap: #ffc2b4,
        lamp-red: #ffe1d8, lamp-red-cap: #fff0ea, lamp-yellow: #ff9a70, lamp-yellow-cap: #ffd2c6,
        chip-bg: #1f0b09, chip-fg: #f08a76, chip-line: #4a1a14, chip-good-bg: #2a0c09, chip-good-fg: #ff7a62, chip-good-line: #5a1a12,
        chip-warn-bg: #2e0f08, chip-warn-fg: #ff9a70, chip-warn-line: #6b2a1c, chip-err-bg: #3a0e0b, chip-err-fg: #ffe1d8, chip-err-line: #8a2014,
        key-bg: #1f0b09, key-line: #4a1a14, key-fg: #f08a76, key-disabled-bg: #140606, key-disabled-fg: #9a4538,
        danger-bg: #3a0806, danger-line: #8a2014, danger-strong-line: #b02a1a, danger-fg: #ffd2c6, danger-glyph: #ff8a70,
        hazard-line: #6b2a1c, hazard-stripe: #2a0c09, plate-line: #ff6a4c, plate-fg: #ff8a70,
        slider-track: #3a1410, slider-fill: #ff6a4c, slider-knob: #ff7a62, slider-knob-ring: #100505, slider-disabled-fill: #5a2a22, slider-disabled-knob: #8a4a3e,
        level-bar: #ff5a3c,
        meter-face: #140606, meter-ink: #e87766, meter-needle: #ff5a3c, meter-led-low: #a82a1c, meter-led-mid: #ff5a3c, meter-led-high: #ffe1d8, meter-peak: #ff9a70,
        trace-live: #ff6a4c, trace-peak: #ffb09c, trace-average: #ffd2c6, radio-1: #ff6a4c, radio-2: #ffd2c6, radio-3: #d9442b, radio-4: #ff9a80, radio-ink: #070303, vfo: #ff5a3c, vfo-fill: #ff5a3c22, bandplan: #3a1410, bandplan-fg: #e87766,
        mark: #cf5d4d, mark-fill: #cf5d4d22, bookmark: #ff8a70, bookmark-tick: #ff5a3c, marker: #ffd2c6, cursor: #ff8a7266,
        cursor-chip-bg: #040101dd, cursor-chip-line: #5a1a12, graticule: #2a0f0b, axis-fg: #b04c3e,
        wf-floor: #140303, wf-mid: #4a0c07, wf-high: #c0281a, wf-hot: #ff9a70, wf-peak: #ffe1d8, wf-vfo: #ff8a70, wf-key-bg: #040101dd,
        font-ui: "JetBrains Mono", font-mono: "JetBrains Mono",   // not-translated: typeface names, not words
        radius: 2px, radius-panel: 2px, radius-seg: 2px, radius-seg-key: 2px, radius-chip: 3px, radius-dome: 10px, radius-menu-item: 2px,
        digit-face: DigitFace.drum, lamp-glow: true, shadows: false, hairline: 1px,
    };
}

// HIGH CONTRAST (docs/multi-radio-records/slint-gaps.md item 11): the third filling, a palette and nothing else - black grounds, white lines and text, one yellow accent, 2 px lines, no glow, no
// shadow. Every reading pair is at least 7 : 1 (test_slint_hc_palette holds it). It is the window's own choice (SYSTEM > Display > High contrast) and it is forced on while Windows' own high-contrast
// setting is on. Metrics and components are the Workbench's: only the tokens differ.
export global HighContrast {
    out property <Skin> value: {
        bg: #000000, strip: #000000, panel: #000000, panel-alt: #0a0a0a, card: #0a0a0a, well: #000000, well-deep: #000000, field: #000000, menu: #000000, menu-hot: #262600,
        table-selected: #2a2a00, card-warn: #1a1400, card-warn-line: #ffd800, card-err: #1a0000, card-err-line: #ff7070, backdrop: #000000d8, line: #ffffff, line-strong: #ffffff,
        line-faint: #6a6a6a, knob-ring: #ffffff, fg: #ffffff, fg-soft: #ffffff, muted: #ececec, dim: #d8d8d8, faint: #c0c0c0, nudge: #ffffff, disabled: #9a9a9a, focus: #00ffff,
        accent: #ffd800, accent-ink: #000000, accent-soft: #ffe566, accent-hover: #fff07a, digit: #ffff00, digit-glow: #ffff0000, digit-dim: #8a8a00, lamp-off: #404040, lamp-ring: #ffffff,
        lamp-green: #00ff66, lamp-green-cap: #ffffff, lamp-amber: #ffd800, lamp-amber-cap: #ffffff, lamp-red: #ff4040, lamp-red-cap: #ffffff, lamp-yellow: #ffff00, lamp-yellow-cap: #ffffff,
        chip-bg: #000000, chip-fg: #ffffff, chip-line: #ffffff, chip-good-bg: #001a0a, chip-good-fg: #00ff66, chip-good-line: #00ff66, chip-warn-bg: #1a1400, chip-warn-fg: #ffd800,
        chip-warn-line: #ffd800, chip-err-bg: #1a0000, chip-err-fg: #ff9090, chip-err-line: #ff9090, key-bg: #000000, key-line: #ffffff, key-fg: #ffffff, key-disabled-bg: #000000,
        key-disabled-fg: #9a9a9a, danger-bg: #1a0000, danger-line: #ff7070, danger-strong-line: #ff7070, danger-fg: #ffffff, danger-glyph: #ff9090, hazard-line: #ffd800,
        hazard-stripe: #2a2400, plate-line: #ffd800, plate-fg: #ffd800, slider-track: #6a6a6a, slider-fill: #ffd800, slider-knob: #ffffff, slider-knob-ring: #000000,
        slider-disabled-fill: #6a6a6a, slider-disabled-knob: #9a9a9a, level-bar: #00ff66, meter-face: #000000, meter-ink: #ffffff, meter-needle: #ffd800, meter-led-low: #00ff66,
        meter-led-mid: #ffd800, meter-led-high: #ff4040, meter-peak: #ffffff, trace-live: #00ffff, trace-peak: #ffd800, trace-average: #ffffff, radio-1: #00ffff, radio-2: #ffd800,
        radio-3: #00ff66, radio-4: #ff80ff, radio-ink: #000000, vfo: #ffd800, vfo-fill: #ffd80033, bandplan: #3a3a3a, bandplan-fg: #ffffff, mark: #ffe566, mark-fill: #ffe56633,
        bookmark: #ffd800, bookmark-tick: #ffd800, marker: #ffffff, cursor: #ffffffaa, cursor-chip-bg: #000000ee, cursor-chip-line: #ffffff, graticule: #5a5a5a, axis-fg: #d8d8d8,
        wf-floor: #000000, wf-mid: #1a2a6a, wf-high: #00a0ff, wf-hot: #ffd800, wf-peak: #ffffff, wf-vfo: #ffff00, wf-key-bg: #000000ee, 
        font-ui: "Inter", font-mono: "JetBrains Mono",   // not-translated: typeface names
       
        radius: 6px, radius-panel: 8px, radius-seg: 7px, radius-seg-key: 5px, radius-chip: 10px, radius-dome: 10px, radius-menu-item: 5px,
        digit-face: DigitFace.plain, lamp-glow: false, shadows: false, hairline: 2px,
    };
}

export global Theme {
    // THE FILLING IN FORCE. Components never read this directly: they read the tokens below.
    in-out property <Skin> skin: Workbench.value;

    // ---- tokens: one per Skin field, same name ----
    out property <color> bg: skin.bg;
    out property <color> strip: skin.strip;
    out property <color> panel: skin.panel;
    out property <color> panel-alt: skin.panel-alt;
    out property <color> card: skin.card;
    out property <color> well: skin.well;
    out property <color> well-deep: skin.well-deep;
    out property <color> field: skin.field;
    out property <color> menu: skin.menu;
    out property <color> menu-hot: skin.menu-hot;
    out property <color> table-selected: skin.table-selected;
    out property <color> card-warn: skin.card-warn;
    out property <color> card-warn-line: skin.card-warn-line;
    out property <color> card-err: skin.card-err;
    out property <color> card-err-line: skin.card-err-line;
    out property <color> backdrop: skin.backdrop;
    out property <color> line: skin.line;
    out property <color> line-strong: skin.line-strong;
    out property <color> line-faint: skin.line-faint;
    out property <color> knob-ring: skin.knob-ring;
    out property <color> fg: skin.fg;
    out property <color> fg-soft: skin.fg-soft;
    out property <color> muted: skin.muted;
    out property <color> dim: skin.dim;
    out property <color> faint: skin.faint;
    out property <color> nudge: skin.nudge;
    out property <color> disabled: skin.disabled;
    out property <color> focus: skin.focus;
    out property <color> accent: skin.accent;
    out property <color> accent-ink: skin.accent-ink;
    out property <color> accent-soft: skin.accent-soft;
    out property <color> accent-hover: skin.accent-hover;
    out property <color> digit: skin.digit;
    out property <color> digit-glow: skin.digit-glow;
    out property <color> digit-dim: skin.digit-dim;
    out property <color> lamp-off: skin.lamp-off;
    out property <color> lamp-ring: skin.lamp-ring;
    out property <color> lamp-green: skin.lamp-green;
    out property <color> lamp-green-cap: skin.lamp-green-cap;
    out property <color> lamp-amber: skin.lamp-amber;
    out property <color> lamp-amber-cap: skin.lamp-amber-cap;
    out property <color> lamp-red: skin.lamp-red;
    out property <color> lamp-red-cap: skin.lamp-red-cap;
    out property <color> lamp-yellow: skin.lamp-yellow;
    out property <color> lamp-yellow-cap: skin.lamp-yellow-cap;
    out property <color> chip-bg: skin.chip-bg;
    out property <color> chip-fg: skin.chip-fg;
    out property <color> chip-line: skin.chip-line;
    out property <color> chip-good-bg: skin.chip-good-bg;
    out property <color> chip-good-fg: skin.chip-good-fg;
    out property <color> chip-good-line: skin.chip-good-line;
    out property <color> chip-warn-bg: skin.chip-warn-bg;
    out property <color> chip-warn-fg: skin.chip-warn-fg;
    out property <color> chip-warn-line: skin.chip-warn-line;
    out property <color> chip-err-bg: skin.chip-err-bg;
    out property <color> chip-err-fg: skin.chip-err-fg;
    out property <color> chip-err-line: skin.chip-err-line;
    out property <color> key-bg: skin.key-bg;
    out property <color> key-line: skin.key-line;
    out property <color> key-fg: skin.key-fg;
    out property <color> key-disabled-bg: skin.key-disabled-bg;
    out property <color> key-disabled-fg: skin.key-disabled-fg;
    out property <color> danger-bg: skin.danger-bg;
    out property <color> danger-line: skin.danger-line;
    out property <color> danger-strong-line: skin.danger-strong-line;
    out property <color> danger-fg: skin.danger-fg;
    out property <color> danger-glyph: skin.danger-glyph;
    out property <color> hazard-line: skin.hazard-line;
    out property <color> hazard-stripe: skin.hazard-stripe;
    out property <color> plate-line: skin.plate-line;
    out property <color> plate-fg: skin.plate-fg;
    out property <color> slider-track: skin.slider-track;
    out property <color> slider-fill: skin.slider-fill;
    out property <color> slider-knob: skin.slider-knob;
    out property <color> slider-knob-ring: skin.slider-knob-ring;
    out property <color> slider-disabled-fill: skin.slider-disabled-fill;
    out property <color> slider-disabled-knob: skin.slider-disabled-knob;
    out property <color> level-bar: skin.level-bar;
    out property <color> meter-face: skin.meter-face;
    out property <color> meter-ink: skin.meter-ink;
    out property <color> meter-needle: skin.meter-needle;
    out property <color> meter-led-low: skin.meter-led-low;
    out property <color> meter-led-mid: skin.meter-led-mid;
    out property <color> meter-led-high: skin.meter-led-high;
    out property <color> meter-peak: skin.meter-peak;
    out property <color> trace-live: skin.trace-live;
    out property <color> trace-peak: skin.trace-peak;
    out property <color> trace-average: skin.trace-average;
    out property <color> radio-1: skin.radio-1;
    out property <color> radio-2: skin.radio-2;
    out property <color> radio-3: skin.radio-3;
    out property <color> radio-4: skin.radio-4;
    out property <color> radio-ink: skin.radio-ink;
    // The colour of radio number n (1-based; 0 and below read as the first): the four colours by position, so radios 5 to 8 repeat them and the tag's number tells them apart.
    public pure function radio-colour(n: int) -> color {
        return Math.mod(Math.max(n, 1) - 1, 4) == 0 ? root.radio-1 : Math.mod(Math.max(n, 1) - 1, 4) == 1 ? root.radio-2 : Math.mod(Math.max(n, 1) - 1, 4) == 2 ? root.radio-3 : root.radio-4;
    }
    out property <color> vfo: skin.vfo;
    out property <color> vfo-fill: skin.vfo-fill;
    out property <color> bandplan: skin.bandplan;
    out property <color> bandplan-fg: skin.bandplan-fg;
    out property <color> mark: skin.mark;
    out property <color> mark-fill: skin.mark-fill;
    out property <color> bookmark: skin.bookmark;
    out property <color> bookmark-tick: skin.bookmark-tick;
    out property <color> marker: skin.marker;
    out property <color> cursor: skin.cursor;
    out property <color> cursor-chip-bg: skin.cursor-chip-bg;
    out property <color> cursor-chip-line: skin.cursor-chip-line;
    out property <color> graticule: skin.graticule;
    out property <color> axis-fg: skin.axis-fg;
    out property <color> wf-floor: skin.wf-floor;
    out property <color> wf-mid: skin.wf-mid;
    out property <color> wf-high: skin.wf-high;
    out property <color> wf-hot: skin.wf-hot;
    out property <color> wf-peak: skin.wf-peak;
    out property <color> wf-vfo: skin.wf-vfo;
    out property <color> wf-key-bg: skin.wf-key-bg;
    // THE CJK FACE (docs 6.62). A language written in Han, kana or Hangul has no glyph in Inter or JetBrains Mono, and Slint takes ONE family per Text (a list is not parsed, a registered
    // face is not a glyph fallback), so the host names the system face that draws the language here and every typeface of the window becomes it; "" is every other language. The big
    // tuner digits keep the bench's mono face (font-digits): no translated word is ever drawn in them.
    in property <string> cjk-family: "";
    out property <string> font-ui: root.cjk-family != "" ? root.cjk-family : skin.font-ui;
    out property <string> font-mono: root.cjk-family != "" ? root.cjk-family : skin.font-mono;
    out property <string> font-digits: skin.font-mono;
    out property <length> radius: skin.radius;
    out property <length> radius-panel: skin.radius-panel;
    out property <length> radius-seg: skin.radius-seg;
    out property <length> radius-seg-key: skin.radius-seg-key;
    out property <length> radius-chip: skin.radius-chip;
    out property <length> radius-dome: skin.radius-dome;
    out property <length> radius-menu-item: skin.radius-menu-item;
    out property <DigitFace> digit-face: skin.digit-face;
    out property <bool> lamp-glow: skin.lamp-glow;
    out property <bool> shadows: skin.shadows;
    out property <length> hairline: skin.hairline;

    // ---- metrics: the Workbench arrangement's measurements (the artboards' CSS), fixed in phase 1 ----
    out property <length> title-h: 36px;        // custom title bar, every platform
    out property <length> strip-h: 104px;       // receiver strip
    out property <length> rail-w: 64px;         // icon rail
    out property <length> rail-key: 56px;       // a rail key is square
    out property <length> panel-w: 296px;       // sections panel
    out property <length> status-h: 28px;       // status bar and a status chip
    out property <length> tab-h: 32px;          // tab row
    out property <length> splitter-h: 6px;
    out property <length> waterfall-h: 270px;
    out property <length> key-h: 30px;          // .btn
    out property <length> key-sm-h: 24px;       // .btn.sm
    out property <length> key-xs-h: 20px;       // .btn.xs
    out property <length> key-min-w: 64px;
    out property <length> key-pad: 14px;
    out property <length> seg-h: 26px;          // .seg .btn
    out property <length> seg-sm-h: 22px;
    out property <length> seg-key-min-w: 52px;
    out property <length> chip-h: 20px;
    out property <length> lamp-dot: 9px;
    out property <length> lamp-dot-sm: 8px;     // .ld
    out property <length> digit-w: 34px;
    out property <length> digit-h: 52px;
    out property <length> nudge-h: 10px;
    out property <length> slider-track-h: 6px;
    out property <length> slider-knob-d: 16px;  // knob diameter (slider-knob is its colour)
    out property <length> level-bar-h: 4px;
    out property <length> section-h: 36px;      // .sec
    out property <length> section-sm-h: 30px;   // .sec.s
    out property <length> section-dense-h: 25px;// .dn .sec.s
    out property <length> field-h: 24px;        // .in
    out property <length> menu-item-h: 26px;    // .mi
    out property <length> win-title-h: 30px;    // .wt, a torn-off window's title strip
    out property <length> table-row-h: 24px;    // 11px text + 4px padding each side + the 1px rule
    out property <length> font-body: 12px;
    out property <length> font-small: 11px;
    out property <length> font-cap: 10px;
    out property <length> font-hint: 10px;
    out property <length> font-tiny: 9px;
    out property <length> font-micro: 8px;
    out property <length> font-readout: 16px;   // the peak figure
    out property <length> font-digit: 30px;     // the counter numerals
    out property <length> font-counter-dot: 22px;
    out property <length> cap-spacing: 0.8px;   // .cap letter-spacing .08em at 10px
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
}

// SCREEN LANE K (docs/multi-radio-records/screen-k.md): what a screen reader is told about the pictures. The host (lanek_publish.cpp) writes one sentence per picture, a few times a
// second at most and only when it changed enough to speak; the views put it in accessible-description. `pane-*` are the multi-radio panes by radio (index 0 = radio 1).
export global SrText {
    in property <string> spectrum;
    in property <string> waterfall;
    in property <string> counter;
    in property <[string]> pane-spectrum;
    in property <[string]> pane-waterfall;
}
