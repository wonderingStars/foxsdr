        meter-needle: #B91C1C, meter-led-low: #15803D, meter-led-mid: #B45309, meter-led-high: #B91C1C,
        meter-peak: #1E3A8A, trace-live: #1D4ED8, trace-peak: #B45309, trace-average: #1F2A37,
        radio-1: #1d4ed8, radio-2: #b45309, radio-3: #15803d, radio-4: #7e22ce,
        radio-ink: #ffffff, vfo: #b91c1c, vfo-fill: #b91c1c22, bandplan: #bbcaf3,
        bandplan-fg: #1f3157, mark: #4b61a1, mark-fill: #4b61a122, bookmark: #1E3A8A,
        bookmark-tick: #1D4ED8, marker: #1F2A37, cursor: #1F2A3766, cursor-chip-bg: #FFFFFFdd,
        cursor-chip-line: #C3CAD3, graticule: #dbdfe5, axis-fg: #5d6673, wf-floor: #F4F7FB,
        wf-mid: #BCD4F6, wf-high: #3B6FD8, wf-hot: #0B1F5C, wf-peak: #0b1f5c,
        wf-vfo: #B45309, wf-key-bg: #FFFFFFdd,
        font-ui: "Inter", font-mono: "JetBrains Mono",   // not-translated: typeface names, not words
        radius: 6px, radius-panel: 8px, radius-seg: 7px, radius-seg-key: 5px, radius-chip: 10px, radius-dome: 10px, radius-menu-item: 5px,
        digit-face: DigitFace.plain, lamp-glow: false, shadows: true, hairline: 1px,
    };
}

// Field Radio (the classic window's preset of that name, gui/theme.cpp makeField): its 49 roles mapped onto the skin's tokens the way Night Watch's are (see above); the tokens the classic has no role for
// (chip, lamp and card tints, the disabled and faint inks) are mixes of the roles, so a contrast pair is held by test_slint_themes_four.
export global FieldRadio {
    out property <Skin> value: {
        bg: #23271A, strip: #3A4128, panel: #343B24, panel-alt: #2C321E,
        card: #3f4629, well: #0F140B, well-deep: #0F140B, field: #0F140B,
        menu: #3f4629, menu-hot: #525c38, table-selected: #51532e, card-warn: #504d28,
        card-warn-line: #937833, card-err: #4c4028, card-err-line: #934f33, backdrop: #08090b9e,
        line: #5D6641, line-strong: #2C321E, line-faint: #485032, knob-ring: #2C321E,
        fg: #E3DFC9, fg-soft: #d6d3ba, muted: #B8B797, dim: #9e9e80,
        faint: #838569, nudge: #97987a, disabled: #a4a486, focus: #D6BF5E,
        accent: #D6BF5E, accent-ink: #000000, accent-soft: #D6BF5E, accent-hover: #decc7e,
