        meter-peak: #FFB547, trace-live: #35E0A1, trace-peak: #FFB547, trace-average: #DDE9F1,
        radio-1: #4da3ff, radio-2: #f5a524, radio-3: #3ddc84, radio-4: #b48cff,
        radio-ink: #070B0F, vfo: #FFB547, vfo-fill: #FFB54722, bandplan: #2f5861,
        bandplan-fg: #c5ecf4, mark: #cf953f, mark-fill: #cf953f22, bookmark: #FFB547,
        bookmark-tick: #7DF3FF, marker: #DDE9F1, cursor: #DDE9F166, cursor-chip-bg: #05090Cdd,
        cursor-chip-line: #28404F, graticule: #16222b, axis-fg: #728a9b, wf-floor: #0A1433,
        wf-mid: #1D4F85, wf-high: #25B39A, wf-hot: #F2E35C, wf-peak: #ffffff,
        wf-vfo: #FFB547, wf-key-bg: #05090Cdd,
        font-ui: "Inter", font-mono: "JetBrains Mono",   // not-translated: typeface names, not words
        radius: 8px, radius-panel: 8px, radius-seg: 8px, radius-seg-key: 6px, radius-chip: 10px, radius-dome: 10px, radius-menu-item: 6px,
        digit-face: DigitFace.plain, lamp-glow: true, shadows: true, hairline: 1px,
