// The theme's own specimen: a ground, an accent key shape and a line of text, enough to prove that the tokens
// reach the pixels, that text renders headlessly, and that a second filling installed through `Theme.skin`
// changes the picture with no component change (test_slint_theme.cpp).
import { Theme, Skin, Workbench, NightWatch, DigitFace } from "../theme.slint";
import { TipLayer } from "../tooltip.slint";
export { Theme, Skin, Workbench, NightWatch, DigitFace }

export component ThemeSpecimen inherits Window {
    width: 240px;
    height: 120px;
    background: Theme.bg;
    Rectangle { x: 10px; y: 10px; width: 80px; height: 30px; background: Theme.accent; border-radius: Theme.radius; }
    Rectangle { x: 110px; y: 10px; width: 80px; height: 30px; background: Theme.panel; border-width: 1px; border-color: Theme.line-strong; }
    Text { x: 10px; y: 60px; width: 220px; height: 40px; text: "FoxSDR 0.99.100"; color: Theme.fg; font-family: Theme.font-ui; font-size: 16px; vertical-alignment: center; }
    Rectangle { x: 200px; y: 100px; width: 20px; height: Theme.hairline; background: Theme.line; }
    TipLayer { x: 0px; y: 0px; win-w: root.width; win-h: root.height; }
}
