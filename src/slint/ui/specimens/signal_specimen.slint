// The SIGNAL bank specimen sheet (1240 x 2400): every body of ui/signal_bank.slint inside the REAL Section it is shown under (296 wide: the body is
// 254 px, the Section's own padding 30 / 12), on the sample models below, so tests/test_slint_signal.cpp can probe the pixels against the Banks
// artboard (artboards/Workbench-Banks.dc.html: the SIGNAL column A1 and the Source-variants strip A6) and press the controls with real pointer events.
// Four columns of stacked Sections (each Section's y is the one above's y + height + 10, so the stack holds whatever height the typefaces settle on);
// the two companion sheets sit under them, each over a 620-wide stage of its own.
//
//   column x      Section (296 wide, small = 30 px row)                               model            what it shows
//   A  10   s1    Source / RTL-SDR     variant 0, y 10   rate, antenna, auto gain + bias tee, one TUNER stage, the ppm block, then a mismatch
//                                       note (amber) and the source error (red)                         m-rtl
//   A       fc1   Frequency correction  FrequencyCorrectionBody, default-forwarding to SignalEvents      m-rtl
//   B  316  b1    Source / SOUND CARD   variant 4, I/Q pair: Device + Format, Swap I/Q, Centre (MHz), Sample rate + Open, Receives     m-card-iq
//          b2     Source / SOUND CARD   variant 4, real audio: the busy line, "No inputs found", Channel, the converter (Off), the missing-card note   m-card-real
//          b3     Source / AIRSPY       variant 5, Sensitive: Rate (single port), Bias tee, the Airspy card with its Gain slider      m-airspy
//          b4     Source / AIRSPY       variant 5, Free: LNA AGC / Mixer AGC, LNA / MIXER / VGA sliders                               m-airspy-free
//   C  622  c1    Source / RTL-SDR      variant 7: the converter card with an Up converter, LO 125 MHz, quick keys, Inverts, parse error, on-air line   m-conv
//          c2     Audio filters / 3 ON  NR on 0.45, notch on 1000 Hz Q 30, auto notch locked on 1.2 kHz                              m-filters
//          c3     Audio filters / OFF   everything off: the sliders greyed, the auto notch has no status                              m-filters-off
//          c4     Sinks / OPEN          device, audio-health note, buffer, lead notice, "Muted by", the untouched-volume note        m-sinks
//          c5     Sinks / NO DEV        the "No audio output devices" line instead of the dropdown                                   m-sinks-none
//   D  928  d1    Recorder / OFF        idle: the folder, Record IQ and Record audio side by side                                    m-rec-idle
//          d2     Recorder / REC        IQ running (Stop IQ + progress), the muted warning, hint, error, notice, an import key      m-rec-run
//          d3     Radio / WFM           RadioExtras: Stereo ticked + the STEREO chip, the RDS block                                   m-extras
//          d4     Radio / WFM           RadioExtras: Stereo unticked, MONO (amber), no RDS                                            m-extras-mono
//          d5     Transmit / FAULT      TransmitRowState with a fault line (red)                                                      m-tx
//          d6     Source / I/Q FILE     variant 1: path + Open, the slow-disk line                                                    m-iq
//          d7     Source / PLUTO        variant 2                                                                                     m-pluto
//          d8     Source / RTL_TCP      variant 3                                                                                     m-tcp
//          d9     Source / RTL-SDR      variant 6: the radio extras (FM notch, DAB notch, HDR mode, ADC dither, ADC randomiser)       m-options
//          d10    Source                the Device-stopped card (red) and the Advisories card (amber), nothing else                   m-stopped
//   sheets: setup-stage (10, setup-y, 620 x 420) holds RadioSetupSheet, import-stage (640, setup-y, 560 x 360) holds ImportDialog
//   probes: p1..p5 (254-wide layout cells, below the window at y 2500 / 2540) hold bare bodies and report the cell's width (rule 11)
//
// What the test reads: `Rec` counts and names every callback of the bodies with an override (SpecSource and the others), the sections' y and heights
// are out properties, and the plain (default-forwarding) bodies are watched through the SignalEvents global.
import { Theme, Skin, Workbench } from "../theme.slint";
import { ChipTone, LampState } from "../chips.slint";
import { Section } from "../sections.slint";
import { TipLayer } from "../tooltip.slint";
import { SelectItem, GainStage, OptionRow, SourceModel, RadioExtrasModel, AudioFiltersModel, SinksModel, TransmitModel, RecorderModel, UnboundRow, SetupKey, RadioSetupModel, ImportDialogModel, SignalEvents, SourceBody, FrequencyCorrectionBody, RadioExtras, AudioFiltersBody, SinksBody, TransmitRowState, RecorderBody, RadioSetupSheet, ImportDialog } from "../signal_bank.slint";
export { Theme, Skin, Workbench, ChipTone, LampState, SelectItem, GainStage, OptionRow, SourceModel, RadioExtrasModel, AudioFiltersModel, SinksModel, TransmitModel, RecorderModel, UnboundRow, SetupKey, RadioSetupModel, ImportDialogModel, SignalEvents }

// What the bodies with an override report: the callback's name and its arguments, joined with a space.
export global Rec {
    in-out property <int> events;
    in-out property <string> last;
    in-out property <string> last-args;
    callback fired(string, string);
    public function rec(name: string, args: string) {
        Rec.events += 1;
        Rec.last = name;
        Rec.last-args = args;
        Rec.fired(name, args);
    }
}

component SpecSource inherits SourceBody {
    source-device-selected(a) => { Rec.rec("source-device-selected", "" + a); }
    source-refresh() => { Rec.rec("source-refresh", ""); }
    source-usrps(a) => { Rec.rec("source-usrps", a ? "1" : "0"); }
    source-setup() => { Rec.rec("source-setup", ""); }
    source-rate-selected(a) => { Rec.rec("source-rate-selected", "" + a); }
    source-antenna-selected(a) => { Rec.rec("source-antenna-selected", "" + a); }
    source-auto-gain(a) => { Rec.rec("source-auto-gain", a ? "1" : "0"); }
    source-gain-changed(a, b) => { Rec.rec("source-gain-changed", "" + a + " " + b); }
    source-bias(a) => { Rec.rec("source-bias", a ? "1" : "0"); }
    ppm-toggled(a) => { Rec.rec("ppm-toggled", a ? "1" : "0"); }
    ppm-committed(a) => { Rec.rec("ppm-committed", a); }
    iq-path-committed(a) => { Rec.rec("iq-path-committed", a); }
    iq-open() => { Rec.rec("iq-open", ""); }
    pluto-address-committed(a) => { Rec.rec("pluto-address-committed", a); }
    pluto-open() => { Rec.rec("pluto-open", ""); }
    rtltcp-address-committed(a) => { Rec.rec("rtltcp-address-committed", a); }
    rtltcp-open() => { Rec.rec("rtltcp-open", ""); }
    card-selected(a) => { Rec.rec("card-selected", "" + a); }
    card-format(a) => { Rec.rec("card-format", "" + a); }
    card-channel(a) => { Rec.rec("card-channel", "" + a); }
    card-swap(a) => { Rec.rec("card-swap", a ? "1" : "0"); }
    card-centre-committed(a) => { Rec.rec("card-centre-committed", a); }
    card-rate-selected(a) => { Rec.rec("card-rate-selected", "" + a); }
    card-open() => { Rec.rec("card-open", ""); }
    airspy-decimation(a) => { Rec.rec("airspy-decimation", "" + a); }
    airspy-gain-mode(a) => { Rec.rec("airspy-gain-mode", "" + a); }
    airspy-gain(a) => { Rec.rec("airspy-gain", "" + a); }
    airspy-lna-agc(a) => { Rec.rec("airspy-lna-agc", a ? "1" : "0"); }
    airspy-mixer-agc(a) => { Rec.rec("airspy-mixer-agc", a ? "1" : "0"); }
    airspy-lna(a) => { Rec.rec("airspy-lna", "" + a); }
    airspy-mixer(a) => { Rec.rec("airspy-mixer", "" + a); }
    airspy-vga(a) => { Rec.rec("airspy-vga", "" + a); }
    option-toggled(a, b) => { Rec.rec("option-toggled", "" + a + " " + (b ? "1" : "0")); }
    converter-mode(a) => { Rec.rec("converter-mode", "" + a); }
    converter-lo-committed(a) => { Rec.rec("converter-lo-committed", a); }
    converter-quick(a) => { Rec.rec("converter-quick", "" + a); }
    converter-inverts(a) => { Rec.rec("converter-inverts", a ? "1" : "0"); }
}

component SpecFilters inherits AudioFiltersBody {
    filter-nr(a) => { Rec.rec("filter-nr", a ? "1" : "0"); }
    filter-nr-strength(a) => { Rec.rec("filter-nr-strength", "" + a); }
    filter-notch(a) => { Rec.rec("filter-notch", a ? "1" : "0"); }
