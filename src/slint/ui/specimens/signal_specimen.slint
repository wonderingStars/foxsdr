        variant: 6, ppm-on: false,
        options: [
            { name: "fm-notch", label: "FM notch", on: true, enabled: true, tooltip: "The RSP's own broadcast-FM notch filter." },
            { name: "dab-notch", label: "DAB notch", on: false, enabled: true, tooltip: "The RSP's own DAB band III notch filter." },
            { name: "hdr", label: "HDR mode", on: false, enabled: true, tooltip: "An RSPdx's high-dynamic-range path below 2 MHz." },
            { name: "dither", label: "ADC dither", on: false, enabled: false, tooltip: "" },
            { name: "rand", label: "ADC randomiser", on: true, enabled: true, tooltip: "" },
        ],
    };
    in-out property <SourceModel> m-stopped: {
        device-label: "RTL-SDR Blog V4", devices: [{ label: "RTL-SDR Blog V4", id: "rtl", enabled: true, note: "" }], device-index: 0, refresh-enabled: true, setup-key-label: "RADIO SETUP",
        variant: 0, ppm-on: false,
        stopped-line: "Device stopped: the radio stopped answering - it was unplugged or reset", stopped-advice: "Reconnect it and pick the source again, or switch to the signal generator.",
        advisory: "Zadig / WinUSB: install the WinUSB driver for this radio", advisory-tone: ChipTone.warn,
    };
    in-out property <RadioSetupModel> m-setup: {
        shown: true, title: "RADIO SETUP", busy: "Checking this computer...",
        lines: ["FoxSDR found no radio it can use. This is what this computer shows, and what to do about it:", "Nothing is plugged in that FoxSDR could open."],
        unbound: [
            { name: "RTL-SDR Blog V4 is plugged in but is not bound to WinUSB", family: "RTL-SDR", vid: "0BDA", pid: "2838",
              advice: "Nothing can open it until Windows has the WinUSB driver bound to it. One Windows permission prompt, no Zadig." },
            { name: "Airspy R2 needs the Airspy driver", family: "Airspy", vid: "1D50", pid: "60A1", advice: "Install the vendor's driver, then press CHECK AGAIN." },
        ],
        keys: [
            { id: "install-driver", label: "INSTALL DRIVER", enabled: true, tooltip: "Install the WinUSB driver for this radio" },
            { id: "check-again", label: "CHECK AGAIN", enabled: true, tooltip: "" },
            { id: "link", label: "zadig.akeo.ie", enabled: true, tooltip: "https://zadig.akeo.ie" },
        ],
        dont-show: false,
    };
    in-out property <ImportDialogModel> m-import: {
        shown: true, path: "", error: "No frequencies were found in that file.",
        kinds: [{ label: "Bookmarks", id: "bm", enabled: true, note: "" }, { label: "Airband preset", id: "ab", enabled: true, note: "" }], kind-index: 0,
    };

    // ============================ column A (x 10) ============================
    s1 := Section { x: 10px; y: 10px; width: 296px; small: true; open: true; name: "Source"; chip: "RTL-SDR"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecSource { model: root.m-rtl; } }
    fc1 := Section { x: 10px; y: s1.y + s1.height + 10px; width: 296px; small: true; open: true; name: "Frequency correction"; chip: "0.0 PPM";
        FrequencyCorrectionBody { model: root.m-rtl; } }

    // ============================ column B (x 316) ============================
    b1 := Section { x: 316px; y: 10px; width: 296px; small: true; open: true; name: "Source"; chip: "SOUND CARD";
        SpecSource { model: root.m-card-iq; ppm-block: false; } }
    b2 := Section { x: 316px; y: b1.y + b1.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "SOUND CARD";
        SpecSource { model: root.m-card-real; ppm-block: false; } }
    b3 := Section { x: 316px; y: b2.y + b2.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "AIRSPY R2";
        SpecSource { model: root.m-airspy; } }
    b4 := Section { x: 316px; y: b3.y + b3.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "AIRSPY R2";
        SpecSource { model: root.m-airspy-free; } }

    // ============================ column C (x 622) ============================
    c1 := Section { x: 622px; y: 10px; width: 296px; small: true; open: true; name: "Source"; chip: "RTL-SDR";
        SpecSource { model: root.m-conv; } }
    c2 := Section { x: 622px; y: c1.y + c1.height + 10px; width: 296px; small: true; open: true; name: "Audio filters"; chip: "3 ON"; tone: ChipTone.good;
        SpecFilters { model: root.m-filters; } }
    c3 := Section { x: 622px; y: c2.y + c2.height + 10px; width: 296px; small: true; open: true; name: "Audio filters"; chip: "OFF";
        SpecFilters { model: root.m-filters-off; } }
    c4 := Section { x: 622px; y: c3.y + c3.height + 10px; width: 296px; small: true; open: true; name: "Sinks"; chip: "OPEN"; tone: ChipTone.good;
        SinksBody { model: root.m-sinks; } }
    c5 := Section { x: 622px; y: c4.y + c4.height + 10px; width: 296px; small: true; open: true; name: "Sinks"; chip: "NO DEV"; tone: ChipTone.warn;
        SinksBody { model: root.m-sinks-none; } }

    // ============================ column D (x 928) ============================
    d1 := Section { x: 928px; y: 10px; width: 296px; small: true; open: true; name: "Recorder"; chip: "OFF";
        SpecRecorder { model: root.m-rec-idle; } }
    d2 := Section { x: 928px; y: d1.y + d1.height + 10px; width: 296px; small: true; open: true; name: "Recorder"; chip: "REC"; tone: ChipTone.err;
        SpecRecorder { model: root.m-rec-run; } }
    d3 := Section { x: 928px; y: d2.y + d2.height + 10px; width: 296px; small: true; open: true; name: "Radio"; chip: "WFM";
        RadioExtras { model: root.m-extras; } }
    d4 := Section { x: 928px; y: d3.y + d3.height + 10px; width: 296px; small: true; open: true; name: "Radio"; chip: "WFM";
        RadioExtras { model: root.m-extras-mono; } }
    d5 := Section { x: 928px; y: d4.y + d4.height + 10px; width: 296px; small: true; open: true; name: "Transmit"; chip: "FAULT"; tone: ChipTone.err;
        TransmitRowState { model: root.m-tx; } }
    d6 := Section { x: 928px; y: d5.y + d5.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "I/Q FILE";
        SpecSource { model: root.m-iq; ppm-block: false; } }
    d7 := Section { x: 928px; y: d6.y + d6.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "PLUTO";
        SpecSource { model: root.m-pluto; ppm-block: false; } }
    d8 := Section { x: 928px; y: d7.y + d7.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "RTL_TCP";
        SpecSource { model: root.m-tcp; ppm-block: false; } }
    d9 := Section { x: 928px; y: d8.y + d8.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "RSPDX";
        SpecSource { model: root.m-options; } }
    d10 := Section { x: 928px; y: d9.y + d9.height + 10px; width: 296px; small: true; open: true; name: "Source"; chip: "STOPPED"; tone: ChipTone.err;
        SpecSource { model: root.m-stopped; } }

    // ============================ the companion sheets ============================
    setup-stage := Rectangle { x: 10px; y: root.setup-y; width: 620px; height: 420px; background: Theme.bg; clip: true;
        SpecSetup { x: 0px; y: 0px; width: parent.width; height: parent.height; model: root.m-setup; } }
    import-stage := Rectangle { x: 640px; y: root.setup-y; width: 560px; height: 340px; background: Theme.bg; clip: true;
        SpecImport { x: 0px; y: 0px; width: parent.width; height: parent.height; model: root.m-import; } }

    // ============================ rule 11: bare bodies in a 254-wide cell ============================
    // (the cell's width, if a body asks for more than 254 px, would be wider)
    HorizontalLayout { x: 10px; y: 2500px; width: 254px; height: 20px; p1 := Rectangle { SourceBody { model: root.m-rtl; } } }
    HorizontalLayout { x: 280px; y: 2500px; width: 254px; height: 20px; p2 := Rectangle { SourceBody { model: root.m-card-iq; } } }
    HorizontalLayout { x: 550px; y: 2500px; width: 254px; height: 20px; p3 := Rectangle { SourceBody { model: root.m-conv; } } }
    HorizontalLayout { x: 820px; y: 2500px; width: 254px; height: 20px; p4 := Rectangle { AudioFiltersBody { model: root.m-filters; } } }
    HorizontalLayout { x: 10px; y: 2540px; width: 254px; height: 20px; p5 := Rectangle { RecorderBody { model: root.m-rec-run; } } }

    TipLayer { x: 0px; y: 0px; win-w: root.width; win-h: root.height; }
}
