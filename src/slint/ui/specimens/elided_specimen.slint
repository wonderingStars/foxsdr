// The ELIDED family's specimen (docs 6.62): the places where a longer translation is elided and the tip then says the whole of it - ElidedHint, a squeezed Key, a RailKey caption - beside the
// ones that fit and so say nothing extra. test_slint_elided.cpp hovers each and reads TipState.
//
//   x,   y,   w,    h    what
//   10,  10,  60,   14   ElidedHint, far too long for 60 px                      (hover 40, 17)
//   10,  40,  380,  14   ElidedHint, "Short" in a wide box: fits                   (hover 200, 47)
//   10,  70,  40,   30   Key "A key label too long", squeezed to 40, no tooltip   (hover 30, 85)
//   100, 70,  40,   30   Key "Another long label", squeezed, tooltip "What it does" (hover 120, 85)
//   200, 70,  hug,  30   Key "Fits", tooltip "Own tip": nothing is elided          (hover 215, 85)
//   10,  110, 64,   64   RailKey, caption "INSTRUMENTS" in a 64 px rail, tooltip "Tools" (hover 42, 142)
//   200, 110, 120,  24   SelectKey, a value far too long for 120 px, no tooltip       (hover 240, 122)
//   10,  190, 150,  32   Section, a name far too long for 150 px, tooltip "Does things" (hover 40, 206)
import { Theme } from "../theme.slint";
import { TipState, ElidedHint } from "../tooltip.slint";
import { Key, RailKey } from "../keys.slint";
import { Section, SelectKey } from "../sections.slint";
export { TipState }

export component ElidedSpecimen inherits Window {
    width: 400px;
    height: 260px;
    background: Theme.bg;

    ElidedHint { x: 10px; y: 10px; width: 60px; height: 14px; text: "A hint far too long for sixty pixels"; }
    ElidedHint { x: 10px; y: 40px; width: 380px; height: 14px; text: "Short"; }
    Key { x: 10px; y: 70px; width: 40px; label: "A key label too long"; }
    Key { x: 100px; y: 70px; width: 40px; label: "Another long label"; tooltip: "What it does"; }
    Key { x: 200px; y: 70px; width: self.preferred-width; label: "Fits"; tooltip: "Own tip"; }
    RailKey { x: 10px; y: 110px; width: 64px; height: 64px; caption: "INSTRUMENTS"; tooltip: "Tools"; }
    SelectKey { x: 200px; y: 110px; width: 120px; value: "A value far too long for the key"; }
    Section { x: 10px; y: 190px; width: 150px; name: "A section name far too long to fit"; tooltip: "Does things"; }
}
