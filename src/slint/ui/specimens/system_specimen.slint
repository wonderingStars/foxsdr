}

component SpecTester inherits TesterBody {
    tester-unlink() => { Rec.rec("tester-unlink", ""); }
    tester-remove-code() => { Rec.rec("tester-remove-code", ""); }
    tester-code-committed(a) => { Rec.rec("tester-code-committed", a); }
    tester-use() => { Rec.rec("tester-use", ""); }
    tester-show-sent(a) => { Rec.rec("tester-show-sent", a ? "1" : "0"); }
