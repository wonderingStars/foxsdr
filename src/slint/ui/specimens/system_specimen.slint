        themes: [{ label: "Night Watch", id: "night", enabled: true, note: "" }, { label: "Field Radio", id: "field", enabled: true, note: "" }],
        theme-index: 0,
        db-min: 0.0, db-min-text: "-160", db-max: 1.0, db-max-text: "20",
        freq-displays: [{ label: "Neon", id: "neon", enabled: true, note: "" }], freq-display-index: 0,
        figures: [{ label: "Enlarged figures", id: "enlarged", enabled: true, note: "" }], figures-index: 0,
        tuner-switches: false, enlarge-readings: true,
