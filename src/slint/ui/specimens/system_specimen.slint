            { heading: "Mode", rows: [
                { id: "modeCw", action: "Mode CW", chord: "Ctrl+Shift+PageDown", capturing: false, clash: "" },
                { id: "modeAm", action: "Mode AM", chord: "Ctrl+A", capturing: false, clash: "" },
            ] },
        ],
        footer: "32 actions, 1 clash",
    };
    in-out property <KeyBindingsModel> m-keys-plain: {
        help: "Click a key, then press the new chord.", reset-label: "Reset to defaults", changed: false,
        groups: [{ heading: "Receiver", rows: [
            { id: "startStop", action: "Start / stop the receiver", chord: "Ctrl+F2", capturing: false, clash: "" },
            { id: "volumeUp", action: "Volume up", chord: "Plus", capturing: false, clash: "" },
        ] }],
        footer: "32 actions, 0 clashes",
    };
    // the rule-11 probe's own model: the same rows with nothing listening (two listening caps would fight for the keyboard)
    in-out property <KeyBindingsModel> m-keys-probe: {
        help: "Click a key, then press the new chord. Esc leaves it, Backspace clears it.", reset-label: "Reset to defaults", changed: true,
        groups: [
            { heading: "Receiver", rows: [
                { id: "startStop", action: "Start / stop the receiver", chord: "Ctrl+F2", capturing: false, clash: "" },
                { id: "squelchDown", action: "Squelch down", chord: "Ctrl+Shift+PageDown", capturing: false, clash: "Same chord as \"Mode CW\"" },
            ] },
        ],
        footer: "32 actions, 1 clash",
    };
    in-out property <DiagnosticsModel> m-diag: {
        offer: "FoxSDR did not close normally last time.",
        explanation: "If FoxSDR crashes or freezes, it writes a report on THIS machine. With this switch on, that report is also sent to us the NEXT time you open FoxSDR.",
        sent-text: "Sent: the version and build, what failed and where. NEVER sent: a frequency you tuned to. Off means off.",
        record: true, what-open: true,
        what-text: "version  commit  os  arch  mode  source  sample rate. NEVER a frequency, never anything decoded, never your position.",
        minidump: false, dump-note: "A memory dump can contain file names, window titles and received signal data. It is written LOCALLY ONLY.",
        log-path: "Log: C:\\Users\\fox\\AppData\\Local\\FoxSDR\\logs\\foxsdr.log", reports-path: "Reports: C:\\Users\\fox\\AppData\\Local\\FoxSDR\\reports",
        ledger: false, ledger-note: "For a click that lands away from the control it was aimed at.",
        bundle-status: "Copied to the clipboard.",
        sdrplay-text: "For SDRplay owners: steps the RSP through every sample rate, band, LNA state and antenna once, and writes one text file you can attach to a bug report.",
        sdrplay-enabled: true, sdrplay-status: "",
    };
    in-out property <UsageModel> m-usage-on: {
        disclosure: "FoxSDR can send a small anonymous report: which version, which radio family, how long it ran.",
        send: true, state-line: "Two messages are sent: one when FoxSDR starts, one when it ends.", install-id-line: "Install id 3f9a-77c1-0b2e (random, made on this computer)",
        what-label: "What exactly is sent?", privacy-label: "Privacy policy (foxsdr.com)",
        what-open: true, what-text: "Each report carries only:",
        payload: ["version and build, Windows version", "how long each session ran", "which radio family was open, never a serial number", "which plugins ran, by name"],
    };
    in-out property <UsageModel> m-usage-off: {
        disclosure: "FoxSDR can send a small anonymous report.", send: false, state-line: "Off. Nothing is transmitted.", install-id-line: "",
        what-label: "What exactly is sent?", privacy-label: "Privacy policy (foxsdr.com)", what-open: false, payload: [],
    };
    in-out property <TesterModel> m-tester-linked: {
        shown: true, explanation: "This build reports to the FoxSDR team under your tester name.",
        linked-line: "Linked to Alex T.", code-line: "", invalid-line: "", use-label: "", field-shown: false,
        sent-text: "What is sent: your tester name and the install id, with each report.",
        sent-open: true, sent-preview: "{ \"tester\": \"A*** T***\", \"install\": \"3f9a-****\" }",
    };
    in-out property <TesterModel> m-tester-open: {
        shown: true, explanation: "Paste the code or link the FoxSDR team gave you.",
        linked-line: "", code-line: "A tester code is set.", invalid-line: "That code was not recognised.", error-line: "That does not look like a tester code or link.", code-draft: "ab12cd34", use-label: "Use this code", field-shown: true,
        sent-text: "", sent-open: false, sent-preview: "",
    };
    in-out property <ReportPageModel> m-feature: {
        shown: true, kind: 0, title: "Request a feature", text: "", counter: "0 / 100000 characters", contact: "",
        no-email-note: "Without an email address we cannot reply or tell you when this is added.",
        attach-note: "Sends your message above, the FoxSDR version, and whether this is a feature request.",
        send-enabled: false, refusal: "(type a request first)", sent-line: "Thank you - your request was sent.", sent-tone: ChipTone.good,
    };
    in-out property <ReportPageModel> m-bug: {
        shown: true, kind: 1, title: "Report a bug or dislike", text: "", counter: "0 / 100000 characters", contact: "alex@",
        recognised-line: "A report was recognised and attached as FoxSDR report 0412",
        kind-question: "What are you reporting?",
        problem-kinds: [{ label: "Something is broken (bug)", id: "bug", enabled: true, note: "" }, { label: "Something I dislike", id: "dislike", enabled: true, note: "" }],
        problem-kind-index: -1,
        local-only-line: "Kept on this computer: report-0412.txt in the reports folder.",
        no-email-note: "Without an email address we cannot reply or tell you when this is fixed.",
        attach: true,
        evidence: ["FoxSDR 0.99.105 | Windows 11", "RTL-SDR Blog V4 | 2.400 MS/s", "3 plugins running"],
        probe-shown: true, probe-on: false,
        preview-open: true, preview-text: "FoxSDR 0.99.105 | Windows 11 | RTL-SDR Blog V4 | 2.400 MS/s\nlog: 412 lines, the last at 14:05:11",
        attach-note: "Sends whether this is a bug or a dislike, your message above, the contact line below it and the log.",
        send-enabled: true, refusal: "(write what went wrong first)", sent-line: "Sending...", sent-tone: ChipTone.warn,
    };

    // ============================ column A (x 10) ============================
    a1 := Section { x: 10px; y: 10px; width: 296px; small: true; open: true; name: "Display"; chip: "BAND PLAN ON"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecDisplay { model: root.m-display; } }
    a2 := Section { x: 10px; y: a1.y + a1.height + 10px; width: 296px; small: true; open: true; name: "Display"; chip: "BAND PLAN ON"; tone: ChipTone.good;
        DisplayBody { model: root.m-display-err; } }

    // ============================ column B (x 316) ============================
    b1 := Section { x: 316px; y: 10px; width: 296px; small: true; open: true; name: "Language & country"; chip: "DEUTSCH"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecLanguage { model: root.m-lang; } }
    b2 := Section { x: 316px; y: b1.y + b1.height + 10px; width: 296px; small: true; open: true; name: "Updates"; chip: "UP TO DATE";
        SpecUpdates { model: root.m-upd-ok; } }
    b3 := Section { x: 316px; y: b2.y + b2.height + 10px; width: 296px; small: true; open: true; name: "Updates"; chip: "UPDATE"; tone: ChipTone.warn;
        SpecUpdates { model: root.m-upd-new; } }
    b4 := Section { x: 316px; y: b3.y + b3.height + 10px; width: 296px; small: true; open: true; name: "Serial ports"; chip: "2";
        SpecSerial { model: root.m-ser; } }
    b5 := Section { x: 316px; y: b4.y + b4.height + 10px; width: 296px; small: true; open: true; name: "Serial ports"; chip: "NONE";
        SerialPortsBody { model: root.m-ser-none; } }

    // ============================ column C (x 622) ============================
    c1 := Section { x: 622px; y: 10px; width: 296px; small: true; open: true; name: "Key bindings"; chip: "CHANGED"; tone: ChipTone.warn;
        SpecKeys { model: root.m-keys; } }
    c2 := Section { x: 622px; y: c1.y + c1.height + 10px; width: 296px; small: true; open: true; name: "Key bindings"; chip: "DEFAULT";
        KeyBindingsBody { model: root.m-keys-plain; } }

    // ============================ column D (x 928) ============================
    d1 := Section { x: 928px; y: 10px; width: 296px; small: true; open: true; name: "Diagnostics"; chip: "ON"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecDiag { model: root.m-diag; } }
    d2 := Section { x: 928px; y: d1.y + d1.height + 10px; width: 296px; small: true; open: true; name: "Usage reporting"; chip: "ON"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecUsage { model: root.m-usage-on; } }
    d3 := Section { x: 928px; y: d2.y + d2.height + 10px; width: 296px; small: true; open: true; name: "Usage reporting"; chip: "OFF";
        SpecUsage { model: root.m-usage-off; } }
    d4 := Section { x: 928px; y: d3.y + d3.height + 10px; width: 296px; small: true; open: true; name: "Beta tester"; chip: "LINKED"; tone: ChipTone.warn; show-dot: true; dot: LampState.yellow;
        SpecTester { model: root.m-tester-linked; } }
    d5 := Section { x: 928px; y: d4.y + d4.height + 10px; width: 296px; small: true; open: true; name: "Beta tester"; chip: "INVALID"; tone: ChipTone.err; show-dot: true; dot: LampState.red;
        SpecTester { model: root.m-tester-open; } }

    // ============================ the two report pages ============================
    feature-stage := Rectangle { x: 10px; y: root.pages-y; width: 500px; height: 420px; background: Theme.bg; clip: true;
        SpecReport { x: 0px; y: 0px; width: parent.width; height: parent.height; model: root.m-feature;
            report-text(t) => {
                Rec.rec("report-text", t);
                root.m-feature.send-enabled = t != "";
            }
        } }
    bug-stage := Rectangle { x: 520px; y: root.pages-y; width: 520px; height: 820px; background: Theme.bg; clip: true;
        SpecReport { x: 0px; y: 0px; width: parent.width; height: parent.height; model: root.m-bug; } }

    // ============================ rule 11: bare bodies in a 254-wide cell ============================
    // (the cell's width, if a body asks for more than 254 px, would be wider)
    HorizontalLayout { x: 10px; y: root.probe-y; width: 254px; height: 20px; p1 := Rectangle { DisplayBody { model: root.m-display; } } }
    HorizontalLayout { x: 280px; y: root.probe-y; width: 254px; height: 20px; p2 := Rectangle { LanguageBody { model: root.m-lang; } } }
    HorizontalLayout { x: 550px; y: root.probe-y; width: 254px; height: 20px; p3 := Rectangle { UpdatesBody { model: root.m-upd-new; } } }
    HorizontalLayout { x: 820px; y: root.probe-y; width: 254px; height: 20px; p4 := Rectangle { SerialPortsBody { model: root.m-ser; } } }
    HorizontalLayout { x: 10px; y: root.probe-y + 40px; width: 254px; height: 20px; p5 := Rectangle { KeyBindingsBody { model: root.m-keys-probe; } } }
    HorizontalLayout { x: 280px; y: root.probe-y + 40px; width: 254px; height: 20px; p6 := Rectangle { DiagnosticsBody { model: root.m-diag; } } }
    HorizontalLayout { x: 550px; y: root.probe-y + 40px; width: 254px; height: 20px; p7 := Rectangle { UsageBody { model: root.m-usage-on; } } }
    HorizontalLayout { x: 820px; y: root.probe-y + 40px; width: 254px; height: 20px; p8 := Rectangle { TesterBody { model: root.m-tester-open; } } }
    HorizontalLayout { x: 10px; y: root.probe-y + 80px; width: 254px; height: 20px; p9 := Rectangle { GpsRowView { gps: root.m-ser.gps; } } }

    TipLayer { x: 0px; y: 0px; win-w: root.width; win-h: root.height; }
}
