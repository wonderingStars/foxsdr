        countries: [
            { label: "Not set", id: "", enabled: true, note: "" },
            { label: "United Kingdom", id: "GB", enabled: true, note: "GB" },
            { label: "Germany", id: "DE", enabled: true, note: "DE" },
            { label: "France", id: "FR", enabled: true, note: "FR" },
            { label: "Spain", id: "ES", enabled: true, note: "ES" },
            { label: "Italy", id: "IT", enabled: true, note: "IT" },
            { label: "Ireland", id: "IE", enabled: true, note: "IE" },
            { label: "Netherlands", id: "NL", enabled: true, note: "NL" },
            { label: "Belgium", id: "BE", enabled: true, note: "BE" },
            { label: "Austria", id: "AT", enabled: true, note: "AT" },
            { label: "Switzerland", id: "CH", enabled: true, note: "CH" },
            { label: "Poland", id: "PL", enabled: true, note: "PL" },
            { label: "Norway", id: "NO", enabled: true, note: "NO" },
        ],
        country-index: 1, country-filter: "",
        country-hint: "Type to narrow the list", plan-line: "Band plan: United Kingdom", plan-changed-hint: "This overrides the current band plan",
    };
    in-out property <UpdatesModel> m-upd-ok: {
        check-at-startup: true, channel-index: 0,
        channel-help: "Stable releases are announced on the website. Beta releases come out as soon as they pass the tests and may have rough edges.",
        privacy: "Checking sends nothing about you: FoxSDR asks foxsdr.com for the latest version number and compares it here.",
        version-line: "FoxSDR 0.99.105", team-message: "1 message from the FoxSDR team",
        status-line: "You are up to date", status-tone: ChipTone.good,
        packaged: false, show-again: false,
    };
    in-out property <UpdatesModel> m-upd-new: {
        check-at-startup: true, channel-index: 1,
        channel-help: "Every release, beta ones included, as soon as it is published.",
        privacy: "Checking sends nothing about you.",
        version-line: "FoxSDR 0.99.105",
        status-line: "FoxSDR 0.99.106 is available", status-tone: ChipTone.warn, show-again: true, show-again-label: "Show it again",
    };
    in-out property <SerialPortsModel> m-ser: {
        intro: "The serial ports on this computer. A GPS receiver on one of them can tell FoxSDR where it is.",
        empty-line: "No serial ports found",
        ports: ["COM3", "COM7"],
        gps: {
            ports: [{ label: "COM3", id: "COM3", enabled: true, note: "" }, { label: "COM7", id: "COM7", enabled: true, note: "" }], port-index: 0,
            bauds: [{ label: "4800", id: "", enabled: true, note: "" }, { label: "9600", id: "", enabled: true, note: "" }, { label: "19200", id: "", enabled: true, note: "" }], baud-index: 1,
            listening: true, key-label: "Stop", status: "Waiting for a fix... 6 s", status-tone: ChipTone.warn, satellites: "7 satellites in view", key-enabled: true,
            refusal: "The GPS fix was refused by the position rule (off the globe, or 0,0).",
        },
        gps-note: "The position goes to the map and the Radar section.",
        gps-hint: "or read it from a GPS receiver on a serial port:",
    };
    in-out property <SerialPortsModel> m-ser-none: {
        intro: "The serial ports on this computer.", empty-line: "No serial ports found", ports: [],
        gps: {
            ports: [], port-index: -1, bauds: [{ label: "9600", id: "", enabled: true, note: "" }], baud-index: 0,
            listening: false, key-label: "Read position from GPS", status: "", status-tone: ChipTone.neutral, satellites: "", key-enabled: true,
