// The SYSTEM bank specimen sheet (1240 x 2560): every body of ui/system_bank.slint inside the REAL Section it is shown under (296 wide: the body is 254 px,
// the Section's own padding 30 / 12), on the sample models below, so tests/test_slint_system.cpp can probe the pixels against the Banks artboard
// (artboards/Workbench-Banks.dc.html: the SYSTEM column A5 and its closed sections A5b) and press the controls with real pointer and key events.
// Four columns of stacked Sections (each Section's y is the one above's y + height + 10, so the stack holds whatever height the typefaces settle on);
// the two report pages sit under them, each over a stage of its own.
//
//   column x      Section (296 wide, small = 30 px row)                              model            what it shows
//   A  10   a1    Display / BAND PLAN ON    interface size, theme, Min / Max dB, frequency display, counter figures, the two ticks, the icon and trail
//                                           sliders, the band plan tick, Size + Colour, Region, the green plan status         m-display
//          a2    Display / BAND PLAN ON    default-forwarding to SystemEvents; the error variant: tuner switches off, enlarged readings, the red status   m-display-err
//   B  316  b1    Language & country / DEUTSCH  Language, the amber machine hint, SUGGEST A BETTER TRANSLATION, Country, the plan line, the override hint, USE DEUTSCH   m-lang
//          b2    Updates / UP TO DATE      the tick, the Stable / Beta radios (Stable lit), help, privacy, version, the team message, the green status    m-upd-ok
//          b3    Updates / UPDATE          Beta lit, the amber status line, Show it again                                                                m-upd-new
//          b4    Serial ports / 2          intro, Refresh, the one-column table of two ports, the GPS receiver rule, the GPS row (listening), the note   m-ser
//          b5    Serial ports / NONE       default-forwarding: the empty line, the GPS row not listening                                                  m-ser-none
//   C  622  c1    Key bindings / CHANGED    help, Receiver (+ Reset) with four rows - one listening, one clashing - then Mode with two rows, the footer   m-keys
//          c2    Key bindings / DEFAULT    default-forwarding to SystemEvents, nothing listening                                                         m-keys-plain
//   D  928  d1    Diagnostics / ON          the amber offer, explanation, the tick, the sent text, the disclosure (open), the dump tick and note, paths, ledger, keys, SDRplay   m-diag
//          d2    Usage reporting / ON      disclosure, the tick, the install id, the two keys, the payload list                                         m-usage-on
//          d3    Usage reporting / OFF     the off line only                                                                                              m-usage-off
//          d4    Beta tester / LINKED      explanation, Linked to ... + Unlink, the sent text and the masked preview (open)                              m-tester-linked
//          d5    Beta tester / UNLINKED    the invalid-code line (red), the masked field + SHOW, Use this code, Show what is sent                         m-tester-open
//   pages: feature-stage (10, pages-y, 500 x 420) holds ReportSheet kind 0; bug-stage (520, pages-y, 520 x 820) holds ReportSheet kind 1
//   probes: p1..p9 (254-wide layout cells, below the window's last row) hold bare bodies and report the cell's width (rule 11)
//
// What the test reads: `Rec` counts and names every callback of the bodies with an override, the sections' y and heights are out properties, and the plain
// (default-forwarding) bodies are watched through the SystemEvents global.
import { Theme, Skin, Workbench } from "../theme.slint";
import { ChipTone, LampState } from "../chips.slint";
import { Section } from "../sections.slint";
import { TipLayer } from "../tooltip.slint";
import { SelectItem } from "../signal_bank.slint";
import { DisplayModel, LanguageModel, UpdatesModel, GpsRow, SerialPortsModel, KeyRow, KeyGroup, KeyBindingsModel, DiagnosticsModel, UsageModel, TesterModel, ReportPageModel, SystemEvents, DisplayBody, LanguageBody, UpdatesBody, GpsRowView, SerialPortsBody, KeyBindingsBody, DiagnosticsBody, UsageBody, TesterBody, ReportSheet } from "../system_bank.slint";
export { Theme, Skin, Workbench, ChipTone, LampState, SelectItem, DisplayModel, LanguageModel, UpdatesModel, GpsRow, SerialPortsModel, KeyRow, KeyGroup, KeyBindingsModel, DiagnosticsModel, UsageModel, TesterModel, ReportPageModel, SystemEvents }

// What the bodies with an override report: the callback's name and its arguments, joined with a space.
export global Rec {
    in-out property <int> events;
    in-out property <string> last;
    in-out property <string> last-args;
    callback fired(string, string);
    public function rec(name: string, args: string) {
        Rec.events += 1;
        Rec.last = name;
        Rec.last-args = args;
        Rec.fired(name, args);
    }
}

component SpecDisplay inherits DisplayBody {
    display-scale(a) => { Rec.rec("display-scale", "" + a); }
    display-theme(a) => { Rec.rec("display-theme", "" + a); }
    display-db-min(a) => { Rec.rec("display-db-min", "" + a); }
    display-db-max(a) => { Rec.rec("display-db-max", "" + a); }
    display-freq-display(a) => { Rec.rec("display-freq-display", "" + a); }
    display-figures(a) => { Rec.rec("display-figures", "" + a); }
    display-tuner-switches(a) => { Rec.rec("display-tuner-switches", a ? "1" : "0"); }
    display-enlarge(a) => { Rec.rec("display-enlarge", a ? "1" : "0"); }
    display-icon-px(a) => { Rec.rec("display-icon-px", "" + a); }
    display-trail-px(a) => { Rec.rec("display-trail-px", "" + a); }
    display-band-plan(a) => { Rec.rec("display-band-plan", a ? "1" : "0"); }
    display-band-size(a) => { Rec.rec("display-band-size", "" + a); }
    display-band-colour(a) => { Rec.rec("display-band-colour", "" + a); }
    display-region(a) => { Rec.rec("display-region", "" + a); }
}

