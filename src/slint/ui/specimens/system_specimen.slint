component SpecReport inherits ReportSheet {
    report-text(a) => { Rec.rec("report-text", a); }
    report-contact(a) => { Rec.rec("report-contact", a); }
    report-kind(a) => { Rec.rec("report-kind", "" + a); }
    report-attach(a) => { Rec.rec("report-attach", a ? "1" : "0"); }
