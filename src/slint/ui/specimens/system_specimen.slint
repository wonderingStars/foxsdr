    in-out property <KeyBindingsModel> m-keys: {
        help: "Click a key, then press the new chord. Esc leaves it, Backspace clears it.", reset-label: "Reset to defaults", changed: true,
        groups: [
            { heading: "Receiver", rows: [
                { id: "startStop", action: "Start / stop the receiver", chord: "Ctrl+F2", capturing: false, clash: "" },
                { id: "mute", action: "Mute the sound", chord: "M", capturing: false, clash: "" },
                { id: "squelchUp", action: "Squelch up", chord: "Ctrl+Shift+PageUp", capturing: true, clash: "" },
                { id: "squelchDown", action: "Squelch down", chord: "Ctrl+Shift+PageDown", capturing: false, clash: "Same chord as \"Mode CW\"" },
