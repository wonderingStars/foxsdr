            { label: "150%", id: "150", enabled: true, note: "" },
            { label: "175%", id: "175", enabled: true, note: "" },
            { label: "200%", id: "200", enabled: true, note: "" },
            { label: "250%", id: "250", enabled: true, note: "" },
        ],
        scale-index: 0,
        themes: [
            { label: "Today's bench", id: "workbench", enabled: true, note: "" },
            { label: "Bench Classic XL", id: "classic", enabled: true, note: "" },
            { label: "Night Watch", id: "night", enabled: true, note: "" },
            { label: "Glass Cockpit", id: "glass", enabled: true, note: "" },
            { label: "Daylight Lab", id: "daylight", enabled: true, note: "" },
            { label: "Field Radio", id: "field", enabled: true, note: "" },
        ],
        theme-index: 0,
        db-min: 0.357, db-min-text: "-110", db-max: 0.833, db-max-text: "0",
        freq-displays: [
            { label: "Nixie tubes", id: "nixie", enabled: true, note: "" },
            { label: "Neon", id: "neon", enabled: true, note: "" },
            { label: "Plain", id: "plain", enabled: true, note: "" },
        ],
        freq-display-index: 0,
        figures: [
            { label: "Normal size", id: "normal", enabled: true, note: "" },
            { label: "Enlarged figures", id: "enlarged", enabled: true, note: "" },
        ],
        figures-index: 0,
        tuner-switches: true, enlarge-readings: false,
        icon-px: 0.4, icon-text: "48 px", trail-px: 0.1, trail-text: "4 px",
        band-plan: true,
        band-sizes: [
            { label: "Small", id: "", enabled: true, note: "" },
            { label: "Medium", id: "", enabled: true, note: "" },
            { label: "Large", id: "", enabled: true, note: "" },
