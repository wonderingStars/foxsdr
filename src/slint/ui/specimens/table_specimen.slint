// The Table family's specimen sheet (440 x 440). Every variant sits at an absolute position; nothing overlaps.
//
//   x    y    w    h   what
//   10   10   420  160 the panel ground (Theme.panel, the torn-off window's body) behind the frame-log table
//   10   10   420  160 Table A: columns Time (78, mono) | Source (70) | Message (rest) | Level (56); heading 22 high at y 10..32;
//                      9 body rows 24 high from y 32 (content 216 > viewport 138, so the body scrolls under the frozen heading)
//                        row 0  group  "TODAY - MONDAY 2 NOVEMBER 2026" (one cell, spans every column, muted)
//                        row 1  normal
//                        row 2  warn,   band
//                        row 3  good
//                        row 4  muted,  band
//                        row 5  normal, the SELECTED row (root.selected, default 5)
//                        row 6  key tone
//                        row 7  normal, band
//                        row 8  normal
//                      the right edge of every heading cell is a 6 px resize zone (Time: x 82..88, Source: x 152..158, ...)
//   10   180  300  80  the panel ground behind the empty table
//   10   180  300  80  Table B with no rows: heading, then "Nothing to show yet." in Theme.dim
//   10   270  420  151 the panel ground behind the panel-rows table
//   10   270  420  151 Table C, a plugin's own panel (columns Item 120 | Value rest): heading 22 high at y 270..292, then
//                        row 0  y 292  24  heading kind  "PROGRAMMES (UP TO FOUR PER ENSEMBLE)" - the dim cap across the columns
//                        row 1  y 316  24  pressable "HD1"
//                        row 2  y 340  24  pressable "HD2", band
//                        row 3  y 364   9  separator kind: a Theme.line-strong rule at y 368, no hairline
//                        row 4  y 373  24  heading kind "SIGNAL"
//                        row 5  y 397  24  plain cells "Level" / "-62 dBFS" (not pressable); its hairline is the table's last pixel row, y 420
//
// State the test reads: clicks / last-row (Table A clicked), right-clicks / last-right-row / last-right-x / last-right-y (right-clicked),
// resizes / last-resized-column / last-resized-width (Table A column-resized), c-clicks / c-last-row (Table C clicked), presses /
// last-press-row (Table C row-pressed), pointer-cursor (the pointer is over a pressable row of Table C: the hand cursor), resize-cursor
// (the pointer is in a resize zone of Table A: the ew-resize cursor).
// State the test sets: selected (the selected row, -1 none), table-enabled, c-enabled, rows (Table A's whole model), widths (Table A's
// column-widths, two-way: a column drag writes into it).
import { Theme, Skin, Workbench } from "../theme.slint";
import { RowTone, RowKind, TableRow, Table } from "../table.slint";
export { Theme, Skin, Workbench }
export { RowTone, RowKind, TableRow }

export component TableSpecimen inherits Window {
    width: 440px;
    height: 440px;
    background: Theme.bg;

    in-out property <int> selected: 5;
    in-out property <[length]> widths: [78px, 70px, 0px, 56px];
    in-out property <[TableRow]> rows: [
        { cells: ["TODAY - MONDAY 2 NOVEMBER 2026"], tone: RowTone.muted, band: false, kind: RowKind.cells, pressable: false },
        { cells: ["14:32:08", "M0ABC", "Position report 51.50N 000.07W", "INFO"], tone: RowTone.normal, band: false, kind: RowKind.cells, pressable: false },
        { cells: ["14:32:41", "G4XYZ", "Bad checksum, frame dropped", "WARN"], tone: RowTone.warn, band: true, kind: RowKind.cells, pressable: false },
        { cells: ["14:33:02", "M0ABC", "Message acknowledged", "GOOD"], tone: RowTone.good, band: false, kind: RowKind.cells, pressable: false },
        { cells: ["14:33:40", "ISS", "Digipeated, 2 hops", "MUTED"], tone: RowTone.muted, band: true, kind: RowKind.cells, pressable: false },
        { cells: ["14:34:11", "2E0FOX", "Whole row selectable (hovered)", "INFO"], tone: RowTone.normal, band: false, kind: RowKind.cells, pressable: false },
        { cells: ["14:34:52", "G0KEY", "A row in the key tone", "INFO"], tone: RowTone.key, band: false, kind: RowKind.cells, pressable: false },
        { cells: ["14:35:30", "M0ABC", "Position report 51.51N 000.08W", "INFO"], tone: RowTone.normal, band: true, kind: RowKind.cells, pressable: false },
        { cells: ["14:36:02", "G4XYZ", "Position report 51.52N 000.09W", "INFO"], tone: RowTone.normal, band: false, kind: RowKind.cells, pressable: false },
    ];
    in-out property <bool> table-enabled: true;
    in-out property <bool> c-enabled: true;
    in-out property <int> clicks;
    in-out property <int> last-row: -1;
    in-out property <int> right-clicks;
    in-out property <int> last-right-row: -1;
    in-out property <length> last-right-x;
    in-out property <length> last-right-y;
    in-out property <int> resizes;
    in-out property <int> last-resized-column: -1;
    in-out property <length> last-resized-width;
    in-out property <int> c-clicks;
    in-out property <int> c-last-row: -1;
    in-out property <int> presses;
    in-out property <int> last-press-row: -1;
    out property <bool> pointer-cursor: table-c.pointer-cursor;
    out property <bool> resize-cursor: table-a.resize-cursor;

    Rectangle { x: 10px; y: 10px; width: 420px; height: 160px; background: Theme.panel; }
    table-a := Table {
        x: 10px;
        y: 10px;
        width: 420px;
        height: 160px;
        columns: ["Time", "Source", "Message", "Level"];
        column-widths <=> root.widths;
        mono-columns: [true, false, false, false];
        empty-text: "Nothing to show yet.";
        selected: root.selected;
        enabled: root.table-enabled;
        tooltip: "Click a row to select it, right-click for its menu";
        rows: root.rows;
        clicked(row) => { root.clicks += 1; root.last-row = row; }
        right-clicked(row, x, y) => {
            root.right-clicks += 1;
            root.last-right-row = row;
            root.last-right-x = x;
            root.last-right-y = y;
        }
        column-resized(column, width) => {
            root.resizes += 1;
            root.last-resized-column = column;
            root.last-resized-width = width;
        }
    }

    Rectangle { x: 10px; y: 180px; width: 300px; height: 80px; background: Theme.panel; }
    Table {
        x: 10px;
        y: 180px;
        width: 300px;
        height: 80px;
        columns: ["Time", "Source", "Message", "Level"];
        column-widths: [78px, 70px, 0px, 56px];
        mono-columns: [true, false, false, false];
        rows: [];
        empty-text: "Nothing to show yet.";
    }

    Rectangle { x: 10px; y: 270px; width: 420px; height: 151px; background: Theme.panel; }
    table-c := Table {
        x: 10px;
        y: 270px;
        width: 420px;
        height: 151px;
        columns: ["Item", "Value"];
        column-widths: [120px, 0px];
        mono-columns: [false, true];
        selected: -1;
        enabled: root.c-enabled;
        rows: [
            { cells: ["PROGRAMMES (UP TO FOUR PER ENSEMBLE)"], tone: RowTone.normal, band: false, kind: RowKind.heading, pressable: false },
            { cells: ["HD1", "Fox FM"], tone: RowTone.normal, band: false, kind: RowKind.cells, pressable: true },
            { cells: ["HD2", "Fox Classic"], tone: RowTone.normal, band: true, kind: RowKind.cells, pressable: true },
            { cells: [], tone: RowTone.normal, band: false, kind: RowKind.separator, pressable: false },
            { cells: ["SIGNAL"], tone: RowTone.normal, band: false, kind: RowKind.heading, pressable: false },
            { cells: ["Level", "-62 dBFS"], tone: RowTone.normal, band: false, kind: RowKind.cells, pressable: false },
        ];
        clicked(row) => { root.c-clicks += 1; root.c-last-row = row; }
        row-pressed(row) => { root.presses += 1; root.last-press-row = row; }
    }
}
