            { id: 52, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" }, { id: 53, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" },
            { id: 54, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" }, { id: 55, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" },
            { id: 56, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" }, { id: 57, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" },
            { id: 58, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" }, { id: 59, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" },
            { id: 60, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" }, { id: 61, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" },
            { id: 62, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" }, { id: 63, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" },
            { id: 64, ticked: false, favourite: false, text: "GB3XX  145.6000 MHz", group: "", name: "GB3XX" },
        ],
        menu-row: -1, error: "",
    };
    in-out property <AirbandModel> m-ab-long: {
        code-draft: "", lookup-label: "Flughafen suchen", nearest-label: "Naechstgelegene Flughaefen", hide-label: "Verbergen",
        airports: [{ code: "EDDF", name: "Frankfurt am Main Flughafen Terminal", distance: "23 km", note: "" }], ambiguous: [],
        preset-name: "", freq-draft: "", name-draft: "", add-label: "Hinzufuegen", note: "", import-path: "", import-label: "Importieren",
        export-label: "Als CSV exportieren", remove-preset-label: "Voreinstellung entfernen", preset-note: "", folder-label: "Den Ordner oeffnen",
        modes: [{ label: "AM", id: "", enabled: true, note: "" }], mode-index: 0,
        groups: [{ label: "Jede angehakte AM- oder NFM-Frequenz", id: "", enabled: true, note: "" }], group-index: 0,
        count-line: "6 von 9 angehakt", tick-all-label: "Alle anhaken", untick-all-label: "Alle abwaehlen", busiest-first: false, hearing: "",
        rows: [{ id: 71, ticked: true, heard: true, text: "118.7000  Frankfurt Turm Anflugkontrolle Sektor Nord", heard-time: "1h 04m 12s", on-air: true }],
        squelch-norm: 0.4, squelch-text: "-110 dB", above-noise-label: "Ueber dem Rauschen", hold-text: "60.0", listening: true, listen-label: "STOPP", next-label: "Naechster Block",
    };

    // ============================ column A (x 10) ============================
    a1 := Section { x: 10px; y: 10px; width: 296px; small: true; name: "Demod scope"; chip: "AUDIO"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        DemodScopeRow { } }
    a2 := Section { x: 10px; y: a1.y + a1.height + 0px; width: 296px; small: true; name: "Radar"; chip: "OFF"; show-dot: true; }
    a3 := Section { x: 10px; y: a2.y + a2.height + 10px; width: 296px; small: true; open: true; name: "Radar"; chip: "OFF"; show-dot: true;
        SpecRadar { model: root.m-radar; } }
    a4 := Section { x: 10px; y: a3.y + a3.height + 10px; width: 296px; small: true; open: true; name: "Radar"; chip: "SET"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        RadarBody { model: root.m-radar-known; } }

    // ============================ column B (x 316) ============================
    b1 := Section { x: 316px; y: 10px; width: 296px; small: true; open: true; name: "Bookmarks"; chip: "7"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecBookmarks { model: root.m-bm; } }
    b2 := Section { x: 316px; y: b1.y + b1.height + 10px; width: 296px; small: true; open: true; name: "Bookmarks"; chip: "2"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        BookmarksBody { model: root.m-bm-plain; } }
    b3 := Section { x: 316px; y: b2.y + b2.height + 10px; width: 296px; small: true; open: true; name: "Bookmarks"; chip: "14"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        BookmarksBody { model: root.m-bm-long; } }

    // ============================ column C (x 622) ============================
    c1 := Section { x: 622px; y: 10px; width: 296px; small: true; open: true; name: "Scanner"; chip: "IDLE"; show-dot: true;
        SpecScanner { model: root.m-sc; } }
    c2 := Section { x: 622px; y: c1.y + c1.height + 10px; width: 296px; small: true; open: true; name: "Scanner"; chip: "SCAN"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecScanner { model: root.m-sc-run; } }
    c3 := Section { x: 622px; y: c2.y + c2.height + 10px; width: 296px; small: true; open: true; name: "Scanner"; chip: "IDLE"; show-dot: true;
        ScannerBody { model: root.m-sc-ticked; } }
    c4 := Section { x: 622px; y: c3.y + c3.height + 10px; width: 296px; small: true; open: true; name: "Airband"; chip: "IDLE"; show-dot: true;
        SpecAirband { model: root.m-ab; } }

    // ============================ column D (x 928) ============================
    d1 := Section { x: 928px; y: 10px; width: 296px; small: true; open: true; name: "Airband"; chip: "LISTEN"; tone: ChipTone.good; show-dot: true; dot: LampState.green;
        SpecAirband { model: root.m-ab-run; } }
    d2 := Section { x: 928px; y: d1.y + d1.height + 10px; width: 296px; small: true; open: true; name: "Airband"; chip: "IDLE"; show-dot: true;
        AirbandBody { model: root.m-ab-plain; } }

    // ============================ the Markers sheets ============================
    markers-stage := Rectangle { x: 10px; y: root.sheets-y; width: 660px; height: 380px; background: Theme.bg; clip: true;
        SpecMarkers { x: 0px; y: 0px; width: parent.width; height: parent.height; model: root.m-markers; } }
    markers-empty := Rectangle { x: 690px; y: root.sheets-y; width: 560px; height: 380px; background: Theme.bg; clip: true;
        MarkersSheet { x: 0px; y: 0px; width: parent.width; height: parent.height; model: root.m-markers-empty; } }

    // ============================ rule 11: bare bodies in a 254-wide cell ============================
    // (the cell's width, if a body asks for more than 254 px, would be wider)
    HorizontalLayout { x: 10px; y: root.probe-y; width: 254px; height: 20px; p1 := Rectangle { RadarBody { model: root.m-radar; } } }
    HorizontalLayout { x: 280px; y: root.probe-y; width: 254px; height: 20px; p2 := Rectangle { BookmarksBody { model: root.m-bm; } } }
    HorizontalLayout { x: 550px; y: root.probe-y; width: 254px; height: 20px; p3 := Rectangle { ScannerBody { model: root.m-sc; } } }
    HorizontalLayout { x: 820px; y: root.probe-y; width: 254px; height: 20px; p4 := Rectangle { AirbandBody { model: root.m-ab; } } }
    HorizontalLayout { x: 10px; y: root.probe-y + 40px; width: 254px; height: 20px; p5 := Rectangle { BookmarksBody { model: root.m-bm-long; } } }
    HorizontalLayout { x: 280px; y: root.probe-y + 40px; width: 254px; height: 20px; p6 := Rectangle { AirbandBody { model: root.m-ab-long; } } }
    HorizontalLayout { x: 550px; y: root.probe-y + 40px; width: 254px; height: 20px; p7 := Rectangle { AirbandBody { model: root.m-ab-run; } } }
    HorizontalLayout { x: 820px; y: root.probe-y + 40px; width: 254px; height: 20px; p8 := Rectangle { p8v := PositionOffersView { offers: root.m-radar.offers; } } }

    TipLayer { x: 0px; y: 0px; win-w: root.width; win-h: root.height; }
}
