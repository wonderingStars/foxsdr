// The TOOLS bank specimen sheet (1240 x 2600): every body of ui/tools_bank.slint inside the REAL Section it is shown under (296 wide: the body is 254 px, the
// Section's own padding 30 / 12), on the sample models below, so tests/test_slint_tools.cpp can probe the pixels against the Banks artboard
// (artboards/Workbench-Banks.dc.html: the TOOLS column A3, and SCREENS.md A3 / A3b for what the artboard cuts) and press the controls with real pointer and key
// events. Four columns of stacked Sections (each Section's y is the one above's y + height + 10, so the stack holds whatever height the typefaces settle on);
// the Markers sheets sit under them, each over a stage of its own.
//
//   column x      Section (296 wide, small = 30 px row)                           model           what it shows
//   A  10   a1    Demod scope / AUDIO         the switch row, closed: nothing under it                                                 -
//          a2    Radar / OFF                 the closed row                                                                           -
//          a3    Radar / OFF (open)          the warning, the two offer keys (one disabled), the hint, latitude / longitude, Set RX here, the refusal, the GPS row, the footnote, the scope key and its note     m-radar
//          a4    Radar / SET (open)          the known-position line, latitude / longitude, Set (disabled), the scope key lit ("Leave radar scope"); default-forwarding   m-radar-known
//   B  316  b1    Bookmarks / 7              name + Add current, group + the arrow, import + note + wait line, search + filter, the ticks, the count, the three keys wrapped, the rename row,   m-bm
//                                           seven rows (a star, a dot), the red error line (the row menu opens from a right-click: tools-specimen-menu.png)
//          b3    Bookmarks / 14             the longest translations: 14 rows - the list stops at 12 and scrolls - and every label long                          m-bm-long
//          b2    Bookmarks / 2              default-forwarding to ToolsEvents: no groups (no arrows, no filter, no group keys), two rows, Stack close names greyed    m-bm-plain
//   C  622  c1    Scanner / IDLE             the ticked tick, seven fields, Start scan full width, the status line                     m-sc
//          c2    Scanner / SCAN             Stop scan (lit) + Skip half width, "Scanning | 145.2125 MHz"                              m-sc-run
//          c3    Scanner / IDLE             ticked mode: the first three fields greyed, Start scan disabled, an amber status; default-forwarding   m-sc-ticked
//          c4    Airband / IDLE             the lookup row, nearest + ambiguous lists, the preset rows, the import row and keys, the group, Tick all / Untick all, Busiest first, three rows, squelch, hold, LISTEN   m-ab
//   D  928  d1    Airband / LISTEN           the green "Hearing:" status, two rows - one heard (lamp, amber time) -, squelch, STOP + Next block                          m-ab-run
//          d2    Airband / IDLE             default-forwarding to ToolsEvents: LISTEN full width, no rows                                                         m-ab-plain
//   sheets: markers-stage (10, sheets-y, 660 x 380) holds the Markers sheet with three rows; markers-empty (690, sheets-y, 560 x 380) the empty one (default-forwarding)
//   probes: p1..p9 (254-wide layout cells, below the window's last row) hold bare bodies and report the cell's width (rule 11); the long ones carry the longest
//           translations the catalogue can bring
//
// What the test reads: `Rec` counts and names every callback of the bodies with an override, the sections' y and heights are out properties, and the plain
// (default-forwarding) bodies are watched through the ToolsEvents global.
import { Theme, Skin, Workbench } from "../theme.slint";
import { ChipTone, LampState } from "../chips.slint";
import { Section } from "../sections.slint";
import { TipLayer } from "../tooltip.slint";
import { SelectItem } from "../signal_bank.slint";
import { GpsRow } from "../system_bank.slint";
import { PositionOffers, RadarModel, BookmarkRow, BookmarksModel, ScannerModel, AirbandRow, AirportRow, AirbandModel, MarkerRow, MarkersModel, ToolsEvents, PositionOffersView, DemodScopeRow, RadarBody, BookmarksBody, ScannerBody, AirbandBody, MarkersSheet } from "../tools_bank.slint";
export { Theme, Skin, Workbench, ChipTone, LampState, SelectItem, GpsRow, PositionOffers, RadarModel, BookmarkRow, BookmarksModel, ScannerModel, AirbandRow, AirportRow, AirbandModel, MarkerRow, MarkersModel, ToolsEvents }

// What the bodies with an override report: the callback's name and its arguments, joined with a space.
export global Rec {
    in-out property <int> events;
    in-out property <string> last;
    in-out property <string> last-args;
    callback fired(string, string);
    public function rec(name: string, args: string) {
        Rec.events += 1;
        Rec.last = name;
        Rec.last-args = args;
        Rec.fired(name, args);
    }
}

component SpecRadar inherits RadarBody {
    radar-scope-clicked() => { Rec.rec("radar-scope-clicked", ""); }
    position-heard() => { Rec.rec("position-heard", ""); }
    position-map() => { Rec.rec("position-map", ""); }
    position-lat(a) => { Rec.rec("position-lat", a); }
    position-lon(a) => { Rec.rec("position-lon", a); }
    position-set() => { Rec.rec("position-set", ""); }
    gps-port(a) => { Rec.rec("gps-port", "" + a); }
    gps-baud(a) => { Rec.rec("gps-baud", "" + a); }
    gps-toggle() => { Rec.rec("gps-toggle", ""); }
}

