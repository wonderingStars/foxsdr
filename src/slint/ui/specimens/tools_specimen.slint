    in-out property <BookmarksModel> m-bm: {
        name-draft: "", group-draft: "",
        groups: [
            { label: "Repeaters", id: "", enabled: true, note: "" }, { label: "Space", id: "", enabled: true, note: "" }, { label: "EGLL", id: "", enabled: true, note: "" },
            { label: "PMR", id: "", enabled: true, note: "" }, { label: "Weather", id: "", enabled: true, note: "" }, { label: "EGVN", id: "", enabled: true, note: "" },
