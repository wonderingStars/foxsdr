    in-out property <MarkersModel> m-markers-empty: { shown: true, error: "markers could not be saved", rows: [] };
    // the rule-11 probes: the longest labels a translation can bring
    in-out property <BookmarksModel> m-bm-long: {
        name-draft: "", group-draft: "", add-label: "Aktuelle Frequenz als Lesezeichen hinzufuegen",
        groups: [{ label: "Wiederholer und Relaisfunkstellen", id: "", enabled: true, note: "" }],
        import-path: "", import-label: "Importieren aus Datei", import-note: "12 Frequenzen importiert, 3 schon vorhandene uebersprungen", disk-wait: "Warten auf das Laufwerk beim Oeffnen der Datei: 2 s",
        search: "", filter-groups: [{ label: "Jede Gruppe", id: "", enabled: true, note: "" }], filter-index: 0,
