                bauds: [{ label: "4800", id: "", enabled: true, note: "" }, { label: "9600", id: "", enabled: true, note: "" }], baud-index: 1,
                listening: false, key-label: "Read position from GPS", status: "Waiting for a fix... 6 s", status-tone: ChipTone.warn, satellites: "", key-enabled: true,
                refusal: "The GPS fix was refused by the position rule (off the globe, or 0,0).",
            },
            footnote: "All serial-port settings are also under SYSTEM > Serial ports.",
        },
        scope-label: "", scope-on: false,
        scope-note: "The scope will be empty. An ADS-B decoder is what fills this face; the plugin store is where one is fitted from.",
    };
    in-out property <RadarModel> m-radar-known: {
        warning: "",
        offers: {
            known: true, known-text: "Receiver position set: 51.50720, -0.12760",
            hint: "", lat-text: "51.50720", lon-text: "-0.12760", error: "",
            set-disabled: true, set-tooltip: "Latitude must be -90..90 and longitude -180..180",
            gps-shown: false, footnote: "",
