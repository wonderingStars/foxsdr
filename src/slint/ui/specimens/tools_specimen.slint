        hearing: "",
        rows: [
            { id: 31, ticked: true, heard: false, text: "118.7000  Tower", heard-time: "4m 12s", on-air: false },
            { id: 32, ticked: true, heard: false, text: "121.9000  Ground", heard-time: "", on-air: false },
