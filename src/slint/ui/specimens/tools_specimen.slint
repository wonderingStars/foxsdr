export component ToolsSpecimen inherits Window {
    width: 1240px;
    height: 2080px;
    background: Theme.bg;

    // ---- the geometry the test reads ----
    out property <length> a1-y: a1.y;
    out property <length> a2-y: a2.y;
    out property <length> a3-y: a3.y;
    out property <length> a3-body-h: a3.body-height;
    out property <length> a4-y: a4.y;
    out property <length> a4-body-h: a4.body-height;
    out property <length> b1-y: b1.y;
    out property <length> b1-body-h: b1.body-height;
    out property <length> b2-y: b2.y;
    out property <length> b2-body-h: b2.body-height;
    out property <length> b3-y: b3.y;
    out property <length> b3-body-h: b3.body-height;
    out property <length> c1-y: c1.y;
    out property <length> c1-body-h: c1.body-height;
    out property <length> c2-y: c2.y;
    out property <length> c2-body-h: c2.body-height;
    out property <length> c3-y: c3.y;
    out property <length> c3-body-h: c3.body-height;
    out property <length> c4-y: c4.y;
    out property <length> c4-body-h: c4.body-height;
    out property <length> d1-y: d1.y;
    out property <length> d1-body-h: d1.body-height;
    out property <length> d2-y: d2.y;
    out property <length> d2-body-h: d2.body-height;
    out property <length> sheets-y: max(max(a4.y + a4.height, b3.y + b3.height), max(c4.y + c4.height, d2.y + d2.height)) + 24px;
    out property <length> probe-y: root.height + 10px;
    out property <length> p1-w: p1.width;
    out property <length> p2-w: p2.width;
    out property <length> p3-w: p3.width;
    out property <length> p4-w: p4.width;
    out property <length> p5-w: p5.width;
    out property <length> p6-w: p6.width;
    out property <length> p7-w: p7.width;
    out property <length> p8-w: p8.width;
    out property <length> p8-h: p8v.height;
    out property <length> p8-ph: p8v.preferred-height;

    // ---- the sample models (the test may change them) ----
    in-out property <RadarModel> m-radar: {
        warning: "The scope needs the receiver's position first.",
        offers: {
            known: false, known-text: "",
            heard-label: "Use the middle of the 14 aircraft heard  (51.51N 0.13W)", heard-enabled: true,
            map-label: "Use the ADS-B map's centre  (51.47N 0.45W)", map-enabled: true,
            hint: "or type it, or click SET FROM MAP CLICK on a map page:",
            lat-text: "51.50720", lon-text: "-0.12760",
            error: "Latitude must be -90..90 and longitude -180..180",
            set-disabled: false,
            gps-shown: true, gps-hint: "or read it from a GPS receiver on a serial port:",
            gps: {
