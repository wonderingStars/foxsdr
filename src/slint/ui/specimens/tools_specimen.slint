    in-out property <AirbandModel> m-ab-plain: {
        code-draft: "", airports: [], ambiguous: [], preset-name: "", freq-draft: "", name-draft: "", import-path: "",
        modes: [{ label: "AM", id: "", enabled: true, note: "" }, { label: "NFM", id: "", enabled: true, note: "" }], mode-index: 0,
        groups: [], group-index: -1, count-line: "", busiest-first: false, hearing: "", rows: [],
        squelch-norm: 0.5, squelch-text: "-55 dB", hold-text: "4.0", listening: false,
    };
    in-out property <MarkersModel> m-markers: {
        shown: true, error: "",
        rows: [
            { number: 1, hz-text: "145.2125 MHz", note: "repeater input", dropped: "14:32:05" },
            { number: 2, hz-text: "118.7000 MHz", note: "", dropped: "14:35:41" },
            { number: 3, hz-text: "156.8000 MHz", note: "Marine 16", dropped: "14:41:10" },
        ],
