              face: { radio-switch: 2, radio-switch-label: "ON", device-label: "RTL-SDR #0", centre-text: "100.100000", centre-note: "A radio cannot tune to 0 Hz", freq-text: "",
                      mode-index: 0, squelch-on: false, squelch-norm: 0, squelch-text: "", gate-shown: false, gate-text: "", gate-word: "", gate-lit: false,
                      level-shown: false, level-norm: 0, have-picture: false, lines: [{ text: "2.400 MS/s", tone: 2 }], lines-after: [] } },
