                      lines: [{ text: "Demod", tone: 3 }, { text: "The speakers", tone: 1 }], lines-after: [{ text: "the device went away", tone: 4 }] } },
            { id: 5, kind: 3, kind-caption: "DECODER", name: "APRS", x: 20px, y: 190px, w: 200px, h: 150px, selected: false, blocked: false, fault: false, active: false,
