// The PATCH page specimen sheet (1260 x 1130): the Patch page (ui/patch_page.slint's PatchPage) in two widths, and the Patch presets page in three states, on the sample
// models below, so tests/test_slint_patch.cpp can probe the pixels against the PatchScope artboard (artboards/Workbench-PatchScope.dc.html) and press the controls with
// real pointer and key events. The sample patch is the one the contract names: Radio -> Channel -> Demod -> Speaker wired, the Radio selected, the Demod blocked, a refusal
// shown; below them a picture Decoder, a text Sink with its lines, a Display and a Map; five loose wires of the five port tones and one selected, to read the strokes.
//
//   x     y      w x h        what it shows
//   10    10     1100 x 640   (pg) PatchPage, override-recording to Rec: band (transport, run line, seven part keys, decoders, blueprints, note, information pane), the
//                             canvas with the eight nodes and the inspector (Radio) at its right                                                  m-patch m-canvas m-inspector
//   10    660    520 x 420    (pgn) PatchPage, default-forwarding to PatchEvents, at a narrow width: the part keys wrap in their FlowRow, a Radio key greyed (five radios)
//   540   660    440 x 460    (pr) PatchPresetsPage, override-recording: three presets and the previous-patch row, the four keys, the note                m-presets
//   990   660    254 x 460    (prn) PatchPresetsPage, default-forwarding, 254 px wide: the name row open and the Replace question up, long German strings m-presets-narrow
//   probes: p1 (a 254-wide layout cell below the sheet) holds the bare presets page with the longest words and reports the cell's width (rule 11)
//
// What the test reads: `Rec` counts and names every callback of the components with an override; the page's measurements are out properties; the plain
// (default-forwarding) components are watched through the PatchEvents global. The models are in-out, the test changes them.
import { Theme, Skin, Workbench } from "../theme.slint";
import { ChipTone, LampState } from "../chips.slint";
import { TipLayer } from "../tooltip.slint";
import { SelectItem } from "../signal_bank.slint";
import { SettingKind, SettingField } from "../forms.slint";
import { FaceLine, PartKey, DecoderKey, ProblemLine, InfoModel, PatchModel, PortDot, FaceModel, CanvasNode, CanvasWire, Refusal, CanvasModel, InspectorRadio, InspectorDecoder, InspectorMapSource, InspectorSink, InspectorModel, PresetRow, PatchPresetsModel, PatchEvents, PatchPage, PatchPresetsPage } from "../patch_page.slint";
export { Theme, Skin, Workbench, ChipTone, LampState, SelectItem, SettingKind, SettingField, FaceLine, PartKey, DecoderKey, ProblemLine, InfoModel, PatchModel, PortDot, FaceModel, CanvasNode, CanvasWire, Refusal, CanvasModel, InspectorRadio, InspectorDecoder, InspectorMapSource, InspectorSink, InspectorModel, PresetRow, PatchPresetsModel, PatchEvents }

// What the components with an override report: the callback's name and its arguments, joined with a space.
export global Rec {
    in-out property <int> events;
    in-out property <string> last;
    in-out property <string> last-args;
    callback fired(string, string);
    public function rec(name: string, args: string) {
        Rec.events += 1;
        Rec.last = name;
        Rec.last-args = args;
        Rec.fired(name, args);
    }
}

component SpecPatch inherits PatchPage {
    run-clicked() => { Rec.rec("run-clicked", ""); }
    all-off-clicked() => { Rec.rec("all-off-clicked", ""); }
    presets-clicked() => { Rec.rec("presets-clicked", ""); }
    part-pressed(a) => { Rec.rec("part-pressed", "" + a); }
    decoder-pressed(a) => { Rec.rec("decoder-pressed", "" + a); }
    blueprints-opened() => { Rec.rec("blueprints-opened", ""); }
    blueprint-picked(a) => { Rec.rec("blueprint-picked", "" + a); }
    canvas-size(a, b) => { Rec.rec("canvas-size", "" + a / 1px + " " + "" + b / 1px); }
    canvas-pressed(a, b, c) => { Rec.rec("canvas-pressed", "" + a / 1px + " " + "" + b / 1px + " " + "" + c); }
    canvas-moved(a, b) => { Rec.rec("canvas-moved", "" + a / 1px + " " + "" + b / 1px); }
    canvas-released(a, b, c) => { Rec.rec("canvas-released", "" + a / 1px + " " + "" + b / 1px + " " + "" + c); }
    canvas-left() => { Rec.rec("canvas-left", ""); }
    canvas-wheel(a, b, c, d, e, f) => { Rec.rec("canvas-wheel", "" + a / 1px + " " + "" + b / 1px + " " + "" + c + " " + "" + d + " " + (e ? "1" : "0") + " " + (f ? "1" : "0")); }
    zoom-step(a) => { Rec.rec("zoom-step", (a ? "1" : "0")); }
    fit() => { Rec.rec("fit", ""); }
    canvas-delete() => { Rec.rec("canvas-delete", ""); }
    face-switch(a) => { Rec.rec("face-switch", "" + a); }
    face-centre(a, b) => { Rec.rec("face-centre", "" + a + " " + b); }
    face-freq(a, b) => { Rec.rec("face-freq", "" + a + " " + b); }
    face-mode(a, b) => { Rec.rec("face-mode", "" + a + " " + "" + b); }
    face-squelch-on(a, b) => { Rec.rec("face-squelch-on", "" + a + " " + (b ? "1" : "0")); }
    face-squelch(a, b) => { Rec.rec("face-squelch", "" + a + " " + "" + b); }
    inspector-fold() => { Rec.rec("inspector-fold", ""); }
    inspector-name(a) => { Rec.rec("inspector-name", a); }
    inspector-device-opened() => { Rec.rec("inspector-device-opened", ""); }
    inspector-device(a) => { Rec.rec("inspector-device", "" + a); }
    inspector-look() => { Rec.rec("inspector-look", ""); }
    inspector-centre(a) => { Rec.rec("inspector-centre", a); }
    inspector-rate(a) => { Rec.rec("inspector-rate", "" + a); }
    inspector-freq(a) => { Rec.rec("inspector-freq", a); }
    inspector-mode(a) => { Rec.rec("inspector-mode", "" + a); }
    inspector-squelch-on(a) => { Rec.rec("inspector-squelch-on", (a ? "1" : "0")); }
    inspector-squelch(a) => { Rec.rec("inspector-squelch", "" + a); }
    inspector-plugin(a) => { Rec.rec("inspector-plugin", "" + a); }
    inspector-setting(a, b) => { Rec.rec("inspector-setting", "" + a + " " + b); }
    inspector-sink(a) => { Rec.rec("inspector-sink", "" + a); }
    inspector-size(a) => { Rec.rec("inspector-size", "" + a); }
    inspector-remove() => { Rec.rec("inspector-remove", ""); }
}

component SpecPresets inherits PatchPresetsPage {
    presets-row(a) => { Rec.rec("presets-row", "" + a); }
    presets-row-activated(a) => { Rec.rec("presets-row-activated", "" + a); }
    presets-load() => { Rec.rec("presets-load", ""); }
    presets-save-as() => { Rec.rec("presets-save-as", ""); }
    presets-rename() => { Rec.rec("presets-rename", ""); }
    presets-delete() => { Rec.rec("presets-delete", ""); }
    presets-name(a) => { Rec.rec("presets-name", a); }
    presets-go() => { Rec.rec("presets-go", ""); }
    presets-cancel() => { Rec.rec("presets-cancel", ""); }
    presets-replace(a) => { Rec.rec("presets-replace", (a ? "1" : "0")); }
    presets-delete-confirm(a) => { Rec.rec("presets-delete-confirm", (a ? "1" : "0")); }
}

export component PatchSpecimen inherits Window {
    width: 1260px;
    height: 1130px;
    background: Theme.bg;

    // ---- the geometry the test reads ----
    out property <length> band-h: pg.band-height;
    out property <length> info-w: pg.info-width;
    out property <length> left-w: pg.left-width;
    out property <length> canvas-w: pg.canvas-w;
    out property <length> canvas-h: pg.canvas-h;
    out property <length> canvas-oy: pg.canvas-oy;
    out property <length> inspector-x: pg.inspector-x;
    out property <length> inspector-w: pg.inspector-w;
    out property <length> transport-y: pg.transport-y;
    out property <length> readout-y: pg.readout-y;
    out property <length> parts-y: pg.parts-y;
