    out property <length> inspector-default-y: pg.inspector-default-y;
    out property <length> inspector-remove-y: pg.inspector-remove-y;
    out property <length> n-band-h: pgn.band-height;
    out property <length> n-info-w: pgn.info-width;
    out property <length> n-canvas-oy: pgn.canvas-oy;
    out property <length> n-canvas-w: pgn.canvas-w;
    out property <length> n-canvas-h: pgn.canvas-h;
    out property <length> n-transport-y: pgn.transport-y;
    out property <length> n-readout-y: pgn.readout-y;
    out property <length> n-parts-y: pgn.parts-y;
    out property <length> n-decoders-y: pgn.decoders-y;
    out property <length> n-decoders-x0: pgn.decoders-x0;
    out property <int> n-part-rows: pgn.part-rows;
    out property <int> n-decoder-rows: pgn.decoder-rows;
    out property <length> pr-list-y: pr.list-y;
    out property <length> pr-list-h: pr.list-h;
    out property <length> pr-keys-y: pr.keys-y;
    out property <length> pr-name-y: pr.name-y;
    out property <length> pr-note-y: pr.note-y;
    out property <length> prn-list-y: prn.list-y;
    out property <length> prn-list-h: prn.list-h;
    out property <length> prn-keys-y: prn.keys-y;
    out property <length> prn-name-y: prn.name-y;
    out property <length> prn-note-y: prn.note-y;
    out property <length> prn-modal-x: prn.modal-x;
    out property <length> prn-modal-y: prn.modal-y;
    out property <length> prn-modal-w: prn.modal-w;
    out property <length> prn-modal-h: prn.modal-h;
    out property <length> prn-modal-keys-y: prn.modal-keys-y;
    out property <length> prn-modal-yes-x: prn.modal-yes-x;
    out property <length> prn-modal-no-x: prn.modal-no-x;
    out property <length> probe-y: root.height + 10px;
    out property <length> p1-w: p1.width;

    public function focus-presets-name() { pr.focus-name(); }

    // ---- the sample models (the test may change them) ----
    in-out property <PatchModel> m-patch: {
        running: true, run-label: "STOP",
        run-tooltip: "Stop the patch: every patch radio closes, recordings are\nfinished, and the receiver gets its radio back.",
        run-line: "RUNNING - 1 of 1 radio open", run-line-lit: true, presets-open: false, tab-chip: "RUNNING", tab-chip-tone: ChipTone.good,
        parts: [
            { label: "Radio", kind: 0, enabled: true, tooltip: "" },
            { label: "Channel", kind: 1, enabled: true, tooltip: "" },
            { label: "Demod", kind: 2, enabled: true, tooltip: "" },
            { label: "Spectrum", kind: 3, enabled: true, tooltip: "" },
