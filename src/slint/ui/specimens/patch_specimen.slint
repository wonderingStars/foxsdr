            { label: "Map", kind: 6, enabled: true, tooltip: "" },
        ],
        decoders: [
            { label: "ADS-B", index: 0, tooltip: "ADS-B\nI/Q input, needs a fixed rate\nWire it from a channel (or the radio itself)." },
            { label: "AIS", index: 1, tooltip: "AIS\nI/Q input, any rate\nWire it from a channel (or the radio itself)." },
            { label: "APRS", index: 2, tooltip: "APRS\nAudio input, any rate\nWire it from a demodulator." },
