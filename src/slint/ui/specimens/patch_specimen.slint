                      mode-index: 0, squelch-on: false, squelch-norm: 0, squelch-text: "", gate-shown: false, gate-text: "", gate-word: "", gate-lit: false,
                      level-shown: false, level-norm: 0, have-picture: false,
                      lines: [{ text: "APRS: first decoded line", tone: 0 }, { text: "APRS: second decoded line", tone: 0 }, { text: "APRS: newest decoded line", tone: 0 }], lines-after: [] } },
            { id: 7, kind: 4, kind-caption: "DISPLAY", name: "Spectrum", x: 540px, y: 190px, w: 160px, h: 100px, selected: false, blocked: false, fault: false, active: false,
              hot-close: false, hot-grip: false, inputs: [{ x: 540px, y: 240px, tone: 0 }], outputs: [], reading: "", reading-tone: 0, reading2: "",
              face: { radio-switch: 0, radio-switch-label: "", device-label: "", centre-text: "", centre-note: "", freq-text: "",
                      mode-index: 0, squelch-on: false, squelch-norm: 0, squelch-text: "", gate-shown: false, gate-text: "", gate-word: "", gate-lit: false,
                      level-shown: false, level-norm: 0, have-picture: false, lines: [{ text: "No spectrum yet - its radio is not running.", tone: 1 }], lines-after: [] } },
            { id: 8, kind: 6, kind-caption: "MAP", name: "Map", x: 730px, y: 190px, w: 140px, h: 100px, selected: false, blocked: false, fault: true, active: false,
              hot-close: false, hot-grip: false, inputs: [{ x: 730px, y: 240px, tone: 4 }], outputs: [], reading: "", reading-tone: 0, reading2: "",
              face: { radio-switch: 0, radio-switch-label: "", device-label: "", centre-text: "", centre-note: "", freq-text: "",
                      mode-index: 0, squelch-on: false, squelch-norm: 0, squelch-text: "", gate-shown: false, gate-text: "", gate-word: "", gate-lit: false,
                      level-shown: false, level-norm: 0, have-picture: false, lines: [{ text: "no targets yet", tone: 2 }], lines-after: [] } },
        ],
    };
    in-out property <InspectorModel> m-inspector: {
        shown: true, folded: false, node: 1, kind: 0, kind-caption: "RADIO", name: "Radio",
        radio: {
            device-items: [
                { label: "RTL-SDR #0 (R820T)", id: "rtl:0", enabled: true, note: "" },
                { label: "SDRplay RSPduo  (used by Radio 2)", id: "sdrplay:1", enabled: false, note: "" },
                { label: "Signal generator", id: "siggen", enabled: true, note: "" },
            ],
            device-index: 0, device-label: "RTL-SDR #0 (R820T)", looking: false, look-enabled: true, centre-text: "100.100000", centre-note: "A radio cannot tune to 0 Hz",
            rate-items: [
                { label: "1.000 MS/s", id: "", enabled: true, note: "" }, { label: "2.000 MS/s", id: "", enabled: true, note: "" },
                { label: "2.400 MS/s", id: "", enabled: true, note: "" }, { label: "3.000 MS/s", id: "", enabled: true, note: "" },
            ],
            rate-index: 2, rate-label: "2.400 MS/s", rate-fixed: false, rate-fixed-text: "",
            lines: [{ text: "running 2.400 MS/s", tone: 2 }, { text: "at 100.100000 MHz", tone: 2 }, { text: "Up to 5 radios, each its own device.", tone: 1 }],
        },
        freq-text: "100.100000", mode-index: 1, squelch-on: true, squelch-norm: 0.5, squelch-text: "-60 dB", gate-shown: true, gate-text: "-48 dB", gate-word: "open", gate-lit: true,
        decoder: {
            plugin-items: [{ label: "ADS-B", id: "0", enabled: true, note: "adsb.dll" }, { label: "AIS", id: "1", enabled: true, note: "ais.dll" }], plugin-index: 0, plugin-label: "ADS-B",
            feed-note: "I/Q - wire it from a channel, or from the radio for the whole band input.", fed: ["fed 2400000 Hz", "centred on 1090.000000 MHz"],
            shown-note: "Wire its output to a Text out part to read what it decodes in the Decoder output window.",
            settings: [{ id: 7, key: "gain", label: "Gain", kind: SettingKind.number, value: "12", checked: false, placeholder: "", max-length: 8, error: "", pending: false }], has-settings: true,
        },
        map-wired: "2 of 5 inputs wired", map-sources: [{ count: "12", name: "ADS-B" }, { count: "3", name: "AIS" }],
        map-help: "Wire the map output of up to 5 decoders here - aircraft from one radio, ships from another - and they share this map.",
        sink: {
            items: [{ label: "A WAV file", id: "wav", enabled: true, note: "" }, { label: "An MP3 file (needs Windows)", id: "mp3", enabled: false, note: "" }, { label: "The speakers", id: "speakers", enabled: true, note: "" }],
            index: 2, label: "The speakers", lines: [{ text: "Speakers (Realtek)", tone: 2 }, { text: "1.2 s", tone: 2 }], files-note: "Files go in C:\\Recordings, one per speaker, named after it.",
        },
        audio-sink: true, help: "This node has nothing to set yet.",
    };

    // the narrow page: the Radio key greyed (five radios), a long run line
    in-out property <PatchModel> m-narrow: {
        running: false, run-label: "START", run-tooltip: "Start the patch: every radio switched on opens.", run-line: "STOPPED - 0 of 5 radios switched on", run-line-lit: false,
        presets-open: true, tab-chip: "5 NODES", tab-chip-tone: ChipTone.neutral,
        parts: [
            { label: "Radio", kind: 0, enabled: false, tooltip: "A patch has at most 5 radios." },
            { label: "Channel", kind: 1, enabled: true, tooltip: "" },
            { label: "Demod", kind: 2, enabled: true, tooltip: "" },
            { label: "Spectrum", kind: 3, enabled: true, tooltip: "" },
            { label: "Speaker", kind: 4, enabled: true, tooltip: "" },
            { label: "Text out", kind: 5, enabled: true, tooltip: "" },
            { label: "Map", kind: 6, enabled: true, tooltip: "" },
        ],
        decoders: [
            { label: "ADS-B", index: 0, tooltip: "ADS-B\nI/Q input, needs a fixed rate\nWire it from a channel (or the radio itself)." },
            { label: "AIS", index: 1, tooltip: "AIS" }, { label: "APRS", index: 2, tooltip: "APRS" }, { label: "ACARS", index: 3, tooltip: "ACARS" },
            { label: "POCSAG", index: 4, tooltip: "POCSAG" }, { label: "WEFAX (picture)", index: 5, tooltip: "WEFAX" }, { label: "RTTY (I/Q)", index: 6, tooltip: "RTTY" },
            { label: "RTTY (audio)", index: 7, tooltip: "RTTY" },
        ],
        no-decoders: "", blueprints-shown: true, blueprints: [{ label: "ADS-B Aircraft Decoder", id: "0", enabled: true, note: "1090.0000 MHz" }],
        blueprint-note: "Placed \"ADS-B\". It has no preset frequency - type one in before pressing START.",
        info: {
            runnable: false, verdict: "This patch cannot run yet.", level-line: "", plan-line: "", none-selected: true,
            help: ["Nothing selected.", "Click a node to set what it does. Drag from one port to another to wire them; drag a node by its title bar to move it. Delete removes whatever is selected.",
                   "Drag empty canvas or scroll to move round the patch. Ctrl+scroll or the + and - keys zoom; Fit shows every node."],
            selection: "", folded-note: "", problems: [],
        },
        inspector-shown: false, inspector-folded: false,
    };
    in-out property <CanvasModel> m-canvas-narrow: {
        zoom: 1.0, faces-live: true, grid-step: 0px, grid-ox: 0px, grid-oy: 0px, keys-shown: true, ghost: "", refusal: { shown: false, text: "", x: 0px, y: 0px }, wires: [], nodes: [],
    };
    in-out property <InspectorModel> m-inspector-narrow: { shown: false, folded: false, node: 0, kind: 0, kind-caption: "", name: "", audio-sink: false, help: "" };

    in-out property <PatchPresetsModel> m-presets: {
        rows: [
            { text: "(previous patch)", previous: true, selected: false },
            { text: "Airband watch", previous: false, selected: false },
            { text: "ADS-B plus map", previous: false, selected: true },
            { text: "Marine VHF", previous: false, selected: false },
        ],
        empty-shown: false, load-enabled: true, rename-enabled: true, delete-enabled: false, edit: 0, name-draft: "", note: "Saved \"ADS-B plus map\".", note-good: true,
        ask-replace: false, replace-text: "A preset called \"ADS-B plus map\" already exists.\nReplace it with the patch on the canvas?", ask-delete: false,
        delete-text: "Delete the preset \"ADS-B plus map\"? This cannot be undone.",
    };
    in-out property <PatchPresetsModel> m-presets-narrow: {
        rows: [
            { text: "(vorheriger Patch)", previous: true, selected: false },
            { text: "Flugfunk-Ueberwachung mit allen Dekodern und der Karte", previous: false, selected: true },
        ],
        empty-shown: false, load-enabled: true, rename-enabled: true, delete-enabled: true, edit: 1, name-draft: "Flugfunk-Ueberwachung", note: "Ein anderes Preset traegt bereits diesen Namen.", note-good: false,
        ask-replace: true, replace-text: "Ein Preset namens \"Flugfunk-Ueberwachung\" ist bereits vorhanden.\nSoll es durch den Patch auf der Arbeitsflaeche ersetzt werden?", ask-delete: false,
        delete-text: "",
    };
    in-out property <PatchPresetsModel> m-presets-long: {
        rows: [{ text: "Flugfunk-Ueberwachung mit allen Dekodern und der Karte", previous: false, selected: true }],
        empty-shown: false, load-enabled: true, rename-enabled: true, delete-enabled: true, edit: 2, name-draft: "Flugfunk-Ueberwachung", note: "Dieses Preset kann nicht gespeichert werden, weil der Patch zu gross ist (ueber 256 KB).", note-good: false,
        ask-replace: false, replace-text: "", ask-delete: false, delete-text: "",
    };

    // ---- the sheet ----
    pg := SpecPatch { x: 10px; y: 10px; width: 1100px; height: 640px; model: root.m-patch; canvas: root.m-canvas; inspector: root.m-inspector; }
    pgn := PatchPage { x: 10px; y: 660px; width: 520px; height: 420px; model: root.m-narrow; canvas: root.m-canvas-narrow; inspector: root.m-inspector-narrow; }
    pr := SpecPresets { x: 540px; y: 660px; width: 440px; height: 460px; model: root.m-presets; }
    prn := PatchPresetsPage { x: 990px; y: 660px; width: 254px; height: 460px; model: root.m-presets-narrow; }

    // the rule-11 probe: the bare presets page in a 254 px cell asks for no more than 254 px
    HorizontalLayout { x: 10px; y: root.probe-y; width: 254px; height: 20px; p1 := Rectangle { PatchPresetsPage { model: root.m-presets-long; } } }

    TipLayer { x: 0px; y: 0px; win-w: root.width; win-h: root.height; }
}
