            { label: "RTTY (I/Q)", index: 4, tooltip: "RTTY\nI/Q input, any rate\nWire it from a channel (or the radio itself)." },
            { label: "RTTY (audio)", index: 5, tooltip: "RTTY\nAudio input, any rate\nWire it from a demodulator." },
        ],
        no-decoders: "", blueprints-shown: true,
        blueprints: [
            { label: "ADS-B Aircraft Decoder", id: "0", enabled: true, note: "1090.0000 MHz" },
            { label: "Listen to the tower: Heathrow", id: "1", enabled: true, note: "TWR 118.500\nTWR 118.700" },
            { label: "APRS (picture)", id: "2", enabled: true, note: "144.8000 MHz" },
