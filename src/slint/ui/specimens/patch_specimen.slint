              face: { radio-switch: 0, radio-switch-label: "", device-label: "", centre-text: "", centre-note: "", freq-text: "100.100000",
                      mode-index: 0, squelch-on: false, squelch-norm: 0, squelch-text: "", gate-shown: false, gate-text: "", gate-word: "", gate-lit: false,
                      level-shown: false, level-norm: 0, have-picture: false, lines: [], lines-after: [] } },
