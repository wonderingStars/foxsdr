        blueprint-note: "Placed \"ADS-B Aircraft Decoder\". Press START to run it.",
        info: {
            runnable: true, verdict: "This patch can run.", level-line: "-61.4 dB on this channel", plan-line: "1 channel(s), decimate by 8",
            none-selected: false, help: [], selection: "RADIO  Radio", folded-note: "",
            problems: [{ text: "no frequency set", advisory: false }, { text: "nothing is listening to this", advisory: true }],
        },
        inspector-shown: true, inspector-folded: false,
    };
    in-out property <CanvasModel> m-canvas: {
        zoom: 1.0, faces-live: true, grid-step: 26px, grid-ox: 6px, grid-oy: 14px, keys-shown: true, ghost: "",
        refusal: { shown: true, text: "those two carry different things", x: 340px, y: 380px },
        wires: [
