import { Chip, LampDot, ChipTone, LampState } from "chips.slint";
import { TipTimer, TipLayer, ElidedHint } from "tooltip.slint";
import { Caption, Key, KeyNames, KeyFocus, SegGroup, SegKey, RailKey, StopKey } from "keys.slint";
import { Lamp, StatusChip, VLine } from "lamps.slint";
import { FrequencyCounter } from "digits.slint";
import { Slider, LevelBar, SliderGroup } from "sliders.slint";
import { Section, BodyRow, SelectKey } from "sections.slint";
import { Tab, TornWindow, Splitter } from "tabs.slint";
import { KitEvents, DecodeRow, PluginEntry, DecoderBar, PageTab, MapModel, FittedModel, ModuleModel, DetailsModel, PageBody, DecodeBank,
         PresetKeyModel, SettingKind, SettingField, StaleGrant, StateChipModel, LineTone, LogLine, DetailLine, FittedRowModel, ReachRowModel,
         InstrumentState, MapTarget, LegendRow, RowKind, RowTone, TableRow } from "pages.slint";
import { MenuItemKind, MenuEntry, Menu } from "menus.slint";
import { SignalEvents, SelectItem, GainStage, OptionRow, SourceModel, RadioExtrasModel, AudioFiltersModel, SinksModel, TransmitModel, RecorderModel,
         RadioSetupModel, UnboundRow, SetupKey, ImportDialogModel, SourceBody, FrequencyCorrectionBody, RadioExtras, AudioFiltersBody, SinksBody,
         RecorderBody, RadioSetupSheet, ImportDialog } from "signal_bank.slint";
import { SystemEvents, DisplayModel, LanguageModel, UpdatesModel, GpsRow, SerialPortsModel, KeyRow, KeyGroup, KeyBindingsModel, DiagnosticsModel,
         UsageModel, TesterModel, ReportPageModel, DisplayBody, LanguageBody, UpdatesBody, SerialPortsBody, KeyBindingsBody, DiagnosticsBody,
         UsageBody, TesterBody, ReportSheet } from "system_bank.slint";
import { ToolsEvents, PositionOffers, RadarModel, BookmarkRow, BookmarksModel, ScannerModel, AirbandRow, AirportRow, AirbandModel, MarkerRow,
         MarkersModel, RadarBody, BookmarksBody, ScannerBody, AirbandBody, MarkersSheet } from "tools_bank.slint";
import { ExtendEvents, WebModel, CatModel, StoreBadge, StoreCard, StoreCategory, StoreSite, UpdateRow, StorePluginPage, StoreModel,
         WebBody, CatBody } from "extend_bank.slint";
import { Checkbox } from "fields.slint";
import { Card, Banner, CardTone } from "cards.slint";
import { AxisTick, DbTick, BandSegment, BookmarkMark, PluginMark, UserMarker, TraceMode, SpectrumView } from "spectrum.slint";
import { AgeTick, WaterfallView } from "waterfall.slint";
import { View3D, Scene3DLabel, SurveyRankRow, SondeLegendRow, Scene3DViewToggle, Wf3DView } from "scene3d_views.slint";
import { CommandField, CommandPalette, PaletteResult } from "palette.slint";
import { ScopeEvents, DemodModel, MpxMarkItem, DemodScopeWindow, RadarTargetItem, RadarLabelItem, RadarLineItem, RadarContactItem, RadarOptionItem, RadarScopeModel, RadarScopeView } from "scope_modes.slint";
import { FaceLine, PartKey, DecoderKey, ProblemLine, InfoModel, PatchModel, PortDot, FaceModel, CanvasNode, CanvasWire, Refusal, CanvasModel, InspectorRadio,
         InspectorDecoder, InspectorMapSource, InspectorSink, InspectorModel, PresetRow, PatchPresetsModel, PatchEvents, PatchPage } from "patch_page.slint";
import { TxChoice, TransmitPageModel, TransmitEvents } from "transmit_page.slint";   // the Transmit page (kit page kind 11; docs 6.58): its model and gestures reach C++ through main.h
import { AboutSlint } from "std-widgets.slint";

export { Theme, Skin, Workbench, NightWatch, DigitFace, MeterStyle, ChipTone, LampState, MenuItemKind, MenuEntry, CardTone,
         AxisTick, DbTick, BandSegment, BookmarkMark, PluginMark, UserMarker, TraceMode, AgeTick, PaletteResult,
         KitEvents, DecodeRow, PluginEntry, DecoderBar, PageTab, MapModel, FittedModel, ModuleModel, DetailsModel,
         PresetKeyModel, SettingKind, SettingField, StaleGrant, StateChipModel, LineTone, LogLine, DetailLine, FittedRowModel, ReachRowModel,
         InstrumentState, MapTarget, LegendRow, RowKind, RowTone, TableRow,
         SignalEvents, SelectItem, GainStage, OptionRow, SourceModel, RadioExtrasModel, AudioFiltersModel, SinksModel, TransmitModel, RecorderModel,
         RadioSetupModel, UnboundRow, SetupKey, ImportDialogModel,
         SystemEvents, DisplayModel, LanguageModel, UpdatesModel, GpsRow, SerialPortsModel, KeyRow, KeyGroup, KeyBindingsModel, DiagnosticsModel,
         UsageModel, TesterModel, ReportPageModel,
         ToolsEvents, PositionOffers, RadarModel, BookmarkRow, BookmarksModel, ScannerModel, AirbandRow, AirportRow, AirbandModel, MarkerRow, MarkersModel,
         ExtendEvents, WebModel, CatModel, StoreBadge, StoreCard, StoreCategory, StoreSite, UpdateRow, StorePluginPage, StoreModel,
         FaceLine, PartKey, DecoderKey, ProblemLine, InfoModel, PatchModel, PortDot, FaceModel, CanvasNode, CanvasWire, Refusal, CanvasModel, InspectorRadio,
         InspectorDecoder, InspectorMapSource, InspectorSink, InspectorModel, PresetRow, PatchPresetsModel, PatchEvents,
         ScopeEvents, DemodModel, MpxMarkItem, RadarTargetItem, RadarLabelItem, RadarLineItem, RadarContactItem, RadarOptionItem, RadarScopeModel }
export { TxChoice, TransmitPageModel, TransmitEvents }
export { View3D, Scene3DLabel, SurveyRankRow, SondeLegendRow }   // the 3D views' state and their labels (docs 6.64): the host's view3d_publish sets the global and answers its callbacks
import { GlobeEvents, GlobeModel, GlobeControl, GlobeChipModel } from "globe_views.slint";
import { WorkspaceModel, WorkspaceCell, WorkspaceBar, RadioWorkspace } from "workspace.slint";
import { RadioPaneData } from "radio_pane.slint";
export { WorkspaceModel, WorkspaceCell, RadioPaneData }   // the radio workspace (docs/multi-radio-records/screen-s3.md): the host publishes its model and answers its callbacks
export { GlobeEvents, GlobeModel, GlobeControl, GlobeChipModel }

export struct SectionRow { name: string, chip: string, tone: ChipTone, open: bool, dot: LampState, show-dot: bool }
export struct StatusCard { key: string, value: string, detail: string, tone: ChipTone, lamp: LampState, show-lamp: bool, lines: [string] }

// A centred sheet on a dimmed backdrop: the IA's dialog form. Used here for the bias-tee question and the
// About dialog; the companion dialogs (phase 3) reuse it.
component Sheet inherits Rectangle {
    in property <string> title;
    in property <length> sheet-w: 460px;
    callback dismissed;
    background: Theme.backdrop;
    TouchArea { clicked => { root.dismissed(); } }
    panel := Rectangle {
        width: root.sheet-w;
        height: body.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        border-width: Theme.hairline;
        border-color: Theme.knob-ring;
        border-radius: Theme.radius-panel;
        drop-shadow-blur: Theme.shadows ? 28px : 0px;
        drop-shadow-offset-y: Theme.shadows ? 10px : 0px;
        drop-shadow-color: Theme.shadows ? Theme.well-deep.with-alpha(0.7) : transparent;
        TouchArea { }   // swallows the click so the backdrop does not dismiss
        body := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text { text: root.title; font-size: 13px; font-weight: Theme.weight-semibold; color: Theme.fg; font-family: Theme.font-ui; }
            @children
        }
    }
}

export component MainWindow inherits Window {
    title: "FoxSDR";   // not-translated: the product name
    no-frame: true;
    // THE WINDOW'S SIZE. The desktop backend sized the window from the layout and opened it at its 400 px minimum
    // whatever preferred-height said (docs 6.36); an explicit size opens as asked, so the size is a pair of properties:
    // the host mirrors the real window size into them every tick (so maximise, restore and the drag-resize edges
    // re-lay the screen) and the render tests set them per frame. 1600 x 900 opens: the sheet is 1440 wide, but its
    // strip does not fit 1440 by its own numbers. The inventory minimum of 624 x 400 is held on the drag-resize edges.
    in-out property <length> win-w: 1600px;
    in-out property <length> win-h: 900px;
    width: win-w;
    height: win-h;


    background: Theme.bg;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.font-body;
    forward-focus: keys;                         // the shortcuts' FocusScope holds the focus unless a field takes it

    // ===================== what the host publishes =====================
    in property <string> version: "0.99.100";
    in property <bool> maximised;
    in property <int> notifications;                 // bell badge count
    in property <string> notifications-tooltip: @tr("Notifications");
    // receiver strip
    in property <bool> running;
    in property <bool> decoding;
    in property <bool> muted;
    in property <bool> failed;
    in property <string> tuned-text: "145.500000 MHz";   // not-translated: sample data the host replaces
    in property <[int]> digits: [0, 1, 4, 5, 5, 0, 0, 0, 0, 0];
    in property <int> leading-zeros: 1;
    in property <bool> show-nudges: true;
    in-out property <bool> editing;                  // the typed frequency editor is open
    in-out property <string> editor-text;
    in property <string> converter-text;             // "" = the static engraving
    in property <bool> converter-warn;
    in property <string> tune-hint: @tr("Scroll a digit to tune · click to type (T) · no converter");
    in property <[string]> modes: ["NFM", "WFM", "AM", "DSB", "USB", "CW", "LSB", "RAW"];   // not-translated: mode names are radio vocabulary
    in property <int> mode-index: 0;
    in property <string> mode-hint: "Passband 12.5 kHz · step 12.5 kHz · more in Signal › Radio";   // not-translated: sample data the host replaces
    in property <float> gain-norm; in property <string> gain-text: "N/A"; in property <bool> gain-auto; in property <bool> gain-enabled; in property <bool> gain-auto-enabled;
    in property <string> gain-hint: @tr("no gain stage"); in property <string> gain-tooltip; in property <string> gain-auto-tooltip;
    in property <float> squelch-norm; in property <string> squelch-text: @tr("open"); in property <bool> squelch-auto: true; in property <string> squelch-hint; in property <string> squelch-auto-tooltip;
    in property <float> volume-norm; in property <string> volume-text: "0.00";
    in property <float> level-norm; in property <string> level-text: "--";
    in property <bool> bias-tee-present; in property <bool> bias-tee-on; in property <string> bias-hint: @tr("No bias tee on this radio");
    in property <string> bias-tooltip: @tr("Sends about 4.5 V up the antenna cable to power an amplifier at the mast. Leave it off unless you have one: equipment that is not expecting power on the connector can be damaged by it.");
    in-out property <bool> bias-question-open;      // "Turn on the bias tee?" sheet
    in property <string> bias-question-text;
    in property <string> muted-by;                   // "" = no banner
    // rail + sections panel
    in-out property <int> bank-index: 0;             // SIGNAL DECODE TOOLS EXTEND SYSTEM
    in-out property <bool> rail-folded;
    in property <[string]> bank-titles: [@tr("SIGNAL PATH"), @tr("DECODE"), @tr("TOOLS"), @tr("EXTEND"), @tr("SYSTEM")];
    in property <string> bank-chip: @tr("RECEIVING");
    in property <ChipTone> bank-chip-tone: ChipTone.good;
    in property <[SectionRow]> sections: [];
    in property <float> passband-norm; in property <string> passband-text: "12.5 kHz";   // not-translated: sample data (a value with its unit) the host replaces
    in property <string> tune-step-text: "12.5 kHz";   // not-translated: sample data (a value with its unit) the host replaces
    in-out property <bool> follow-band-plan: true;
    in property <bool> team-message-shown; in property <string> team-message-date; in property <[string]> team-message-lines; in property <bool> team-message-important;
    in property <bool> update-shown; in property <string> update-headline; in property <bool> update-critical; in property <[string]> update-notes;
    in property <bool> update-withdrawn;     // docs 6.63: the running version was withdrawn (the kill switch): the card is amber and says so
    in property <string> update-primary: @tr("Download update"); in property <float> update-progress: -1; in property <string> update-note; in property <string> update-error;
    in property <string> source-line: @tr("Signal generator");
    in property <string> rate-line: "2.000 MS/s · ch 200.0 kHz · underruns 0";   // not-translated: sample data (a rate with its units) the host replaces
    in property <string> converter-line;             // "" = none (the rail footer's warning line)
    // centre
    in-out property <int> view-index: 0;             // RECEIVER PATCH SCOPE
    // the radar scope takes the keyboard back from whatever field held it, so Esc (the shortcut table's) leaves it (docs 6.57; aw.cpp 13589 leaves it only when nothing is being edited)
    changed view-index => { if (self.view-index == 2) { keys.focus(); } }
    // THE PATCH PAGE (phase 3, docs 6.44): the band, the canvas and the inspector of view 1, filled by the host (patch_publish.cpp)
    in property <PatchModel> patch-model;
    in property <CanvasModel> canvas-model;
    in property <InspectorModel> inspector-model;
    // the plugin kit (pages.slint): the docked and torn-off pages, the DECODE bank's rows and drawers, the "Sound is muted" question
    in property <[PageTab]> pages: [];
    // THE SIGNAL BANK (phase 3, docs 6.39): the bodies under the rows of bank 0, filled by the host (signal_publish.cpp)
    in property <SourceModel> source-model;
    in property <RadioExtrasModel> radio-extras;
    in property <AudioFiltersModel> filters-model;
    in property <SinksModel> sinks-model;
    in property <TransmitModel> transmit-model;
    in property <RecorderModel> recorder-model;
    in property <RadioSetupModel> radio-setup;
    in property <ImportDialogModel> import-dialog;
    // THE SYSTEM BANK (phase 3, docs 6.40): the bodies under the rows of bank 4, filled by the host (system_publish.cpp)
    in property <DisplayModel> display-model;
    in property <LanguageModel> language-model;
    in property <UpdatesModel> updates-model;
    in property <SerialPortsModel> serial-model;
    in property <KeyBindingsModel> keys-model;
    in property <DiagnosticsModel> diag-model;
    in property <UsageModel> usage-model;
    in property <TesterModel> tester-model;
    in property <ReportPageModel> report-page;
    // THE TOOLS BANK (phase 3, docs 6.41): the bodies under the rows of bank 2, filled by the host (tools_publish.cpp)
    in property <RadarModel> radar-model;
    in property <BookmarksModel> bookmarks-model;
    in property <ScannerModel> scanner-model;
    in property <AirbandModel> airband-model;
    in property <MarkersModel> markers-model;
    in property <RadarScopeModel> radar-scope-model;   // the radar scope (scope_modes.slint) in the SCOPE tab
    in property <DemodModel> demod-model;            // the DEMOD SCOPE window (scope_modes.slint): shown while the TOOLS row has it open
    // THE EXTEND BANK (phase 3, docs 6.42): the two bodies under the rows of bank 3; the store is a kit page (pages.slint kind 9)
    in property <WebModel> web-model;
    in property <CatModel> cat-model;
    in property <[DecodeRow]> decode-rows: [];
    in property <[PluginEntry]> plugin-entries: [];
    in property <string> decode-note;
    in property <string> output-key-label;
    in property <string> lines-text;
    in property <string> tail-note;
    in property <string> cost-note;
    in property <string> stop-all-label;
    in property <string> empty-entries-text;
    in property <string> refusal;
    in property <[StaleGrant]> stale: [];
    in property <DetailsModel> details;
    in property <string> catalogue-url;
    in-out property <bool> mute-question-open;
    in property <string> mute-question-text;
    in property <string> mute-stop-label;
    in property <int> trace-mode: 1;                 // 0 normal 1 peak hold 2 average
    in property <bool> range-manual;
    in property <int> marker-count;
    in property <bool> band-plan-on: true;
    in property <string> spectrum-caption: @tr("Spectrum");
    in property <string> spectrum-caveat: @tr("average of the last frames, not the audio");
    in property <string> peak-text; in property <string> peak-age; in property <bool> show-peak;
    in property <string> span-text: "SPAN 2.000 MHz";   // not-translated: sample data (a span with its unit) the host replaces
    in property <image> trace-image;
    in property <[DbTick]> db-ticks: [];
    in property <[AxisTick]> freq-ticks: [];
    in property <string> axis-unit: "MHz";   // not-translated: a frequency unit
    in property <float> vfo-pos: 0.5; in property <float> vfo-half: 0.01; in property <bool> show-vfo: true;
    in property <[BandSegment]> ribbon: [];
    in property <int> ribbon-size: 1;
    in property <[BookmarkMark]> bookmarks: [];
    in property <[PluginMark]> marks: [];
    in property <[PluginMark]> wf-marks: [];         // the marks not flagged spectrum-only
    in property <[UserMarker]> markers: [];
    in property <string> cursor-text; in property <bool> cursor-visible; in property <float> cursor-pos;
    in property <string> band-tooltip: @tr("Drag to move the tuned band · drag an edge to change the passband · Shift = free tuning");
    in property <string> edge-tooltip: @tr("Drag to change the passband");
    in property <string> off-band-tooltip: @tr("Click to tune here · double-click for the full span · wheel to zoom · Shift+wheel to slide the band · right-click for the trace menu");
    in-out property <float> split-ratio: 0.6;        // spectrum share of the centre height (0.1 .. 0.9)
    in property <image> waterfall-image;
    in property <[AgeTick]> age-ticks: [];
    in property <string> waterfall-foot-left;
    in property <string> waterfall-foot-tuned;
    in property <string> waterfall-foot-rest;
    in property <[string]> key-labels: ["-110", "-80", "-50", "-20", "0"];
    in property <string> key-foot: "FLOOR -110 dB · CEILING 0 dB · auto";   // not-translated: sample data the host replaces
    in property <string> key-coverage;
    in property <bool> show-strength-key: true;
    in property <float> wf-rail-pos: -1;
    in property <string> marker-tooltip;
    in property <string> waterfall-tooltip: @tr("Click to tune here · drag to pan · wheel to zoom · right-click for the marker menu");
    // status bar
    in property <[StatusCard]> status: [];
    // menus + palette + about
    in property <[MenuEntry]> menu-entries: [];      // the host fills these, then calls open-menu
    in property <[PaletteResult]> palette-results: [];
    in-out property <string> palette-query;
    in property <bool> preview: true;                // shipped as a labelled PREVIEW beside the ImGui window (the title-bar chip)
    in-out property <bool> about-open;               // About FoxSDR, from the brand menu: holds the AboutSlint widget the Royalty-free licence requires
    in property <string> about-text;

    // ===================== what the operator does =====================
    callback stop-clicked;
    callback nudge(int, int);                        // digit 0..9, +1 / -1 (and the wheel)
    callback edit-requested;
    callback typed(string);
    callback edit-cancelled;
    callback counter-menu-requested(length, length);
    callback mode-selected(int);
    callback mode-picker-requested(length, length);   // the compact strip's mode picker: the host opens the eight modes as a menu
    callback gain-changed(float);
    callback gain-auto-clicked;
    callback squelch-changed(float);
    callback squelch-auto-clicked;
    callback volume-changed(float);
    callback bias-tee-clicked;                       // on -> off at once; off -> on opens the question
    callback bias-tee-confirmed;
    callback stop-muting-plugin;
    callback bank-selected(int);
    callback section-clicked(int);
    callback passband-changed(float);
    callback tune-step-clicked(length, length);
    callback follow-band-plan-toggled(bool);
    callback team-message-seen;
    callback update-primary-clicked;
    callback update-dismissed;
    callback view-selected(int);
    callback add-window-clicked;                     // the "+ Window" tab: the host opens the Decoder output page
    callback trace-mode-selected(int);
    callback range-manual-selected(bool);
    callback markers-clicked;
    callback band-plan-toggled;
    callback zoom(int);                              // -1 out, +1 in, 0 full span
    callback spectrum-hover(float, float);
    callback spectrum-clicked(float, bool);
    callback spectrum-double-clicked(float);
    callback spectrum-menu-requested(float, length, length);
    callback band-dragged(float);
    callback edge-dragged(float);
    callback spectrum-wheel(float, int, bool);
    callback waterfall-hover(float, float);
    callback waterfall-clicked(float, bool);
    callback waterfall-panned(float);
    callback waterfall-double-clicked;
    callback waterfall-menu-requested(float, length, length);
    callback waterfall-wheel(float, int, bool);
    callback marker-hovered(int);
    callback status-clicked(int);
    callback feature-request-clicked;
    callback bug-report-clicked;
    callback menu-activated(int);
    callback menu-slider-changed(int, float);
    callback palette-query-changed(string);
    callback palette-activated(int);
    callback shortcut(string);                       // the key table's config id: startStop, mute, volumeUp, ...
    callback title-drag(length, length);
    callback title-double-clicked;
    callback system-menu-requested(length, length);
    callback minimise-clicked;
    callback maximise-clicked;
    callback close-clicked;
    callback brand-clicked;                          // the app menu: About FoxSDR, Key bindings, Quit
    callback resize-drag(int, length, length);       // edge code (1 right, 2 bottom, 3 corner), dx, dy

    // the strip's blocks need about 1750 px at the sheet's sizes (counter 386, eight mode keys 434, three lanes of 120):
    // below that the mode segment folds into one picker key, as the deck scales down in the ImGui window
    out property <bool> compact-strip: root.width < 1760px;

    // the one menu (counter, trace, marker, meter): the host sets menu-entries and opens it here
    public function open-menu(x: length, y: length) { menu.at-x = x; menu.at-y = y; menu.show(); }
    public function open-palette() { palette.show(); }

    // ===================== keyboard: the SAVED bindings, answered by the host (docs 6.56) =====================
    // The window knows no chord. A key press is named (KeyNames, the names the Key bindings capture stores) and put to the host, which looks it up in the
    // key table the user has saved (src/slint/key_dispatch.hpp) and answers the config id of the action - "" when nothing holds the chord, and the press
    // is then rejected, so a field or a parent may have it. "palette" (Ctrl+K) is the one answer that is this window's own.
    callback key-answer(string, bool, bool, bool, bool) -> string;   // key name, Ctrl, Shift, Alt, the glyph was typed with Shift
    property <int> focus-released: KeyFocus.released;
    changed focus-released => { keys.focus(); }   // a control that held the keyboard for a moment (a listening key cap) gave it back
    keys := FocusScope {
        key-pressed(e) => {
            let id = root.key-answer(KeyNames.name(e.text), e.modifiers.control, e.modifiers.shift || e.text == Key.Backtab, e.modifiers.alt, KeyNames.glyph-shifted(e.text));
            if (id == "") { return reject; }
            if (id == "palette") { root.open-palette(); return accept; }   // not-translated: the host's answer for Ctrl+K
            root.shortcut(id);
            return accept;
        }
    }

    VerticalLayout {
        spacing: 0px;

        // ===================== TITLE BAR (36) =====================
        title-bar := Rectangle {
            height: Theme.title-h; background: Theme.bg;
            Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line; }
            drag := TouchArea {
                // press-drag the empty bar to move the window; double-click toggles maximise; right-click asks for the system menu
                moved => { if (self.pressed) { root.title-drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } }
                double-clicked => { root.title-double-clicked(); }
                pointer-event(e) => { if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) { root.system-menu-requested(self.mouse-x, self.mouse-y); } }
            }
            HorizontalLayout {
                padding-left: 12px; padding-right: 8px; spacing: 12px;
                Rectangle { // brand: the app menu opens from it (About FoxSDR carries the Slint attribution the licence requires)
                    min-width: 220px;
                    brand := HorizontalLayout {
                        spacing: 8px; alignment: start;
                        Image { source: @image-url("icons/fox.svg"); width: 18px; height: 18px; y: (parent.height - 18px) / 2; }
                        Text { text: "FoxSDR"; font-weight: Theme.weight-semibold; color: Theme.fg; vertical-alignment: center; accessible-role: button; accessible-label: @tr("FoxSDR {} menu", root.version); }   // not-translated: the product name
                        Text { text: root.version; font-family: Theme.font-mono; color: Theme.muted; vertical-alignment: center; }
                        if root.preview : VerticalLayout { alignment: center;
                            Chip { label: @tr("SLINT PREVIEW"); tone: ChipTone.warn; tooltip: @tr("A preview of the Slint window: it works on a copy of your settings and never writes the real ones."); }
                        }
                        Text { text: "Fox & Schirmyver · Type 71 Mk II"; font-size: Theme.font-micro; letter-spacing: 1px; color: Theme.faint; font-weight: Theme.weight-semibold; vertical-alignment: center; }   // not-translated: the maker's engraved legend (a brand line), not a sentence
                    }
                    TouchArea { x: 0; width: min(brand.preferred-width, parent.width); clicked => { root.brand-clicked(); } }
                }
                Rectangle { // command palette field, centred
                    HorizontalLayout { alignment: center;
                        VerticalLayout { alignment: center;
                            CommandField { clicked => { root.open-palette(); } }
                        }
                    }
                }
                HorizontalLayout { // notifications + window keys
                    min-width: 220px; spacing: 4px; alignment: end;
                    VerticalLayout { alignment: center;
                        Rectangle { width: 30px; height: 30px;
                            Key { icon: @image-url("icons/bell.svg"); icon-only: true; ghost: true; accessible-label: root.notifications-tooltip; tooltip: root.notifications-tooltip; clicked => { root.bank-selected(4); } }
                            if root.notifications > 0 : Rectangle { x: 18px; y: 4px; width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; }
                        }
                    }
                    VerticalLayout { alignment: center; Key { icon: @image-url("icons/minimise.svg"); icon-only: true; ghost: true; accessible-label: @tr("Minimise"); tooltip: @tr("Minimise"); clicked => { root.minimise-clicked(); } } }
                    VerticalLayout { alignment: center; Key { icon: root.maximised ? @image-url("icons/restore.svg") : @image-url("icons/maximise.svg"); icon-only: true; ghost: true; accessible-label: root.maximised ? @tr("Restore") : @tr("Maximise"); tooltip: root.maximised ? @tr("Restore") : @tr("Maximise"); clicked => { root.maximise-clicked(); } } }
                    VerticalLayout { alignment: center; Key { icon: @image-url("icons/close.svg"); icon-only: true; ghost: true; accessible-label: @tr("Close"); tooltip: @tr("Close"); clicked => { root.close-clicked(); } } }
                }
            }
        }

        // ===================== RECEIVER STRIP (104) =====================
        Rectangle {
            height: Theme.strip-h; background: Theme.strip;
            Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line; }
            // THE ROW HOLDS ITS WIDTH (6.38.3): a layout's minimum width travels up through every parent that has no width of its own,
            // and the receiver strip asks for more than the window when the catalogue's words are longer than the English ones (French, German).
            // A Rectangle with a width of its own stops that climb (tests/test_slint_constraints.cpp), and clips what still does not fit.
            Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; clip: true;
                HorizontalLayout {   // stretch (the default): the lanes take the strip's slack, the other blocks keep their width
                    padding-left: 16px; padding-right: 16px; spacing: 14px;   // the sheet says 20; 14 lets the three lanes keep their captions at 1440

                    HorizontalLayout { // STOP + the four MASTER lamps
                        spacing: 14px; alignment: center; horizontal-stretch: 0;
                        VerticalLayout { alignment: center; StopKey { running: root.running; tooltip: root.running ? @tr("Stop the receiver") : @tr("Start the receiver"); clicked => { root.stop-clicked(); } } }
                        GridLayout { spacing-horizontal: 14px; spacing-vertical: 6px; y: (parent.height - self.height) / 2;
                            Row { Lamp { caption: @tr("RUN");  state: root.running  ? LampState.green : LampState.off; } Lamp { caption: @tr("DEC");  state: root.decoding ? LampState.green : LampState.off; } }
                            Row { Lamp { caption: @tr("MUTE"); state: root.muted    ? LampState.amber : LampState.off; } Lamp { caption: @tr("FAIL"); state: root.failed   ? LampState.red   : LampState.off; } }
                        }
                    }
                    VLine { y: (parent.height - 72px) / 2; }

                    VerticalLayout { // the tuned frequency
                        spacing: 2px; alignment: center; horizontal-stretch: 0;
                        HorizontalLayout { alignment: space-between;
                            Caption { label: @tr("Tuned frequency"); }
                            HorizontalLayout { spacing: 10px;
                                Lamp { caption: @tr("RCVR"); state: root.running ? LampState.amber : LampState.off; }
                                Text { text: root.tuned-text; font-family: Theme.font-mono; font-size: Theme.font-small; color: Theme.accent-soft; vertical-alignment: center; }
                            }
                        }
                        counter := FrequencyCounter {   // the caption slot under the figures: the converter line when one is active, else the sheet's tune hint
                            digits: root.digits; leading-zeros: root.leading-zeros; show-nudges: root.show-nudges;
                            editing: root.editing; editor-text <=> root.editor-text;
                            converter-text: root.converter-text != "" ? root.converter-text : root.tune-hint; converter-warn: root.converter-warn;
                            tooltip: @tr("Scroll a digit to tune  |  click to type");
                            nudge(d, dir) => { root.nudge(d, dir); }
                            wheel(d, dir) => { root.nudge(d, dir); }
                            edit-requested => { root.edit-requested(); }
                            typed(t) => { root.typed(t); }
                            edit-cancelled => { root.edit-cancelled(); }
                            menu-requested(x, y) => { root.counter-menu-requested(x, y); }
                        }
                    }
                    VLine { y: (parent.height - 72px) / 2; }

                    VerticalLayout { // mode: the eight keys as a segment, or one picker when the strip is compact
                        spacing: 6px; alignment: center; horizontal-stretch: 0;
                        Caption { label: @tr("Mode"); }
                        HorizontalLayout { alignment: start;
                            if !root.compact-strip : SegGroup {   // the eight mode keys, a radio group (accessible as eight buttons)
                                HorizontalLayout { spacing: 2px;
                                    for m[i] in root.modes : SegKey { label: m; on: i == root.mode-index; clicked => { root.mode-selected(i); } }
                                }
                            }
                            if root.compact-strip : SelectKey { value: root.modes[root.mode-index]; tooltip: @tr("Mode - the eight modes as a list (Ctrl+F ... Ctrl+R)");
                                clicked => { root.mode-picker-requested(self.absolute-position.x, self.absolute-position.y + self.height); } }
                        }
                        ElidedHint { text: root.mode-hint; max-width: root.compact-strip ? 130px : 440px; }
                    }
                    VLine { y: (parent.height - 72px) / 2; }

                    HorizontalLayout { // gain / squelch / volume lanes: the strip's slack is theirs
                        spacing: 18px; horizontal-stretch: 1; alignment: stretch; min-width: 396px;   // three lanes of 120 at least; from about 1500 px the captions no longer elide
                        VerticalLayout { alignment: center; horizontal-stretch: 1;
                            SliderGroup { caption: @tr("Gain"); readout: root.gain-text; hint: root.gain-hint; value: root.gain-norm; enabled: root.gain-enabled;
                                has-auto: true; auto-on: root.gain-auto; auto-enabled: root.gain-auto-enabled; auto-tooltip: root.gain-auto-tooltip; tooltip: root.gain-tooltip;
                                changed(v) => { root.gain-changed(v); } auto-clicked => { root.gain-auto-clicked(); } }
                        }
                        VerticalLayout { alignment: center; horizontal-stretch: 1;
                            SliderGroup { caption: @tr("Squelch"); readout: root.squelch-text; hint: root.squelch-hint; value: root.squelch-norm;
                                has-auto: true; auto-on: root.squelch-auto; auto-enabled: true; auto-tooltip: root.squelch-auto-tooltip; tooltip: @tr("Squelch - drag the slider, or scroll over it");
                                changed(v) => { root.squelch-changed(v); } auto-clicked => { root.squelch-auto-clicked(); } }
                        }
                        VerticalLayout { alignment: center; horizontal-stretch: 1; spacing: 7px;
                            SliderGroup { caption: @tr("VOLUME"); readout: root.volume-text; hint: ""; value: root.volume-norm; has-auto: false; tooltip: @tr("Volume - drag the slider, or scroll over it");
                                changed(v) => { root.volume-changed(v); } }
                            HorizontalLayout { spacing: 6px;   // the VOLUME meter, relocated under the volume slider (Workbench IA 2)
                                Text { text: @tr("Level"); font-size: Theme.font-hint; color: Theme.dim; vertical-alignment: center; }
                                VerticalLayout { alignment: center; horizontal-stretch: 1; LevelBar { value: root.level-norm; } }
                                Text { text: root.level-text; font-family: Theme.font-mono; font-size: Theme.font-hint; color: Theme.muted; vertical-alignment: center; }
                            }
                        }
                    }
                    VLine { y: (parent.height - 72px) / 2; }

                    VerticalLayout { // antenna power: the BIAS TEE hazard key, as wide as the key
                        spacing: 6px; alignment: center; horizontal-stretch: 0; width: 120px;
                        Rectangle {   // the caption elides in the 120 px lane (ALIMENTATION DE L'ANTENNE): its tip says it (docs 6.62)
                            height: antenna-caption.preferred-height;
                            antenna-caption := Caption { x: 0px; y: 0px; width: parent.width; label: @tr("Antenna power"); }
                            antenna-caption-area := TouchArea { }
                            TipTimer { x: 0px; y: 0px; hovered: antenna-caption-area.has-hover; text: antenna-caption.preferred-width > antenna-caption.width + 0.5px ? antenna-caption.text : ""; anchor-h: parent.height; }
                        }
                        HorizontalLayout { alignment: start;
                            Key { label: @tr("BIAS TEE"); hazard: true; on: root.bias-tee-on; enabled: root.bias-tee-present; min-w: 120px; height: 36px;
                                show-lamp: true; lamp: root.bias-tee-on ? LampState.amber : LampState.off;
                                tooltip: root.bias-tooltip; accessible-label: root.bias-tee-on ? @tr("Bias tee on") : @tr("Bias tee off - asks before switching on");
                                clicked => { if (root.bias-tee-on) { root.bias-tee-clicked(); } else { root.bias-question-open = true; } } }
                        }
                        ElidedHint { text: root.bias-hint; }
                    }
                }
            }
        }

        // the sound-muted banner (a slim bar under the strip, Workbench IA 7)
        if root.muted-by != "" : Banner { text: @tr("Sound muted by {}", root.muted-by); key-label: @tr("Stop plugin"); tone: CardTone.warn; key-clicked => { root.stop-muting-plugin(); } }

        // ===================== BODY =====================
        HorizontalLayout {
            spacing: 0px;

            Rectangle { // ICON RAIL (64)
                width: Theme.rail-w; background: Theme.bg;
                Rectangle { x: parent.width - Theme.hairline; width: Theme.hairline; height: parent.height; background: Theme.line; }
                VerticalLayout { padding-top: 8px; padding-bottom: 8px; spacing: 4px;
                    RailKey { icon: @image-url("icons/signal.svg"); caption: @tr("SIGNAL"); hint: "F1"; on: root.bank-index == 0; tooltip: @tr("SIGNAL PATH  (F1)"); clicked => { root.bank-selected(0); } }
                    RailKey { icon: @image-url("icons/decode.svg"); caption: @tr("DECODE"); hint: "F2"; on: root.bank-index == 1; tooltip: @tr("DECODE  (F2)"); clicked => { root.bank-selected(1); } }
                    RailKey { icon: @image-url("icons/tools.svg");  caption: @tr("TOOLS");  hint: "F3"; on: root.bank-index == 2; tooltip: @tr("TOOLS  (F3)"); clicked => { root.bank-selected(2); } }
                    RailKey { icon: @image-url("icons/extend.svg"); caption: @tr("EXTEND"); hint: "F4"; on: root.bank-index == 3; tooltip: @tr("EXTEND  (F4)"); clicked => { root.bank-selected(3); } }
                    RailKey { icon: @image-url("icons/system.svg"); caption: @tr("SYSTEM"); hint: "F5"; on: root.bank-index == 4; tooltip: @tr("SYSTEM  (F5)"); clicked => { root.bank-selected(4); } }
                    Rectangle { vertical-stretch: 1; }
                    RailKey { icon: root.rail-folded ? @image-url("icons/unfold.svg") : @image-url("icons/fold.svg"); caption: root.rail-folded ? @tr("SHOW") : @tr("FOLD"); hint: "";
                        tooltip: root.rail-folded ? @tr("Show the Function Select panel") : @tr("Fold the Function Select panel away to give the main view its width");
                        clicked => { root.rail-folded = !root.rail-folded; } }
                }
            }

            Rectangle { // SECTIONS PANEL (296, folds to 0)
                width: root.rail-folded ? 0px : Theme.panel-w; clip: true; background: Theme.panel-alt;
                animate width { duration: 160ms; easing: ease-out; }
                VerticalLayout { spacing: 0px; width: Theme.panel-w;
                    Rectangle { height: 40px;
                        Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line; }
                        HorizontalLayout { padding-left: 12px; padding-right: 12px; alignment: space-between;
                            Caption { label: root.bank-titles[root.bank-index]; color: Theme.fg; }
                            VerticalLayout { alignment: center; Chip { label: root.bank-chip; tone: root.bank-chip-tone; } }
                        }
                    }
                    Flickable { vertical-stretch: 1; viewport-height: list.preferred-height;
                        list := VerticalLayout { spacing: 0px; alignment: start;
                            if root.team-message-shown : Rectangle { height: team.preferred-height + 10px;
                                team := Card { x: 10px; y: 10px; width: parent.width - 20px; title: @tr("Message from the FoxSDR team"); subtitle: root.team-message-date; critical: root.team-message-important; lines: root.team-message-lines; primary-label: @tr("Seen"); primary-clicked => { root.team-message-seen(); } }
                            }
                            if root.update-shown : Rectangle { height: upd.preferred-height + 10px;
                                upd := Card { x: 10px; y: 10px; width: parent.width - 20px; title: root.update-headline; subtitle: @tr("you are running {}", root.version); critical: root.update-critical; tone: root.update-withdrawn ? CardTone.warn : CardTone.neutral; lines: root.update-notes;
                                    primary-label: root.update-primary; secondary-label: @tr("Not now"); progress: root.update-progress; note: root.update-note; error: root.update-error;
                                    primary-clicked => { root.update-primary-clicked(); } secondary-clicked => { root.update-dismissed(); } }
                            }
                            // the DECODE bank is the plugin kit's (pages.slint): its rows, drawers and keys come from the host's kit models
                            if root.bank-index == 1 : DecodeBank { rows: root.decode-rows; entries: root.plugin-entries; decode-note: root.decode-note; output-key-label: root.output-key-label;
                                lines-text: root.lines-text; tail-note: root.tail-note; cost-note: root.cost-note; stop-all-label: root.stop-all-label; empty-entries-text: root.empty-entries-text;
                                refusal: root.refusal; stale: root.stale; details: root.details; url: root.catalogue-url; }
                            if root.bank-index != 1 : VerticalLayout { spacing: 0px;
                                for s[i] in root.sections : Section { name: s.name; chip: s.chip; tone: s.tone; open: s.open; first: i == 0; show-dot: s.show-dot; dot: s.dot; clicked => { root.section-clicked(i); }
                                    // the Radio section's open body (the sheet's); the other bodies are the banks of phase 3
                                    VerticalLayout { spacing: ((root.bank-index == 0 && i != 0 && i != 5) || (root.bank-index == 4 && i != 9) || (root.bank-index == 2 && i != 0) || root.bank-index == 3) ? 10px : 0px;
                                        // the EXTEND bank's bodies (extend_bank.slint): 0 Web access, 1 CAT
                                        if root.bank-index == 3 && i == 0 : WebBody { model: root.web-model; }
                                        if root.bank-index == 3 && i == 1 : CatBody { model: root.cat-model; }
                                        // the TOOLS bank's bodies (tools_bank.slint), by row: 1 Radar, 2 Bookmarks, 3 Scanner, 4 Airband (0 Demod scope: the row only)
                                        if root.bank-index == 2 && i == 1 : RadarBody { model: root.radar-model; }
                                        if root.bank-index == 2 && i == 2 : BookmarksBody { model: root.bookmarks-model; }
                                        if root.bank-index == 2 && i == 3 : ScannerBody { model: root.scanner-model; }
                                        if root.bank-index == 2 && i == 4 : AirbandBody { model: root.airband-model; }
                                        // the SYSTEM bank's bodies (system_bank.slint), by row: 0 Display, 1 Language & country, 2 Frequency correction (the SIGNAL
                                        // family's body), 3 Updates, 4 Serial ports, 5 Key bindings, 6 Diagnostics, 7 Usage reporting, 8 Beta tester; 9 About opens the sheet
                                        if root.bank-index == 4 && i == 0 : DisplayBody { model: root.display-model; }
                                        if root.bank-index == 4 && i == 1 : LanguageBody { model: root.language-model; }
                                        if root.bank-index == 4 && i == 2 : FrequencyCorrectionBody { model: root.source-model; }
                                        if root.bank-index == 4 && i == 3 : UpdatesBody { model: root.updates-model; }
                                        if root.bank-index == 4 && i == 4 : SerialPortsBody { model: root.serial-model; }
                                        if root.bank-index == 4 && i == 5 : KeyBindingsBody { model: root.keys-model; }
                                        if root.bank-index == 4 && i == 6 : DiagnosticsBody { model: root.diag-model; }
                                        if root.bank-index == 4 && i == 7 : UsageBody { model: root.usage-model; }
                                        if root.bank-index == 4 && i == 8 : TesterBody { model: root.tester-model; }
                                        // the SIGNAL bank's bodies (signal_bank.slint), by row: 1 Source, 3 Audio filters, 4 Sinks, 6 Recorder, 7 Frequency correction
                                        if root.bank-index == 0 && i == 1 : SourceBody { model: root.source-model; ppm-block: false; }   // the ppm block is row 7
                                        if root.bank-index == 0 && i == 2 : RadioExtras { model: root.radio-extras; }
                                        if root.bank-index == 0 && i == 3 : AudioFiltersBody { model: root.filters-model; }
                                        if root.bank-index == 0 && i == 4 : SinksBody { model: root.sinks-model; }
                                        if root.bank-index == 0 && i == 5 && root.transmit-model.fault != "" : Text { text: root.transmit-model.fault; font-size: Theme.font-small; color: Theme.chip-err-fg; wrap: word-wrap; }
                                        if root.bank-index == 0 && i == 6 : RecorderBody { model: root.recorder-model; }
                                        if root.bank-index == 0 && i == 7 : FrequencyCorrectionBody { model: root.source-model; }
                                        if root.bank-index == 0 && i == 2 : Text { text: @tr("Mode keys are on the receiver strip above (Ctrl+F … Ctrl+R)."); font-size: Theme.font-small; color: Theme.muted; wrap: word-wrap; }
                                        if root.bank-index == 0 && i == 2 : BodyRow { label: @tr("Passband"); Text { text: root.passband-text; font-family: Theme.font-mono; color: Theme.fg; vertical-alignment: center; } }
                                        if root.bank-index == 0 && i == 2 : Slider { value: root.passband-norm; accessible-label: @tr("Passband"); changed(v) => { root.passband-changed(v); } }
                                        if root.bank-index == 0 && i == 2 : BodyRow { label: @tr("Tune step"); SelectKey { value: root.tune-step-text; clicked => { root.tune-step-clicked(self.absolute-position.x, self.absolute-position.y + self.height); } } }
                                        if root.bank-index == 0 && i == 2 : Checkbox { label: @tr("Follow the band plan's mode when retuning"); checked <=> root.follow-band-plan; toggled(v) => { root.follow-band-plan-toggled(v); } }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 44px;
                        Rectangle { y: 0; height: Theme.hairline; width: parent.width; background: Theme.line; }
                        VerticalLayout { padding-left: 12px; padding-right: 12px; padding-top: 8px; spacing: 2px;
                            ElidedHint { text: root.source-line; }
                            ElidedHint { text: root.converter-line != "" ? root.converter-line : root.rate-line; ink: root.converter-line != "" ? Theme.chip-warn-fg : Theme.dim; family: Theme.font-mono; }
                        }
                    }
                }
                Rectangle { x: parent.width - Theme.hairline; width: Theme.hairline; height: parent.height; background: Theme.line; }   // over the rows
            }

            centre := VerticalLayout { // CENTRE
                spacing: 0px; horizontal-stretch: 1;
                Rectangle { // tab row + spectrum toolbar (32)
                    height: Theme.tab-h;
                    Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line; }
                    // THE ROW HOLDS ITS WIDTH (6.38.3): a layout's minimum width travels up through every parent that has no width of its own,
                    // and the tab row and the spectrum toolbar asks for more than the window when the catalogue's words are longer than the English ones (French, German).
                    // A Rectangle with a width of its own stops that climb (tests/test_slint_constraints.cpp), and clips what still does not fit.
                    Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; clip: true;
                        HorizontalLayout { padding-left: 8px; padding-right: 8px; alignment: space-between;
                            HorizontalLayout { spacing: 0px;
                                Tab { label: @tr("RECEIVER"); on: root.view-index == 0; tooltip: @tr("Shows the receiver: the spectrum, the waterfall and its status. Leaving the patch view stops a running patch and gives the receiver its radio back."); clicked => { root.view-selected(0); } }
                                Tab { label: @tr("PATCH");    on: root.view-index == 1; tooltip: @tr("Opens the patch canvas: radios, channels, decoders and displays wired together by hand. Drag from a port to wire it. A connection that cannot carry what the port produces is refused, and says why."); clicked => { root.view-selected(1); } }
                                Tab { label: @tr("SCOPE");    on: root.view-index == 2; tooltip: @tr("The scope: an instrument fills the centre."); clicked => { root.view-selected(2); } }
                                for p[i] in root.pages : Tab { label: p.title; on: root.view-index == 3 + i; torn-off: p.torn; closable: true; tooltip: p.chip;
                                    clicked => { KitEvents.page-tab-selected(i); } close-clicked => { KitEvents.page-tab-closed(i); } drag-out(dx, dy) => { KitEvents.page-tab-torn(i, dx, dy); } }
                                Tab { label: @tr("+ Window"); tooltip: @tr("Open a decoder window as a tab"); clicked => { root.add-window-clicked(); } }
                            }
                            HorizontalLayout { spacing: 6px; alignment: end;
                                VerticalLayout { alignment: center; Caption { label: @tr("Trace"); font-size: Theme.font-tiny; visible: self.width + 0.5px >= self.preferred-width; }   /* squeezed below its words it is left out, not drawn as a sliver (docs 6.62) */ }
                                VerticalLayout { alignment: center; SegGroup { small: true; HorizontalLayout { padding: 2px; spacing: 2px;
                                    SegKey { label: @tr("Normal"); small: true; min-w: 0px; on: root.trace-mode == 0; clicked => { root.trace-mode-selected(0); } }
                                    SegKey { label: @tr("Peak hold"); small: true; min-w: 0px; on: root.trace-mode == 1; clicked => { root.trace-mode-selected(1); } }
                                    SegKey { label: @tr("Average"); small: true; min-w: 0px; on: root.trace-mode == 2; clicked => { root.trace-mode-selected(2); } } } } }
                                VerticalLayout { alignment: center; Caption { label: @tr("Range"); font-size: Theme.font-tiny; visible: self.width + 0.5px >= self.preferred-width; } }
                                VerticalLayout { alignment: center; SegGroup { small: true; HorizontalLayout { padding: 2px; spacing: 2px;
                                    SegKey { label: @tr("Auto"); small: true; min-w: 0px; on: !root.range-manual; tooltip: @tr("Automatic: the standard window, -110 to 0 dB on the receiver"); clicked => { root.range-manual-selected(false); } }
                                    SegKey { label: @tr("Manual"); small: true; min-w: 0px; on: root.range-manual; tooltip: @tr("Manual: the Floor and Ceiling of the Display block"); clicked => { root.range-manual-selected(true); } } } } }
                                VerticalLayout { alignment: center; HorizontalLayout { spacing: 0px;
                                    Key { label: @tr("Markers"); ghost: true; small: true; min-w: 0px; tooltip: @tr("List the markers dropped on the waterfall"); clicked => { root.markers-clicked(); } }
                                    VerticalLayout { alignment: center; Chip { label: root.marker-count; small: true; } } } }
                                VerticalLayout { alignment: center; Key { label: @tr("Band plan"); ghost: !root.band-plan-on; on: root.band-plan-on; small: true; min-w: 0px; tooltip: @tr("Show the band-plan ribbon on the spectrum"); clicked => { root.band-plan-toggled(); } } }
                                VerticalLayout { alignment: center; SegGroup { small: true; HorizontalLayout { padding: 2px; spacing: 2px;
                                    SegKey { label: "−"; small: true; min-w: 26px; tooltip: @tr("Zoom out (Ctrl -)"); clicked => { root.zoom(-1); } }
                                    SegKey { label: "+"; small: true; min-w: 26px; tooltip: @tr("Zoom in (Ctrl +)"); clicked => { root.zoom(1); } }
                                    SegKey { label: @tr("Full span"); small: true; min-w: 0px; tooltip: @tr("Back to the full span (Ctrl Delete)"); clicked => { root.zoom(0); } } } } }
                            }
                        }
                    }
                }
                Rectangle { // the view: RECEIVER (spectrum + splitter + waterfall), PATCH, SCOPE
                    vertical-stretch: 1; preferred-height: 700px;   // the layout sizes the window on the desktop: 36 + 104 + 32 + 700 + 28 is the design height (the well alone would count as 120)
                    // THE RADIO WORKSPACE (docs/multi-radio-records/screen-s3.md): with more than one radio open the receiver view carries a 30 px bar (layout keys, page keys) over it, and a multi-pane
                    // layout puts the grid of panes where the spectrum and waterfall are. With ONE radio there is no bar, ws-bar-h is 0 and this view is exactly what it was.
                    private property <length> ws-bar-h: root.view-index == 0 && WorkspaceModel.radio-count > 1 ? 30px : 0px;
                    if root.view-index == 0 && WorkspaceModel.radio-count > 1 : WorkspaceBar { x: 0; y: 0; width: parent.width; }
                    if root.view-index == 0 && WorkspaceModel.shown-layout > 0 : RadioWorkspace { x: 0; y: parent.ws-bar-h; width: parent.width; height: max(0px, parent.height - parent.ws-bar-h); }
                    if root.view-index == 0 && WorkspaceModel.shown-layout == 0 : Rectangle {   // the wells are placed, not laid out: a layout here fed its 120 px minimum to the window's own size
                        x: 0; y: parent.ws-bar-h; width: parent.width; height: parent.height - parent.ws-bar-h;
                        spectrum := SpectrumView {
                            x: 0; y: 0; width: parent.width;
                            height: max(120px, (parent.height - Theme.splitter-h) * root.split-ratio);
                            trace: root.trace-image; db-ticks: root.db-ticks; freq-ticks: root.freq-ticks; axis-unit: root.axis-unit;
                            caption: root.spectrum-caption; caveat: root.spectrum-caveat;
                            trace-mode: root.trace-mode == 1 ? TraceMode.peak-hold : root.trace-mode == 2 ? TraceMode.average : TraceMode.normal;
                            trace-mode-label: root.trace-mode == 1 ? @tr("Peak hold") : root.trace-mode == 2 ? @tr("Average") : "";
                            peak-text: root.peak-text; peak-age: root.peak-age; show-peak: root.show-peak; span-text: root.span-text;
                            vfo-pos: root.vfo-pos; vfo-half: root.vfo-half; show-vfo: root.show-vfo;
                            bands: root.ribbon; ribbon-size: root.band-plan-on ? root.ribbon-size : 0;
                            bookmarks: root.bookmarks; plugin-marks: root.marks; user-markers: root.markers;
                            cursor-text: root.cursor-text; cursor-visible: root.cursor-visible; cursor-pos: root.cursor-pos;
                            band-tooltip: root.band-tooltip; edge-tooltip: root.edge-tooltip; off-band-tooltip: root.off-band-tooltip;
                            hover(x, y) => { root.spectrum-hover(x, y); }
                            clicked(x, shift) => { root.spectrum-clicked(x, shift); }
                            double-clicked(x) => { root.spectrum-double-clicked(x); }
                            right-clicked(x, px, py) => { root.spectrum-menu-requested(x, px, py); }
                            band-dragged(dx) => { root.band-dragged(dx); }
                            edge-dragged(h) => { root.edge-dragged(h); }
                            wheel(x, n, shift) => { root.spectrum-wheel(x, n, shift); }
                        }
                        Splitter { x: 0; y: spectrum.height; width: parent.width; moved(dy) => { root.split-ratio = max(0.1, min(0.9, root.split-ratio + dy / max(1px, parent.height - Theme.splitter-h))); } }
                        if !View3D.wf-on : WaterfallView {
                            x: 0; y: spectrum.height + Theme.splitter-h; width: parent.width; height: max(0px, parent.height - spectrum.height - Theme.splitter-h);
                            picture: root.waterfall-image; age-ticks: root.age-ticks;
                            show-key: root.show-strength-key; key-labels: root.key-labels; key-foot: root.key-foot; key-manual: root.range-manual; key-coverage: root.key-coverage;
                            rail-pos: root.wf-rail-pos;
                            foot-left: root.waterfall-foot-left; foot-tuned: root.waterfall-foot-tuned; foot-rest: root.waterfall-foot-rest;
                            vfo-pos: root.vfo-pos; show-vfo: root.show-vfo;
                            plugin-marks: root.wf-marks; user-markers: root.markers;
                            cursor-text: root.cursor-text; cursor-visible: root.cursor-visible; cursor-pos: root.cursor-pos;
                            marker-tooltip: root.marker-tooltip; tooltip: root.waterfall-tooltip;
                            hover(x, y) => { root.waterfall-hover(x, y); }
                            clicked(x, shift) => { root.waterfall-clicked(x, shift); }
                            panned(dx) => { root.waterfall-panned(dx); }
                            double-clicked => { root.waterfall-double-clicked(); }
                            right-clicked(x, px, py) => { root.waterfall-menu-requested(x, px, py); }
                            wheel(x, n, shift) => { root.waterfall-wheel(x, n, shift); }
                            marker-hovered(i) => { root.marker-hovered(i); }
                        }
                        // THE 3D SURFACE (docs 6.64): the VIEW toggle sits on the 2D waterfall's top left (the strength key is on its right); the surface takes the waterfall's place and carries the toggle in its own strip
                        if !View3D.wf-on : Rectangle {
                            x: 44px + 10px; y: spectrum.height + Theme.splitter-h + 8px; width: wf3d-toggle.width + 12px; height: wf3d-toggle.height + 10px;
                            background: Theme.wf-key-bg; border-width: Theme.hairline; border-color: Theme.line; border-radius: Theme.radius-panel;
                            wf3d-toggle := Scene3DViewToggle {
                                x: 6px; y: 5px; three-d: false; label-3d: @tr("3D SURFACE");
                                selected(on) => { View3D.wf-view-selected(on); }
                            }
                        }
                        if View3D.wf-on : Wf3DView {
                            x: 0; y: spectrum.height + Theme.splitter-h; width: parent.width; height: max(0px, parent.height - spectrum.height - Theme.splitter-h);
                            show-key: root.show-strength-key; key-labels: root.key-labels; key-foot: root.key-foot;
                            foot-left: root.waterfall-foot-left; foot-tuned: root.waterfall-foot-tuned; foot-rest: root.waterfall-foot-rest;
                        }
                    }
                    if root.view-index == 1 : PatchPage { model: root.patch-model; canvas: root.canvas-model; inspector: root.inspector-model; }
                    if root.view-index == 2 : RadarScopeView { model: root.radar-scope-model; offers: root.radar-model.offers; }
                    // a docked page of the plugin kit (its body reaches the host through the KitEvents global)
                    if root.view-index >= 3 && root.view-index - 3 < root.pages.length && !root.pages[root.view-index - 3].torn : PageBody { page: root.pages[root.view-index - 3]; index: root.view-index - 3; }
                }
            }
        }

        // ===================== STATUS BAR (28) =====================
        Rectangle {
            height: Theme.status-h; background: Theme.strip;
            Rectangle { y: 0; height: Theme.hairline; width: parent.width; background: Theme.line; }
            // THE ROW HOLDS ITS WIDTH (6.38.3): a layout's minimum width travels up through every parent that has no width of its own,
            // and the status bar asks for more than the window when the catalogue's words are longer than the English ones (French, German).
            // A Rectangle with a width of its own stops that climb (tests/test_slint_constraints.cpp), and clips what still does not fit.
            Rectangle { x: 0; y: 0; width: parent.width; height: parent.height; clip: true;
                HorizontalLayout { padding-left: 4px; spacing: 0px; alignment: start;
                    for c[i] in root.status : Rectangle {   // a chip may be squeezed down to its lamp, key and value; its detail elides first (docs 6.62)
                        min-width: chip.min-content-width; preferred-width: chip.content-width; max-width: chip.content-width;
                        chip := StatusChip {
                            x: 0px; y: 0px; width: parent.width;
                            key: c.key; value: c.value; detail: c.detail; lamp: c.lamp; show-lamp: c.show-lamp; lines: c.lines; max-detail-w: 364px;
                            value-color: c.tone == ChipTone.good ? Theme.chip-good-fg : c.tone == ChipTone.warn ? Theme.accent-soft : c.tone == ChipTone.err ? Theme.chip-err-fg : Theme.fg;
                            tooltip: c.detail;
                            clicked => { root.status-clicked(i); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Key { label: @tr("Request a feature"); ghost: true; small: true; min-w: 0px; tooltip: @tr("Ask for a feature"); clicked => { root.feature-request-clicked(); } } }
                    VerticalLayout { alignment: center; Key { label: @tr("Report a bug / dislike"); ghost: true; small: true; min-w: 0px; tooltip: @tr("Report a problem"); clicked => { root.bug-report-clicked(); } } }
                    Rectangle { width: 8px; }
                }
            }
        }
    }

    // ===================== frameless window: the resize edges =====================
    Rectangle { x: parent.width - 6px; y: 0; width: 6px; height: parent.height - 12px; TouchArea { mouse-cursor: ew-resize; moved => { if (self.pressed) { root.resize-drag(1, self.mouse-x - self.pressed-x, 0); } } } }
    Rectangle { x: 0; y: parent.height - 6px; width: parent.width - 12px; height: 6px; TouchArea { mouse-cursor: ns-resize; moved => { if (self.pressed) { root.resize-drag(2, 0, self.mouse-y - self.pressed-y); } } } }
    Rectangle { x: parent.width - 12px; y: parent.height - 12px; width: 12px; height: 12px; TouchArea { mouse-cursor: nwse-resize; moved => { if (self.pressed) { root.resize-drag(3, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); } } } }

    // ===================== the torn-off pages: in-window TornWindows over the screen (an OS-level window is a later step) =====================
    for p[i] in root.pages : Rectangle { x: 0; y: 0; width: 0px; height: 0px;
        if p.torn : TornWindow { x: p.tx; y: p.ty; width: p.tw; height: p.th; title: p.title; rolled-up: p.rolled; tooltip: @tr("Drag to move; double-click to dock the page back as a tab");
            roll-up-clicked => { KitEvents.page-chrome-rollup(i); } maximise-clicked => { KitEvents.page-chrome-dock(i); } close-clicked => { KitEvents.page-chrome-close(i); }
            drag(dx, dy) => { KitEvents.page-chrome-drag(i, dx, dy); } double-clicked => { KitEvents.page-chrome-dock(i); } resize(dx, dy) => { KitEvents.page-chrome-resize(i, dx, dy); }
            PageBody { page: p; index: i; }
        }
    }

    // ===================== overlays =====================
    menu := Menu { x: 0; y: 0; entries: root.menu-entries; activated(id) => { root.menu-activated(id); } slider-changed(id, v) => { root.menu-slider-changed(id, v); } }
    palette := CommandPalette { at-x: (root.width - 640px) / 2; at-y: 48px; query <=> root.palette-query; results: root.palette-results;
        query-changed(q) => { root.palette-query-changed(q); } activated(id) => { root.palette-activated(id); } }

    // the "Sound is muted" question (app_window.cpp 16365): asked once when the receiver tunes off a muting plugin's preset
    if root.mute-question-open : Sheet { title: @tr("Sound is muted"); dismissed => { root.mute-question-open = false; KitEvents.mute-keep-clicked(); }
        Text { text: root.mute-question-text; wrap: word-wrap; color: Theme.fg-soft; font-size: Theme.font-small; }
        HorizontalLayout { spacing: 8px; alignment: end;
            Key { label: root.mute-stop-label; clicked => { root.mute-question-open = false; KitEvents.mute-stop-clicked(); } }
            Key { label: @tr("Keep it running"); on: true; clicked => { root.mute-question-open = false; KitEvents.mute-keep-clicked(); } }
        }
    }
    // the SIGNAL bank's companion sheets: the Radio-setup page and the recorder's import dialog (shown by their models)
    if root.radio-setup.shown : RadioSetupSheet { model: root.radio-setup; }
    if root.import-dialog.shown : ImportDialog { model: root.import-dialog; }
    if root.report-page.shown : ReportSheet { model: root.report-page; }
    if root.markers-model.shown : MarkersSheet { model: root.markers-model; }
    // THE DEMOD SCOPE: a window of its own over the centre, opened where the classic opens it (the lower right, inside the main window)
    if root.demod-model.shown : DemodScopeWindow {
        x: 0px; y: Theme.title-h; width: root.width; height: max(0px, root.height - Theme.title-h - Theme.status-h);
        win-x: max(0px, root.width - 780px - 36px); win-y: max(0px, root.height - Theme.title-h - Theme.status-h - 540px - 20px);
        model: root.demod-model;
    }
    if root.bias-question-open : Sheet { title: @tr("Turn on the bias tee?"); dismissed => { root.bias-question-open = false; }
        Text { text: root.bias-question-text; wrap: word-wrap; color: Theme.fg-soft; font-size: Theme.font-small; }
        Text { text: root.bias-tooltip; wrap: word-wrap; color: Theme.chip-warn-fg; font-size: Theme.font-small; }
        HorizontalLayout { spacing: 8px; alignment: end;
            Key { label: @tr("Turn it on"); clicked => { root.bias-question-open = false; root.bias-tee-confirmed(); } }
            Key { label: @tr("Cancel"); on: true; clicked => { root.bias-question-open = false; } }
        }
    }
    if root.about-open : Sheet { title: @tr("About FoxSDR"); sheet-w: 520px; dismissed => { root.about-open = false; }
        Text { text: root.preview ? @tr("FoxSDR {} · Slint preview", root.version) : @tr("FoxSDR {}", root.version); color: Theme.fg; font-size: Theme.font-small; }
        Text { text: root.about-text; wrap: word-wrap; color: Theme.fg-soft; font-size: Theme.font-small; }
        // The Slint Royalty-free licence 2.0 requires this widget in an About dialog reachable from the top-level menu
        // (the brand menu above) in every distributed build; it is never behind a switch.
        Text { text: @tr("Typefaces: Inter (The Inter Project Authors) and JetBrains Mono (JetBrains), both under the SIL Open Font License 1.1; the licence texts travel with the fonts in third_party/fonts. Built with Slint:"); wrap: word-wrap; color: Theme.dim; font-size: Theme.font-hint; }
        AboutSlint { }
        HorizontalLayout { alignment: end; Key { label: @tr("Close"); clicked => { root.about-open = false; } } }
    }
    // ===================== the tip layer: LAST, so a tooltip draws over the pages, the torn-off windows and the sheets =====================
    TipLayer { x: 0px; y: 0px; win-w: root.width; win-h: root.height; }
}
