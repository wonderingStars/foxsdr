// FoxSDR Slint front end - COMPONENT LIBRARY (spike, first cut).
// The handover's Slint component list, built from the Workbench sheet's CSS one class at a time:
// Key (.btn), SegKey (.seg .btn), Lamp (.lamp), Chip (.chip), Digit (.digit), Slider (.sl),
// Section (.sec), Tab (.tab), RailKey (.rb), StatusChip (.sb), Caption (.cap).
// Measurements are the sheet's: key 30px / min 64px / padding 14px; chip 20px; digit 34x52;
// rail key 56x56; section row 36px; tab 32px; status chip 28px.

import { Theme } from "theme.slint";

export component Caption inherits Text {
    // .cap: 10px, letter-spaced, upper-case, muted, 600
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.8px;
    color: Theme.muted;
    font-family: Theme.font-ui;
    vertical-alignment: center;
}

export component Key inherits Rectangle {
    // .btn - plain, latched (on), ghost, danger, icon-only (small square)
    in property <string> label;
    in property <bool> on;
    in property <bool> ghost;
    in property <bool> danger;
    in property <length> min-w: 64px;
    in property <length> key-height: 30px;
    in property <length> font-px: 12px;
    callback clicked;

    height: key-height;
    min-width: min-w;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: on ? Theme.accent : (danger ? Theme.chip-err-line : Theme.line-strong);
    background: on ? Theme.accent
              : danger ? Theme.danger-bg
              : ghost ? transparent
              : Theme.chip-bg;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.label;
            color: on ? Theme.accent-ink : (danger ? Theme.danger-fg : Theme.fg);
            font-size: root.font-px;
            font-weight: 500;
            font-family: Theme.font-ui;
            vertical-alignment: center;
        }
    }
    area := TouchArea { clicked => { root.clicked(); } }
}

export component SegGroup inherits Rectangle {
    // .seg - a ground the SegKeys sit in; the caller lays the keys out in an HorizontalLayout child
    background: Theme.panel-alt;
    border-width: 1px;
    border-color: Theme.line-strong;
    border-radius: 7px;
}

export component SegKey inherits Rectangle {
    // .seg .btn - 26px, borderless, lit amber when on
    in property <string> label;
    in property <bool> on;
    in property <length> min-w: 52px;
    callback clicked;
    height: 26px;
    min-width: min-w;
    border-radius: 5px;
    background: on ? Theme.accent : transparent;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; alignment: center;
        Text {
            text: root.label;
            color: on ? Theme.accent-ink : Theme.fg-soft;
            font-size: 12px; font-weight: 500; font-family: Theme.font-ui;
            vertical-alignment: center;
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export enum LampState { off, green, amber, red }

export component Lamp inherits HorizontalLayout {
    // .lamp - 9px dot + 10px caption; lit dots glow (drawn as a soft ring here)
    in property <string> caption;
    in property <LampState> state: LampState.off;
    spacing: 6px;
    alignment: start;
    Rectangle {
        width: 9px; height: 9px; border-radius: 4.5px;
        y: (parent.height - self.height) / 2;
        background: root.state == LampState.green ? Theme.lamp-green
                  : root.state == LampState.amber ? Theme.lamp-amber
                  : root.state == LampState.red   ? Theme.lamp-red
                  : Theme.lamp-off;
        border-width: 1px;
        border-color: root.state == LampState.off ? Theme.knob-ring : self.background;
        drop-shadow-blur: root.state == LampState.off ? 0px : 6px;
        drop-shadow-color: root.state == LampState.off ? transparent : self.background.with-alpha(0.53);
    }
    if root.caption != "" : Text {
        text: root.caption;
        font-size: 10px; font-weight: 600; letter-spacing: 0.6px; font-family: Theme.font-ui;
        vertical-alignment: center;
        color: root.state == LampState.green ? Theme.lamp-green-cap
             : root.state == LampState.amber ? Theme.lamp-amber-cap
             : root.state == LampState.red   ? Theme.lamp-red-cap
             : Theme.muted;
    }
}

export enum ChipTone { neutral, good, warn, err }

export component Chip inherits Rectangle {
    // .chip - 20px pill, 10px 600 letter-spaced; neutral / good / warn / err
    in property <string> label;
    in property <ChipTone> tone: ChipTone.neutral;
    in property <bool> mono;
    height: 20px;
    // A chip is as wide as its words: placed absolutely (the SPAN chip in the spectrum well, the marker tab) a bare
    // Rectangle would take its parent's width, so the width is the layout's preferred width.
    width: body.preferred-width;
    border-radius: 10px;
    border-width: 1px;
    background: tone == ChipTone.good ? Theme.chip-good-bg
              : tone == ChipTone.warn ? Theme.chip-warn-bg
              : tone == ChipTone.err  ? Theme.chip-err-bg
              : Theme.chip-bg;
    border-color: tone == ChipTone.good ? Theme.chip-good-line
                : tone == ChipTone.warn ? Theme.chip-warn-line
                : tone == ChipTone.err  ? Theme.chip-err-line
                : Theme.line-strong;
    body := HorizontalLayout {
        padding-left: 8px; padding-right: 8px; alignment: center;
        Text {
            text: root.label;
            font-size: 10px; font-weight: 600; letter-spacing: 0.5px;
            font-family: root.mono ? Theme.font-mono : Theme.font-ui;
            vertical-alignment: center;
            color: root.tone == ChipTone.good ? Theme.chip-good-fg
                 : root.tone == ChipTone.warn ? Theme.chip-warn-fg
                 : root.tone == ChipTone.err  ? Theme.chip-err-fg
                 : Theme.fg-soft;
        }
    }
}

export component Digit inherits VerticalLayout {
    // .digit - a 34x52 column: nudge up, the numeral (30px, amber, glow), nudge down.
    // `dim` is the leading-zero look. up/down are the per-digit tune steps.
    in property <int> value;
    in property <bool> dim;
    callback up;
    callback down;
    width: 34px; height: 52px;
    alignment: space-between;
    Rectangle {
        height: 10px;
        Text { text: "▲"; font-size: 9px; color: Theme.nudge; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.up(); } }
    }
    Text {
        text: root.value;
        font-size: 30px; font-weight: 600; font-family: Theme.font-mono;
        horizontal-alignment: center; vertical-alignment: center;
        color: root.dim ? Theme.digit-dim : Theme.digit;
    }
    Rectangle {
        height: 10px;
        Text { text: "▼"; font-size: 9px; color: Theme.nudge; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.down(); } }
    }
}

export component Slider inherits Rectangle {
    // .sl - 6px track, amber fill, 16px knob. value is 0..1 of the track; `changed` fires with the new 0..1.
    in-out property <float> value: 0.5;
    in property <bool> enabled: true;
    callback changed(float);
    height: 6px;
    border-radius: 3px;
    background: Theme.line;
    Rectangle { // fill
        x: 0; width: parent.width * root.value; height: parent.height; border-radius: 3px;
        background: Theme.accent;
    }
    knob := Rectangle {
        width: 16px; height: 16px; border-radius: 8px;
        x: root.width * root.value - 8px;
        y: -5px;
        background: Theme.fg;
        border-width: 2px; border-color: Theme.panel;
        drop-shadow-blur: 3px; drop-shadow-offset-y: 1px; drop-shadow-color: Theme.well-deep.with-alpha(0.53);
    }
    touch := TouchArea {
        y: -8px; height: 22px;
        moved => { if (self.pressed && root.enabled) { root.set-from(self.mouse-x); } }
        clicked => { if (root.enabled) { root.set-from(self.mouse-x); } }
    }
    function set-from(px: length) {
        root.value = max(0.0, min(1.0, px / root.width));
        root.changed(root.value);
    }
}

export component Section inherits Rectangle {
    // .sec - a rail bank row: chevron, name, status chip; `open` tints it like the open Radio row
    in property <string> name;
    in property <string> chip;
    in property <ChipTone> tone: ChipTone.neutral;
    in property <bool> open;
    in property <bool> first;
    callback clicked;
    height: 36px;
    background: open ? Theme.panel : transparent;
    Rectangle { // border-top (none on the first row)
        y: 0; height: first ? 0px : 1px; width: parent.width; background: Theme.line;
    }
    HorizontalLayout {
        padding-left: 8px; padding-right: 10px; spacing: 8px; alignment: space-between;
        HorizontalLayout {
            spacing: 8px;
            Text { // chevron: right when closed, down when open
                text: root.open ? "⌄" : "›";
                width: 14px; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-alignment: center;
            }
            Text { text: root.name; color: Theme.fg; font-size: 12px; font-weight: 500; font-family: Theme.font-ui; vertical-alignment: center; }
        }
        VerticalLayout { alignment: center; Chip { label: root.chip; tone: root.tone; } }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component Tab inherits Rectangle {
    // .tab - 32px, muted, 2px amber underline when on
    in property <string> label;
    in property <bool> on;
    in property <length> min-w: 96px;
    callback clicked;
    height: 32px;
    min-width: min-w;
    HorizontalLayout {
        padding-left: 16px; padding-right: 16px; alignment: center;
        Text { text: root.label; color: root.on ? Theme.fg : Theme.muted; font-size: 12px; font-weight: 500; font-family: Theme.font-ui; vertical-alignment: center; }
    }
    Rectangle { y: parent.height - 2px; height: 2px; width: parent.width; background: root.on ? Theme.accent : transparent; }
    TouchArea { clicked => { root.clicked(); } }
}

export component RailKey inherits Rectangle {
    // .rb - 56x56 icon key with a 9px caption and an 8px F-key hint; lit amber on a chip ground when on
    in property <string> caption;
    in property <string> hint;
    in property <bool> on;
    in property <image> icon;
    callback clicked;
    width: 56px; height: 56px;
    border-radius: 8px;
    background: on ? Theme.chip-bg : transparent;
    VerticalLayout {
        alignment: center; spacing: 4px;
        if root.icon.width > 0 : Image { source: root.icon; width: 18px; height: 18px; colorize: root.on ? Theme.accent : Theme.muted; horizontal-alignment: center; }
        Text { text: root.caption; font-size: 9px; font-weight: 600; letter-spacing: 0.4px; font-family: Theme.font-ui; horizontal-alignment: center; color: root.on ? Theme.accent : Theme.muted; }
        if root.hint != "" : Text { text: root.hint; font-size: 8px; color: Theme.faint; horizontal-alignment: center; font-family: Theme.font-ui; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component StatusChip inherits Rectangle {
    // .sb - a status-bar card as a clickable chip: optional lamp, 9px key, 11px value, dim detail; right border
    in property <string> key;
    in property <string> value;
    in property <string> detail;
    in property <color> value-color: Theme.fg;
    in property <LampState> lamp: LampState.off;
    in property <bool> show-lamp;
    callback clicked;
    height: 28px;
    Rectangle { x: parent.width - 1px; width: 1px; height: parent.height; background: Theme.line; }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: start;
        if root.show-lamp : Lamp { state: root.lamp; caption: ""; }
        Text { text: root.key; font-size: 9px; font-weight: 600; letter-spacing: 0.7px; color: Theme.dim; font-family: Theme.font-ui; vertical-alignment: center; }
        Text { text: root.value; font-size: 11px; font-weight: 600; color: root.value-color; font-family: Theme.font-ui; vertical-alignment: center; }
        if root.detail != "" : Text { text: root.detail; font-size: 12px; color: Theme.dim; font-family: Theme.font-ui; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component VLine inherits Rectangle {
    // the 1px x 72px dividers between receiver-strip groups
    width: 1px; height: 72px; background: Theme.line;
}
