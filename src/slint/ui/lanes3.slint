// lanes3.slint - SCREEN LANE S3 (docs/multi-radio-records/screen-s3-recplay.md): the recording and playback controls, drawn with lane K's row panel (KPanel). The host (lanes3_publish.cpp) builds
// the rows from the engine's facts and answers `act(id, text)`; an empty list draws nothing.
import { KRow } from "system_bank.slint";
import { Theme } from "theme.slint";

export global LaneS3 {
    in property <[KRow]> rows-record;      // SIGNAL, Recorder: file names, sample formats, the passband take, rollover, triggered clips, the replay buffer
    in property <[KRow]> rows-schedule;    // SIGNAL, Recorder: the timed recordings
    in property <[KRow]> rows-play;        // SIGNAL, Source: the position and the seek slider (a list of their own: they change every tick)
    in property <[KRow]> rows-source;      // SIGNAL, Source: where in the recording, the loop, a raw file's stated format, the whole-file waterfall
    in property <image> overview;           // SIGNAL, Source: the whole-file waterfall
    in property <bool> overview-visible: false;
    in property <string> overview-caption;
    callback act(string, string);
}

// The whole-file waterfall: time down the page, frequency across (G3-14b). Drawn only once a picture has been made.
export component S3Overview inherits Rectangle {
    height: LaneS3.overview-visible ? 240px : 0px;
    visible: LaneS3.overview-visible;
    Image {
        source: LaneS3.overview;
        width: parent.width;
        height: parent.height - 18px;
        image-fit: fill;
        accessible-role: image;
        accessible-label: @tr("Whole-file waterfall");
        accessible-description: LaneS3.overview-caption;
    }
    Text { y: parent.height - 16px; width: parent.width; text: LaneS3.overview-caption; font-size: 11px; color: Theme.dim; overflow: elide; }
}
