// FoxSDR Slint front end - THE SYSTEM BANK'S BODIES (phase 3, bank 2 of 4): the open bodies under the SYSTEM rows - Display, Language & country, Updates,
// Serial ports (with the shared GPS row), Key bindings, Diagnostics, Usage reporting, Beta tester - and the two report pages, Request a feature and
// Report a bug or dislike (one component, kind-driven). The design: specs/SCREENS.md A5 / A5b (the column and the closed sections' contents) and F1 (the
// pages), artboards/Workbench-Banks.dc.html (the SYSTEM column) and Workbench-Dialogs.dc.html (the two pages); the parity list is
// inventory/extend-system-store-patch.txt (lines 287-1380); the wording is the ImGui window's (aw = app_window.cpp drawDiagnosticsSection and the sections
// before it, app_window_language.cpp, app_window_report.cpp), so the catalogue entries apply for free.
//
// THE PATTERN IS THE SIGNAL BANK'S (signal_bank.slint): this file declares the structs the host fills, one global of every gesture (SystemEvents) and the
// bodies; each body is a VerticalLayout the Section's fold shows (the bank column's width less the Section's padding: 254 px), and every callback of a body
// forwards to the global unless the instance overrides it (the specimen does, to count them). The host owns every value: a tick shows the model's value
// and a click asks (`toggled(v)`, `picked(i)`, `committed(t)`); the model changes when the host has done it or refused it.
//
// THE PIECES ARE COPIED, NOT SHARED. signal_bank.slint keeps its small pieces (Line, Note, Tick, LineInput, DropKey, SliderRow, the sheet frame) private, so
// this file carries the same ones under the same names, with the few additions the SYSTEM bodies need: a filter field in a dropdown's list (the Country
// list), a masked LineInput (the tester code), a multi-line TextBox (the report pages). `SelectItem` is the SIGNAL bank's, imported.
//
// THE KEY CAPTURE. A key cap is a pill of ONE width (112 px, mono 9 px). A click asks `keys-capture(id)`; the host sets that row's `capturing` and the cap
// takes the keyboard focus, shows "Press a key..." and turns the next key event into the chord text the config stores ("Ctrl+Shift+PageUp": the modifiers
// in the order Ctrl, Shift, Alt, then the key's name from src/gui/key_bindings.cpp) and calls `keys-captured(id, chord)`. Esc leaves (keys-cancel),
// Backspace clears (keys-clear(id)); a click on the listening cap, or the focus going elsewhere, leaves it too. A modifier key alone is not a chord: the cap
// goes on listening.
//
// Rows are 24 px (Theme.field-h) with 6 px between them, the artboard's .rw and .sbd gap. Nothing here asks for more than the column: texts wrap or elide,
// rows give their width away (rule 11; tests/test_slint_system.cpp measures it).
import { Theme } from "theme.slint";
import { Chip, ChipTone } from "chips.slint";
import { Caption, Key, KeyNames, KeyFocus } from "keys.slint";
import { Checkbox } from "fields.slint";
import { Slider } from "sliders.slint";
import { SelectKey } from "sections.slint";
import { TipTimer, ElidedHint } from "tooltip.slint";
import { SelectItem } from "signal_bank.slint";

// The models. The contract's fields come first in each; the ADDED ones are the ImGui window's own words and states that the contract left out (the host,
// system_logic.hpp, already carries most of them under these names). A host label that is "" falls back to the body's own @tr word.
export struct DisplayModel {
    scales: [SelectItem], scale-index: int, themes: [SelectItem], theme-index: int,
    db-min: float, db-min-text: string, db-max: float, db-max-text: string,                  // db-min / db-max: 0..1 of the slider's track; the text is the host's figure
    freq-displays: [SelectItem], freq-display-index: int, figures: [SelectItem], figures-index: int,
    tuner-switches: bool, enlarge-readings: bool,
    high-contrast: bool,                                                                      // slint-gaps.md item 11: the high-contrast skin is chosen (it is also forced on while Windows' own setting is on)
    digit-groupings: [SelectItem], digit-grouping-index: int,                                // the counter's dots: 1.090.000.000 or 1090.000.000 (slint-gaps.md item 2)
    icon-px: float, icon-text: string, trail-px: float, trail-text: string,                  // 0..1 and the host's "48 px"
    trail-styles: [SelectItem], trail-style-index: int,                                      // Line, Ribbon (mapTrailStyle; docs 6.52)
    band-plan: bool, band-sizes: [SelectItem], band-size-index: int, band-colours: [SelectItem], band-colour-index: int,
    regions: [SelectItem], region-index: int, plan-status: string, plan-status-tone: ChipTone,
    region-preview: string,                            // ADDED: the Region box's closed text (the plan's name, or "(all installed)" while region-index is -1)
    scale-tooltip: string, switches-tooltip: string, icon-tooltip: string, trail-tooltip: string,   // ADDED: the ImGui hints (translated)
}

export struct LanguageModel {
    languages: [SelectItem], language-index: int, machine-hint: string,
    suggest-label: string,                             // "USE DEUTSCH": the key that switches to the country's language; "" hides it (callback language-suggest)
    countries: [SelectItem], country-index: int, country-filter: string,
    country-hint: string,                              // the filter field's placeholder ("Type to narrow the list")
    plan-line: string,                                 // ADDED: "Band plan: United Kingdom" (the plan the country implies); "" none
    plan-changed-hint: string,                         // ADDED: "This overrides the current band plan"
    translation-label: string,                         // ADDED: "SUGGEST A BETTER TRANSLATION", shown with the machine hint (callback language-translation)
    language-text: string, country-text: string,       // ADDED: the two boxes' closed texts (the chosen row may be filtered out of the list: country-index -1)
}

export struct UpdatesModel {
    check-at-startup: bool, channel-index: int,        // 0 stable, 1 beta
    channel-help: string, privacy: string, version-line: string, team-message: string, status-line: string, status-tone: ChipTone,
    check-label: string, stable-label: string, beta-label: string,   // ADDED: the host's words for the tick and the two radios
    packaged: bool,                                    // ADDED: a Microsoft Store copy has no channel radios and no help
    show-again: bool, show-again-label: string,        // ADDED: the small "Show it again" key (offered while an update is offered and its banner was dismissed)
    withdrawn-advice: string,                          // ADDED (docs 6.63): the kill switch - what to do about a withdrawn copy, under the amber status line
    site-label: string, dismiss-label: string,         // ADDED: "Open foxsdr.com" and "Not now", only while no fixed build is offered yet
}

export struct GpsRow {
    ports: [SelectItem], port-index: int, bauds: [SelectItem], baud-index: int, listening: bool, key-label: string, status: string, status-tone: ChipTone,
    satellites: string,
    key-enabled: bool,                                 // ADDED: the key is live (a port is named, or a read is running: Stop)
    refusal: string,                                   // ADDED: the GPS fix the position rule refused (the amber line under the status)
}

export struct SerialPortsModel {
    intro: string, empty-line: string, ports: [string], gps: GpsRow, gps-note: string,
    refresh-label: string, column-label: string, gps-heading: string,   // ADDED: "Refresh", "Port", "GPS receiver"
    gps-hint: string,                                  // ADDED: "or read it from a GPS receiver on a serial port:" (under the rule)
}

export struct KeyRow { id: string, action: string, chord: string, capturing: bool, clash: string }
export struct KeyGroup { heading: string, rows: [KeyRow] }
export struct KeyBindingsModel {
    help: string, reset-label: string, groups: [KeyGroup], footer: string, changed: bool,
    prompt: string,                                    // ADDED: what a listening cap says ("Press a key...")
}

export struct DiagnosticsModel {
    explanation: string, record: bool, what-open: bool, what-text: string, minidump: bool, log-path: string, reports-path: string,
    offer: string,                                     // the "did not close normally last time" sentence while the offer is due (an amber note on top); "" none
    record-label: string, minidump-label: string, what-label: string,   // ADDED: the host's words for the two ticks and the disclosure key
    sent-text: string,                                 // ADDED: "Sent: ... NEVER sent: ... Off means off: ..." (under the Record tick)
    dump-note: string,                                 // ADDED: "A memory dump can contain file names..." (under the dump tick)
    ledger: bool, ledger-note: string,                 // ADDED: "Show the pointer ledger across the top of the window" and its help
    bundle-status: string,                             // ADDED: the line under Copy diagnostics ("Copied to the clipboard.")
    sdrplay-text: string,                              // ADDED: "For SDRplay owners: ..." ; "" hides the whole SDRplay block
    sdrplay-enabled: bool, sdrplay-status: string,     // ADDED: the Run key's state, and its status / "FoxSDR has the SDRplay radio open" line
}

export struct UsageModel {
    disclosure: string, send: bool, install-id-line: string, what-label: string, privacy-label: string, payload: [string], what-open: bool, what-text: string,
    state-line: string, send-label: string,            // ADDED: the sentence under the tick ("Off. Nothing is transmitted.") and the tick's own words
}

export struct TesterModel {
    shown: bool, explanation: string, linked-line: string, code-line: string, invalid-line: string, code-draft: string, use-label: string,
    sent-open: bool, sent-preview: string,
    field-shown: bool,                                 // ADDED: the code box and its key (no app token, and no token or an invalid one)
    error-line: string,                                // ADDED: "that does not look like a tester code or link"
    sent-text: string,                                 // ADDED: the "What is sent" sentence
    field-label: string, unlink-label: string, remove-label: string, show-label: string, hide-label: string,   // ADDED: the host's words
}

export struct ReportPageModel {
    shown: bool, kind: int, title: string, text: string, attach: bool,
    attach-note: string,                               // the "what is sent" sentence (by contact and by log), above SEND
    evidence: [string], preview-open: bool, preview-text: string,
    send-enabled: bool, refusal: string, no-email-note: string, sent-line: string,
    sent-tone: ChipTone,                               // ADDED: the tone of `sent-line` (sending amber, sent green, failed red)
    prompt: string,                                    // ADDED: the question over the box (the host words it by kind and by what is chosen); "" = the kind's own
    counter: string,                                   // ADDED: "0 / 100000 characters"
    contact: string, contact-label: string,            // ADDED: the optional email or callsign and its caption
    kind-question: string, problem-kinds: [SelectItem], problem-kind-index: int,   // ADDED: the bug page's "What are you reporting?" radios (-1: neither chosen)
    recognised-line: string,                           // ADDED: the green "A report was recognised and attached as ..." line
    probe-shown: bool, probe-on: bool, probe-label: string,   // ADDED: "Attach the SDRplay diagnostic too" (offered only after a probe ran)
    attach-label: string, preview-label: string, send-label: string,   // ADDED: the host's words for the two ticks and the key
    local-only-line: string,                           // ADDED: the newest report's reason and where its file is (while the preview is open)
}

// EVERY GESTURE OF THE BODIES, as one global the host wires (ui->global<SystemEvents>().on_...). Index arguments are positions in the model's lists.
export global SystemEvents {
    callback display-scale(int);
    callback display-theme(int);
    callback display-db-min(float);                // 0..1
    callback display-db-max(float);
    callback display-freq-display(int);
    callback display-figures(int);
    callback display-digit-grouping(int);
    callback display-high-contrast(bool);
    callback display-tuner-switches(bool);
    callback display-enlarge(bool);
    callback display-icon-px(float);               // 0..1
    callback display-trail-px(float);
    callback display-trail-style(int);
    callback display-band-plan(bool);
    callback display-band-size(int);
    callback display-band-colour(int);
    callback display-region(int);
    callback language-selected(int);
    callback language-suggest();                   // USE <LANGUAGE>: switch to the country's language
    callback language-translation();               // ADDED: SUGGEST A BETTER TRANSLATION (opens the bug page with the box prefilled)
    callback country-filter(string);               // each edit of the filter field; "" when a country is picked (the list is whole again)
    callback country-selected(int);                // a position in `countries` as the host last published it (row 0 is "Not set" when the filter is empty)
    callback updates-check(bool);
    callback updates-channel(int);
    callback updates-team-message();
    callback updates-show-again();                 // ADDED: the small "Show it again" key
    callback updates-open-site();                  // ADDED (docs 6.63): "Open foxsdr.com" on the withdrawn notice
    callback updates-withdrawn-dismiss();          // ADDED: "Not now" on the withdrawn notice
    callback serial-refresh();
    callback gps-port(int);
    callback gps-baud(int);
    callback gps-toggle();
    callback keys-reset();
    callback keys-capture(string);                 // the row's id: its cap was pressed
    callback keys-captured(string, string);        // the id and the chord text: "Ctrl+Shift+PageUp"
    callback keys-cancel();
    callback keys-clear(string);                   // the id: Backspace on the listening cap
    callback diag-record(bool);
    callback diag-minidump(bool);
    callback diag-what(bool);
    callback diag-open-log();
    callback diag-open-reports();
    callback diag-ledger(bool);                    // ADDED: the pointer-ledger tick
    callback diag-copy();                          // ADDED: Copy diagnostics
    callback diag-sdrplay();                       // ADDED: Run SDRplay diagnostic
    callback usage-send(bool);
    callback usage-what(bool);
    callback usage-privacy();
    callback tester-unlink();
    callback tester-remove-code();
    callback tester-code-committed(string);
    callback tester-use();
    callback tester-show-sent(bool);
    callback report-open(int);                     // 0 feature, 1 bug: the main window's keys call it; the page itself never does
    callback report-text(string);                  // each edit of the message box
    callback report-contact(string);               // ADDED: each edit of the contact field
    callback report-kind(int);                     // ADDED: a position in `problem-kinds` (the bug page's two radios)
    callback report-attach(bool);
    callback report-probe(bool);                   // ADDED: "Attach the SDRplay diagnostic too"
    callback report-preview(bool);
    callback report-send();
    callback report-closed();
    callback about-open();
}

// ================================================ the pieces the bodies are made of ================================================

// The label of an item of a list, "" when the index is off the list (the closed text of a dropdown).
global Pick {
    pure public function label(items: [SelectItem], i: int) -> string {
        return i >= 0 && i < items.length ? items[i].label : "";
    }
}

// A row of a body: 24 px (.rw min-height), the children side by side 8 px apart.
component Line inherits Rectangle {
    in property <length> gap: 8px;
    height: max(Theme.field-h, line-row.preferred-height);   // a label that wraps (docs 6.62) makes the row taller by its second line; with one line the row is the 24 px it always was
    line-row := HorizontalLayout {
        spacing: root.gap;
        @children
    }
}

// Keeps a fixed-height child (a 20 px key, a 14 px box) in the middle of a Line.
component Mid inherits VerticalLayout {
    alignment: center;
}

// A sentence of a body: 11 px, wrapped, dim unless a tone says otherwise (the sheet's .n, .n.am, .n.rd, .n.gn).
component Note inherits Text {
    in property <ChipTone> tone: ChipTone.neutral;
    min-width: 0px;
    wrap: word-wrap;
    font-family: Theme.font-ui;
    font-size: Theme.font-small;
    color: root.tone == ChipTone.err ? Theme.chip-err-fg
         : root.tone == ChipTone.warn ? Theme.chip-warn-fg
         : root.tone == ChipTone.good ? Theme.chip-good-fg
         : Theme.dim;
}

// Mono text that may break anywhere (a path, an id, a payload line): dim, 11 px.
component MonoNote inherits Text {
    min-width: 0px;
    wrap: char-wrap;
    font-family: Theme.font-mono;
    font-size: Theme.font-small;
    color: Theme.dim;
}

// The .lb label of a row: 11 px / 500, fg-soft, elided before it can widen the row, and the tip says it when it was (docs 6.62). Wrapping it was tried and measured: the Display block's
// "Frequency display" took a second line in English and the rows below it moved, against the artboard's 24 px rows (test_slint_system), so the row keeps its height and the label its tip.
component RowLabel inherits ElidedHint {
    horizontal-stretch: 0;   // a Text asks for none; a Rectangle would ask for 1 and take room from the field beside it
    ink: Theme.fg-soft;
    font-size: Theme.font-small;
    font-weight: Theme.weight-medium;
}

// A figure of a row: the mono 11 px readout.
component Readout inherits Text {
    min-width: 0px;
    overflow: elide;
    font-family: Theme.font-mono;
    font-size: Theme.font-small;
    color: Theme.fg;
    vertical-alignment: center;
}

// The .ck checkbox, driven by the host's value: the Checkbox keeps its own `checked` after a press, so the model's value is pushed back into it every
// time the user presses and every time the model changes (a refusal leaves the box where it was).
component Tick inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback toggled(bool);

    in property <length> row-h: Theme.field-h;          // the row it sits in: the box is centred in it (a longer label makes the row taller)
    height: max(root.row-h, box.height);
    min-width: 0px;
    preferred-width: box.preferred-width;
    changed on => { box.checked = root.on; }
    box := Checkbox {
        x: 0px;
        y: (root.height - self.height) / 2;
        width: root.width;
        label: root.label;
        checked: root.on;
        enabled: root.enabled;
        tooltip: root.tooltip;
        toggled(v) => {
            root.toggled(v);
            box.checked = root.on;
        }
    }
}

// A radio button (the update channel): 14 px ring, the accent dot when chosen.
component RadioChoice inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback chosen();

    height: Theme.field-h;                              // the row it sits in: the ring is centred in it
    min-width: 0px;
    preferred-width: 14px + 8px + words.preferred-width;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.chosen(); } }

    Rectangle {
        x: 0px;
        y: (root.height - 14px) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        border-width: Theme.hairline;
        background: !root.enabled ? Theme.key-disabled-bg : root.on ? Theme.accent : Theme.field;
        border-color: !root.enabled ? Theme.line-strong.with-alpha(0.5) : root.on ? Theme.accent : Theme.line-strong;
        if root.on : Rectangle {
            x: 4px;
            y: 4px;
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.enabled ? Theme.accent-ink : Theme.key-disabled-fg;
        }
    }
    words := Text {
        x: 22px;
        y: 0px;
        width: max(0px, root.width - 22px);
        height: root.height;
        text: root.label;
        color: root.enabled ? Theme.fg : Theme.key-disabled-fg;
        font-family: Theme.font-ui;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
    }
    area := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if (root.enabled) { root.chosen(); } }
    }
    TipTimer { x: 0px; y: 0px; hovered: area.has-hover; text: root.tooltip; anchor-h: root.height; }
}

// The one-line input of a body (.in, 24 px): shows `value` (the host's text), commits on Enter and on the focus leaving after an edit. `hidden` masks it (the
// tester code), `edited` reports each keystroke (the Country filter), `grab-focus` takes the keyboard when the field appears (a popup's filter field).
component LineInput inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <bool> mono;
    in property <bool> right;
    in property <bool> enabled: true;
    in property <bool> error;
    in property <bool> hidden;
    in property <bool> grab-focus;
    in property <string> tooltip;
    in property <string> name;                          // the accessible label
    callback committed(string);
    callback edited(string);
    out property <bool> has-focus: input.has-focus;
    out property <string> text: input.text;

    property <length> pad: 8px + Theme.hairline;
    property <bool> dirty;                              // edited since the last commit

    height: Theme.field-h;
    min-width: 0px;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: root.enabled ? (root.error ? Theme.lamp-red : Theme.line-strong) : Theme.line-strong.with-alpha(0.5);
    background: root.enabled ? Theme.field : Theme.key-disabled-bg;

    property <bool> grabbed;                            // `grab-focus` has been served
    init => {
        input.text = root.value;
        if (root.grab-focus) { input.focus(); }
    }
    // a field that appears in a popup has no window to take the keyboard from at its init: it asks once, on the next turn of the
    // event loop. ONE MILLISECOND, NOT THIRTY (docs 6.47): a 30 ms timer still pending while the popup was closed by a second click
    // within a slow frame was torn down with the field during that event and slint_cpp.dll 1.18.1 faulted in Timer::stop
    // (crash-20261109-024408, reproduced by closing the popup one tick after opening it); due on the next loop turn, the timer has
    // fired before any second input can arrive. Focus at init alone does not take in a popup (checked: the typed filter did nothing).
    Timer {
        interval: 1ms;
        running: root.grab-focus && !root.grabbed;
        triggered => {
            input.focus();
            root.grabbed = true;
        }
    }
    changed value => {
        input.text = root.value;
        root.dirty = false;
    }

    area := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => { if (root.enabled) { input.focus(); } }
        if input.text == "" && root.placeholder != "" : Text {
            x: root.pad;
            y: 0px;
            width: max(0px, root.width - 2 * root.pad);
            height: root.height;
            text: root.placeholder;
            color: Theme.disabled;
            font-family: root.mono ? Theme.font-mono : Theme.font-ui;
            font-size: Theme.font-small;
            horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: none;
        }
        input := TextInput {
            x: root.pad;
            y: 0px;
            width: max(0px, root.width - 2 * root.pad);
            height: root.height;
            enabled: root.enabled;
            read-only: !root.enabled;
            single-line: true;
            input-type: root.hidden ? InputType.password : InputType.text;
            color: root.enabled ? Theme.fg : Theme.key-disabled-fg;
            font-family: root.mono ? Theme.font-mono : Theme.font-ui;
            font-size: Theme.font-small;
            horizontal-alignment: root.right ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
            vertical-alignment: center;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-ink;
            accessible-label: root.name;
            edited => {
                root.dirty = true;
                root.edited(self.text);
            }
            accepted => {
                root.dirty = false;
                root.committed(self.text);
            }
            changed has-focus => {
                if (!self.has-focus && root.dirty) {
                    root.dirty = false;
                    root.committed(self.text);
                }
            }
        }
    }
    if input.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-width: 2px;
        border-color: Theme.focus;
        border-radius: Theme.radius + 3px;
    }
    TipTimer { x: 0px; y: 0px; hovered: area.has-hover; text: root.tooltip; anchor-h: root.height; }
}

// The multi-line box of the report pages (.in with a textarea): the host's text, each edit reported, scrolls to the caret when the text outgrows it.
component TextBox inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <string> name;                          // the accessible label
    callback edited(string);
    out property <bool> has-focus: ti.has-focus;
    out property <string> text: ti.text;

    height: 64px;
    min-width: 0px;
    border-radius: Theme.radius;
    border-width: Theme.hairline;
    border-color: Theme.line-strong;
    background: root.enabled ? Theme.field : Theme.key-disabled-bg;

    init => { ti.text = root.value; }
    changed value => {
        if (ti.text != root.value) { ti.text = root.value; }
    }

    TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.text : MouseCursor.default;
        clicked => { if (root.enabled) { ti.focus(); } }
    }
    if ti.text == "" && root.placeholder != "" : Text {
        x: 8px + Theme.hairline;
        y: 5px;
        width: max(0px, root.width - 16px - 2 * Theme.hairline);
        text: root.placeholder;
        color: Theme.disabled;
        font-family: Theme.font-ui;
        font-size: Theme.font-small;
        overflow: elide;
        accessible-role: none;
    }
    fl := Flickable {
        x: 8px + Theme.hairline;
        y: 5px;
        width: root.width - 16px - 2 * Theme.hairline;
        height: root.height - 10px;
        content-width: self.width;
        content-height: max(self.height, ti.preferred-height);
        ti := TextInput {
            x: 0px;
            y: 0px;
            width: fl.width;
            height: max(fl.height, self.preferred-height);
            enabled: root.enabled;
            read-only: !root.enabled;
            single-line: false;
            wrap: word-wrap;
            color: root.enabled ? Theme.fg : Theme.key-disabled-fg;
            font-family: Theme.font-ui;
            font-size: Theme.font-small;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.accent-ink;
            accessible-label: root.name;
            edited => { root.edited(self.text); }
            cursor-position-changed(p) => {
                if (p.y + fl.content-y < 0px) { fl.content-y = -p.y; }
                else if (p.y + 16px + fl.content-y > fl.height) { fl.content-y = fl.height - p.y - 16px; }
            }
        }
    }
    if ti.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-width: 2px;
        border-color: Theme.focus;
        border-radius: Theme.radius + 3px;
    }
}

// One row of a dropdown's list: the tick of the chosen one, the label, the dim note at the right; a greyed row cannot be picked.
component DropRow inherits Rectangle {
    in property <SelectItem> item;
    in property <bool> chosen;
    callback activated();
    height: Theme.menu-item-h;
    border-radius: Theme.radius-menu-item;
    background: root.item.enabled && row-area.has-hover ? Theme.menu-hot : transparent;
    accessible-role: list-item;
    accessible-label: root.item.label;
    accessible-enabled: root.item.enabled;
    accessible-action-default => { if (root.item.enabled) { root.activated(); } }   // a screen reader's (or the scripted input's) pick of this row
    if root.chosen : Image {
        x: 5px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        source: @image-url("icons/check.svg");
        image-fit: contain;
        colorize: Theme.accent;
    }
    Text {
        x: 26px;
        y: 0px;
        width: max(0px, parent.width - 26px - 8px - (root.item.note != "" ? note-text.preferred-width + 8px : 0px));
        height: parent.height;
        text: root.item.label;
        color: root.item.enabled ? Theme.fg : Theme.disabled;
        font-family: Theme.font-ui;
        font-size: Theme.font-body;
        vertical-alignment: center;
        overflow: elide;
    }
    note-text := Text {
        x: parent.width - 8px - self.width;
        y: 0px;
        width: self.preferred-width;
        height: parent.height;
        visible: root.item.note != "";
        text: root.item.note;
        color: Theme.dim;
        font-family: Theme.font-ui;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    row-area := TouchArea {
        mouse-cursor: root.item.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { if (root.item.enabled) { root.activated(); } }
    }
}

// A dropdown: the SelectKey's look and a list of `items` it opens itself under the key. With `filter` the list has a text field above it (the Country list):
// each edit calls `filter-edited(text)`, the host answers with a shorter `items`, and a pick calls `filter-edited("")` so the next opening shows the whole list.
component DropKey inherits Rectangle {
    in property <string> value;                         // the closed text
    in property <[SelectItem]> items;
    in property <int> selected: -1;
    in property <string> label;                         // the accessible name
    in property <bool> enabled: true;
    in property <string> tooltip;
    in property <length> popup-min-w: 150px;
    in property <bool> filter;
    in property <string> filter-value;
    in property <string> filter-placeholder;
    callback picked(int);
    callback filter-edited(string);

    property <length> pad: 4px + Theme.hairline;
    property <length> head-h: root.filter ? Theme.field-h + 6px : 0px;
    property <length> popup-w: max(root.width, root.popup-min-w);
    property <length> list-h: min(root.items.length * Theme.menu-item-h, 330px);
    property <length> popup-h: root.list-h + root.head-h + 2 * root.pad;

    height: Theme.key-sm-h;
    min-width: 0px;
    preferred-width: 110px;

    SelectKey {
        x: 0px;
        y: 0px;
        width: root.width;
        value: root.value;
        label: root.label;
        enabled: root.enabled;
        tooltip: root.tooltip;
        clicked => { if (root.items.length > 0 || root.filter) { popup.show(); } }
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.popup-w;
        height: root.popup-h;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.menu;
            border-width: Theme.hairline;
            border-color: Theme.knob-ring;
            border-radius: Theme.radius-panel;
            drop-shadow-blur: Theme.shadows ? 28px : 0px;
            drop-shadow-offset-y: Theme.shadows ? 10px : 0px;
            drop-shadow-color: Theme.shadows ? Theme.well-deep.with-alpha(0.7) : transparent;
            if root.filter : LineInput {
                x: root.pad;
                y: root.pad;
                width: root.popup-w - 2 * root.pad;
                value: root.filter-value;
                placeholder: root.filter-placeholder;
                name: root.filter-placeholder;
                grab-focus: true;
                edited(t) => { root.filter-edited(t); }
            }
            // a short list is plain rows (a Flickable holds a press back for a moment: the click of a quick pick would be late), a long one scrolls
            if root.items.length * Theme.menu-item-h <= root.list-h : Rectangle {
                x: root.pad;
                y: root.pad + root.head-h;
                width: root.popup-w - 2 * root.pad;
                height: root.list-h;
                for it[i] in root.items : DropRow {
                    x: 0px;
                    y: i * Theme.menu-item-h;
                    width: parent.width;
                    item: it;
                    chosen: i == root.selected;
                    activated => {
                        root.picked(i);
                        if (root.filter) { root.filter-edited(""); }
                        popup.close();
                    }
                }
            }
            if root.items.length * Theme.menu-item-h > root.list-h : Flickable {
                x: root.pad;
                y: root.pad + root.head-h;
                width: root.popup-w - 2 * root.pad;
                height: root.list-h;
                content-width: self.width;
                content-height: root.items.length * Theme.menu-item-h;
                for it[i] in root.items : DropRow {
                    x: 0px;
                    y: i * Theme.menu-item-h;
                    width: root.popup-w - 2 * root.pad;
                    item: it;
                    chosen: i == root.selected;
                    activated => {
                        root.picked(i);
                        if (root.filter) { root.filter-edited(""); }
                        popup.close();
                    }
                }
            }
        }
    }
}

// A slider row: the name (84 px wide here: "Aircraft icons" must not be cut), the slider (8 px of air each side for the knob's overhang), the readout. 24 px.
component SliderRow inherits Rectangle {
    in property <string> label;
    in property <string> readout;
    in property <float> value;                          // 0..1
    in property <bool> enabled: true;
    in property <string> tooltip;
    in property <length> label-w: 84px;
    callback changed(float);
    height: max(Theme.field-h, slider-row-layout.preferred-height);   // a label that wraps (docs 6.62) makes the row taller by its second line
    slider-row-layout := HorizontalLayout {
        spacing: 0px;
        RowLabel { width: root.label-w; text: root.label; ink: root.enabled ? Theme.fg-soft : Theme.disabled; }
        VerticalLayout {
            alignment: center;
            padding-left: 8px;
            padding-right: 8px;
            Slider {
                value: root.value;
                enabled: root.enabled;
                tooltip: root.tooltip;
                accessible-label: root.label;
                changed(v) => { root.changed(v); }
            }
        }
        Readout { width: 56px; text: root.readout; horizontal-alignment: right; color: root.enabled ? Theme.fg : Theme.disabled; }
    }
}

// A centred sheet on a dimmed backdrop (the IA's dialog form, as main.slint's Sheet): fills the element it is placed in; a click on the backdrop dismisses.
component SheetFrame inherits Rectangle {
    in property <string> title;
    in property <length> sheet-w: 440px;
    in property <length> sheet-h: 0px;                  // 0: as high as the content wants
    in property <length> pad: 12px;
    in property <length> gap: 10px;
    callback dismissed();

    background: Theme.backdrop;
    TouchArea { clicked => { root.dismissed(); } }
    panel := Rectangle {
        width: min(root.sheet-w, root.width - 24px);
        height: root.sheet-h > 0px ? min(root.sheet-h, root.height - 24px) : min(content.preferred-height + Theme.win-title-h + 3 * Theme.hairline, root.height - 24px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel;
        border-width: Theme.hairline;
        border-color: Theme.knob-ring;
        border-radius: Theme.radius-panel;
        drop-shadow-blur: Theme.shadows ? 28px : 0px;
        drop-shadow-offset-y: Theme.shadows ? 10px : 0px;
        drop-shadow-color: Theme.shadows ? Theme.well-deep.with-alpha(0.7) : transparent;
        clip: true;
        TouchArea { }   // swallows the click so the backdrop does not dismiss
        // the title strip (.wt): menu ground, a rule under it, the title as a cap, a close key at the right
        Rectangle {
            x: Theme.hairline;
            y: Theme.hairline;
            width: parent.width - 2 * Theme.hairline;
            height: Theme.win-title-h;
            background: Theme.menu;
            Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line-strong; }
            Text {
                x: 12px;
                y: 0px;
                width: max(0px, parent.width - 12px - 40px);
                height: parent.height;
                text: root.title.to-uppercase();
                color: Theme.fg;
                font-family: Theme.font-ui;
                font-size: Theme.font-small;
                font-weight: Theme.weight-semibold;
                letter-spacing: 0.8px;
                vertical-alignment: center;
                overflow: elide;
            }
            Key {
                x: parent.width - 4px - 26px;
                y: (parent.height - 22px) / 2;
                width: 26px;
                height: 22px;
                icon-only: true;
                flat: true;
                icon: @image-url("icons/close.svg");
                icon-size: 12px;
                tooltip: @tr("Close");
                accessible-label: @tr("Close");
                clicked => { root.dismissed(); }
            }
        }
        content := VerticalLayout {
            x: Theme.hairline;
            y: Theme.win-title-h + Theme.hairline;
            width: parent.width - 2 * Theme.hairline;
            height: parent.height - Theme.win-title-h - 2 * Theme.hairline;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: root.pad;
            padding-bottom: root.pad;
            spacing: root.gap;
            alignment: start;
            @children
        }
    }
}

// ================================================ Display ================================================

// LANE B (docs/multi-radio-records/screen-b.md): the waterfall and trace choices, at the foot of the Display body. The host owns every value (a pick asks, the model changes when
// the host has done it); the rows are appended, so the rows above keep their places.
export global SpectrumLook {
    in property <[SelectItem]> palettes;   in property <int> palette-index;     // S7 colour maps
    in property <[SelectItem]> speeds;     in property <int> speed-index;       // S10 line speed
    in property <[SelectItem]> stamps;     in property <int> stamp-index;       // S8 time stamps: age, UTC, local
    in property <[SelectItem]> traces;     in property <int> trace-index;       // normal, peak hold, average, persistence, min hold
    in property <[SelectItem]> shapes;     in property <int> shape-index;       // S6 line, filled, bars
    in property <[SelectItem]> peak-counts; in property <int> peak-index;       // S20 peak labels: off, 3, 5, 8
    in property <[SelectItem]> zooms;      in property <int> zoom-index;        // S25 band zoom: the full span, bands over the picture, the tuned frequency
    in property <bool> snr;                // S14
    in property <bool> channel-power;      // Q2
    in property <bool> tracker;            // Q3
    in property <bool> history;            // S15
    in property <bool> reference-shown;    // S22
    in property <bool> reference-set;
    in property <bool> compact;            // S26
    in property <string> status;
    callback palette-picked(int);
    callback speed-picked(int);
    callback stamps-picked(int);
    callback trace-picked(int);
    callback shape-picked(int);
    callback peaks-picked(int);
    callback zoom-picked(int);
    callback snr-toggled(bool);
    callback channel-power-toggled(bool);
    callback tracker-toggled(bool);
    callback history-toggled(bool);
    callback reference-save();
    callback reference-toggled(bool);
    callback reference-clear();
    callback history-save();
    callback compact-toggled(bool);
}

// ================================================ SCREEN LANE K (docs/multi-radio-records/screen-k.md) ================================================
// ONE generic row panel for every body lane K adds (Settings and backup, Performance, Accessibility, Community, Spectrum tools) and for the sheets (the first-run
// setup, the confirmations, the cursor tool, the gradient editor). The host (lanek_publish.cpp) builds the rows - each one a kind, an id, a label, a value - and answers
// `act(id, text)`, so a row added by the lane costs C++ and no .slint recompile. Labels arrive already translated (cascade::i18n::tr in the host); the few words this file
// itself draws are @tr. The kinds: 0 heading, 1 note (wrapped; tone 0 dim, 1 warn, 2 error, 3 good), 2 key, 3 tick, 4 choice list (the options, `pick` = the chosen one),
// 5 text field, 6 readout (label and figure), 7 slider (`level` 0..1, `value` its readout), 8 level bar (`level` 0..1, `value` its readout).
export struct KRow { kind: int, id: string, label: string, value: string, note: string, on: bool, enabled: bool, options: [string], pick: int, level: float, tone: int }

export global LaneK {
    in property <[KRow]> rows-backup;
    in property <[KRow]> rows-perf;
    in property <[KRow]> rows-access;
    in property <[KRow]> rows-community;
    in property <[KRow]> rows-spectrum;
    in property <[KRow]> rows-display;
    in-out property <bool> sheet-open;
    in property <string> sheet-title;
    in property <[KRow]> sheet-rows;
    in property <int> sheet-width: 460;               // logical px
    callback act(string, string);
}

export component KPanel inherits VerticalLayout {
    in property <[KRow]> rows;
    callback act(string, string);
    spacing: 6px;
    alignment: start;
    for r[i] in root.rows : VerticalLayout {
        spacing: 3px;
        if r.kind == 0 : Text { text: r.label; font-family: Theme.font-ui; font-size: Theme.font-small; font-weight: Theme.weight-semibold; color: Theme.fg; wrap: word-wrap; accessible-role: text; }
        if r.kind == 1 : Note { text: r.label; tone: r.tone == 1 ? ChipTone.warn : r.tone == 2 ? ChipTone.err : r.tone == 3 ? ChipTone.good : ChipTone.neutral; }
        if r.kind == 2 : Line {
            Mid { Key { label: r.label; enabled: r.enabled; on: r.on; tooltip: r.note; xs: true; clicked => { root.act(r.id, ""); } } }
            Rectangle { horizontal-stretch: 1; }
        }
        if r.kind == 3 : Line { Tick { horizontal-stretch: 1; label: r.label; on: r.on; enabled: r.enabled; tooltip: r.note; toggled(v) => { root.act(r.id, v ? "1" : "0"); } } }
        if r.kind == 4 : VerticalLayout {
            spacing: 2px;
            Line { RowLabel { text: r.label; } }
            for o[j] in r.options : RadioChoice { label: o; on: j == r.pick; enabled: r.enabled; tooltip: r.note != "" ? r.note : o; chosen => { root.act(r.id, "\{j}"); } }
        }
        if r.kind == 5 : VerticalLayout {
            spacing: 2px;
            Line { RowLabel { text: r.label; } }
            LineInput { value: r.value; enabled: r.enabled; name: r.label; tooltip: r.note; mono: true; committed(t) => { root.act(r.id, t); } }
        }
        if r.kind == 6 : Line {
            RowLabel { text: r.label; width: 120px; }
            Readout { horizontal-stretch: 1; text: r.value; horizontal-alignment: right; accessible-role: text; accessible-label: r.label; accessible-description: r.value; }
        }
        if r.kind == 7 : SliderRow { label: r.label; readout: r.value; value: r.level; enabled: r.enabled; tooltip: r.note; changed(v) => { root.act(r.id, "\{v}"); } }
        if r.kind == 8 : Line {
            RowLabel { text: r.label; width: 84px; }
            Rectangle {
                horizontal-stretch: 1;
                height: 8px; y: (Theme.field-h - 8px) / 2;
                background: Theme.field; border-radius: 2px;
                Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * max(0.0, min(1.0, r.level)); border-radius: 2px; background: Theme.accent; }
            }
            Readout { width: 64px; text: r.value; horizontal-alignment: right; }
        }
    }
}

export component DisplayBody inherits VerticalLayout {
    in property <DisplayModel> model;

    callback display-scale(int);
    display-scale(a) => { SystemEvents.display-scale(a); }
    callback display-theme(int);
    display-theme(a) => { SystemEvents.display-theme(a); }
    callback display-db-min(float);
    display-db-min(a) => { SystemEvents.display-db-min(a); }
    callback display-db-max(float);
    display-db-max(a) => { SystemEvents.display-db-max(a); }
    callback display-freq-display(int);
    display-freq-display(a) => { SystemEvents.display-freq-display(a); }
    callback display-figures(int);
    display-figures(a) => { SystemEvents.display-figures(a); }
    callback display-digit-grouping(int);
    display-digit-grouping(a) => { SystemEvents.display-digit-grouping(a); }
    callback display-high-contrast(bool);
    display-high-contrast(a) => { SystemEvents.display-high-contrast(a); }
    callback display-tuner-switches(bool);
    display-tuner-switches(a) => { SystemEvents.display-tuner-switches(a); }
    callback display-enlarge(bool);
    display-enlarge(a) => { SystemEvents.display-enlarge(a); }
    callback display-icon-px(float);
    display-icon-px(a) => { SystemEvents.display-icon-px(a); }
    callback display-trail-px(float);
    display-trail-px(a) => { SystemEvents.display-trail-px(a); }
    callback display-trail-style(int);
    display-trail-style(a) => { SystemEvents.display-trail-style(a); }
    callback display-band-plan(bool);
    display-band-plan(a) => { SystemEvents.display-band-plan(a); }
    callback display-band-size(int);
    display-band-size(a) => { SystemEvents.display-band-size(a); }
    callback display-band-colour(int);
    display-band-colour(a) => { SystemEvents.display-band-colour(a); }
    callback display-region(int);
    display-region(a) => { SystemEvents.display-region(a); }

    spacing: 6px;
    alignment: start;

    // <content>
    Line {
        RowLabel { text: @tr("Interface size"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: Pick.label(root.model.scales, root.model.scale-index);
            items: root.model.scales;
            selected: root.model.scale-index;
            label: @tr("Interface size");
            popup-min-w: 200px;
            tooltip: root.model.scale-tooltip;
            picked(i) => { root.display-scale(i); }
        }
    }
    Line {
        RowLabel { text: @tr("Theme"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: Pick.label(root.model.themes, root.model.theme-index);
            items: root.model.themes;
            selected: root.model.theme-index;
            label: @tr("Theme");
            popup-min-w: 200px;
            picked(i) => { root.display-theme(i); }
        }
    }
    SliderRow { label: @tr("Min dB"); readout: root.model.db-min-text; value: root.model.db-min; changed(v) => { root.display-db-min(v); } }
    SliderRow { label: @tr("Max dB"); readout: root.model.db-max-text; value: root.model.db-max; changed(v) => { root.display-db-max(v); } }
    Line {
        RowLabel { text: @tr("Frequency display"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: Pick.label(root.model.freq-displays, root.model.freq-display-index);
            items: root.model.freq-displays;
            selected: root.model.freq-display-index;
            label: @tr("Frequency display");
            picked(i) => { root.display-freq-display(i); }
        }
    }
    Line {
        RowLabel { text: @tr("Counter figures"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: Pick.label(root.model.figures, root.model.figures-index);
            items: root.model.figures;
            selected: root.model.figures-index;
            label: @tr("Counter figures");
            picked(i) => { root.display-figures(i); }
        }
    }
    Line {
        Tick {
            horizontal-stretch: 1;
            label: @tr("Tuner switches");
            on: root.model.tuner-switches;
            tooltip: root.model.switches-tooltip;
            toggled(v) => { root.display-tuner-switches(v); }
        }
    }
    Line { Tick { horizontal-stretch: 1; label: @tr("Enlarge every reading"); on: root.model.enlarge-readings; toggled(v) => { root.display-enlarge(v); } } }
    SliderRow {
        label: @tr("Aircraft icons");
        readout: root.model.icon-text;
        value: root.model.icon-px;
        tooltip: root.model.icon-tooltip;
        changed(v) => { root.display-icon-px(v); }
    }
    SliderRow {
        label: @tr("Trail width");
        readout: root.model.trail-text;
        value: root.model.trail-px;
        tooltip: root.model.trail-tooltip;
        changed(v) => { root.display-trail-px(v); }
    }
    // the trail style (docs 6.52, tick row 364): the classic map page's Line / Ribbon combo, here under the width it goes with
    Line {
        RowLabel { text: @tr("Trail style"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: Pick.label(root.model.trail-styles, root.model.trail-style-index);
            items: root.model.trail-styles;
            selected: root.model.trail-style-index;
            label: @tr("Trail style");
            popup-min-w: 110px;
            tooltip: @tr("How the aircraft trails are drawn on the maps and the radar scope: a line, or a ribbon that covers more of the map under it.");
            picked(i) => { root.display-trail-style(i); }
        }
    }
    Line { Tick { horizontal-stretch: 1; label: @tr("Band plan"); on: root.model.band-plan; toggled(v) => { root.display-band-plan(v); } } }
    if root.model.band-plan : Line {
        gap: 6px;
        DropKey {
            horizontal-stretch: 1;
            value: Pick.label(root.model.band-sizes, root.model.band-size-index);
            items: root.model.band-sizes;
            selected: root.model.band-size-index;
            label: @tr("Size");
            popup-min-w: 110px;
            picked(i) => { root.display-band-size(i); }
        }
        DropKey {
            horizontal-stretch: 1;
            value: Pick.label(root.model.band-colours, root.model.band-colour-index);
            items: root.model.band-colours;
            selected: root.model.band-colour-index;
            label: @tr("Colour");
            popup-min-w: 110px;
            picked(i) => { root.display-band-colour(i); }
        }
    }
    if root.model.band-plan && root.model.regions.length > 1 : Line {
        RowLabel { text: @tr("Region"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: root.model.region-preview != "" ? root.model.region-preview : Pick.label(root.model.regions, root.model.region-index);
            items: root.model.regions;
            selected: root.model.region-index;
            label: @tr("Region");
            popup-min-w: 220px;
            picked(i) => { root.display-region(i); }
        }
    }
    if root.model.band-plan && root.model.plan-status != "" : Note { text: root.model.plan-status; tone: root.model.plan-status-tone; }
    Line {
        RowLabel { text: @tr("Digit grouping"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: Pick.label(root.model.digit-groupings, root.model.digit-grouping-index);
            items: root.model.digit-groupings;
            selected: root.model.digit-grouping-index;
            label: @tr("Digit grouping");
            tooltip: @tr("How the tuned-frequency counter and the typed frequency group their digits. Typing a frequency accepts either style.");
            picked(i) => { root.display-digit-grouping(i); }
        }
    }
    Line {
        Tick {
            horizontal-stretch: 1;
            label: @tr("High contrast");
            on: root.model.high-contrast;
            tooltip: @tr("Black grounds, white lines and text, one yellow accent. It is also used whenever Windows' own high-contrast setting is on.");
            toggled(v) => { root.display-high-contrast(v); }
        }
    }
    // LANE B: the waterfall and the trace (SpectrumLook above)
    Line {
        RowLabel { text: @tr("Colour map"); horizontal-stretch: 1; }
        DropKey { width: 150px; value: Pick.label(SpectrumLook.palettes, SpectrumLook.palette-index); items: SpectrumLook.palettes; selected: SpectrumLook.palette-index; label: @tr("Colour map");
            popup-min-w: 170px; tooltip: @tr("The colours of the waterfall and its strength key. The Blue-yellow safe map can be told apart by people who confuse red and green."); picked(i) => { SpectrumLook.palette-picked(i); } }
    }
    Line {
        RowLabel { text: @tr("Waterfall speed"); horizontal-stretch: 1; }
        DropKey { width: 150px; value: Pick.label(SpectrumLook.speeds, SpectrumLook.speed-index); items: SpectrumLook.speeds; selected: SpectrumLook.speed-index; label: @tr("Waterfall speed");
            popup-min-w: 170px; tooltip: @tr("How fast the waterfall scrolls. A slow line keeps the strongest level of every frame since the last line, so a short signal is not lost."); picked(i) => { SpectrumLook.speed-picked(i); } }
    }
    Line {
        RowLabel { text: @tr("Time stamps"); horizontal-stretch: 1; }
        DropKey { width: 150px; value: Pick.label(SpectrumLook.stamps, SpectrumLook.stamp-index); items: SpectrumLook.stamps; selected: SpectrumLook.stamp-index; label: @tr("Time stamps");
            popup-min-w: 170px; picked(i) => { SpectrumLook.stamps-picked(i); } }
    }
    Line {
        RowLabel { text: @tr("Trace"); horizontal-stretch: 1; }
        DropKey { width: 150px; value: Pick.label(SpectrumLook.traces, SpectrumLook.trace-index); items: SpectrumLook.traces; selected: SpectrumLook.trace-index; label: @tr("Trace");
            popup-min-w: 150px; picked(i) => { SpectrumLook.trace-picked(i); } }
    }
    Line {
        RowLabel { text: @tr("Trace shape"); horizontal-stretch: 1; }
        DropKey { width: 150px; value: Pick.label(SpectrumLook.shapes, SpectrumLook.shape-index); items: SpectrumLook.shapes; selected: SpectrumLook.shape-index; label: @tr("Trace shape");
            popup-min-w: 150px; picked(i) => { SpectrumLook.shape-picked(i); } }
    }
    Line {
        RowLabel { text: @tr("Peak labels"); horizontal-stretch: 1; }
        DropKey { width: 150px; value: Pick.label(SpectrumLook.peak-counts, SpectrumLook.peak-index); items: SpectrumLook.peak-counts; selected: SpectrumLook.peak-index; label: @tr("Peak labels");
            popup-min-w: 150px; tooltip: @tr("Name the strongest signals on the spectrum with their frequency and level."); picked(i) => { SpectrumLook.peaks-picked(i); } }
    }
    Line {
        RowLabel { text: @tr("Band zoom"); horizontal-stretch: 1; }
        DropKey { width: 150px; value: Pick.label(SpectrumLook.zooms, SpectrumLook.zoom-index); items: SpectrumLook.zooms; selected: SpectrumLook.zoom-index; label: @tr("Band zoom");
            popup-min-w: 220px; tooltip: @tr("Frame the spectrum and the waterfall on a band or on the tuned frequency."); picked(i) => { SpectrumLook.zoom-picked(i); } }
    }
    Line { Tick { horizontal-stretch: 1; label: @tr("SNR readout"); on: SpectrumLook.snr; toggled(v) => { SpectrumLook.snr-toggled(v); } } }
    Line { Tick { horizontal-stretch: 1; label: @tr("Channel power"); on: SpectrumLook.channel-power; toggled(v) => { SpectrumLook.channel-power-toggled(v); } } }
    Line { Tick { horizontal-stretch: 1; label: @tr("Frequency tracker"); on: SpectrumLook.tracker; toggled(v) => { SpectrumLook.tracker-toggled(v); } } }
    Line { Tick { horizontal-stretch: 1; label: @tr("Signal history graph"); on: SpectrumLook.history; toggled(v) => { SpectrumLook.history-toggled(v); } } }
    Line { Key { horizontal-stretch: 1; small: true; label: @tr("Save signal history (CSV)"); clicked => { SpectrumLook.history-save(); } } }
    Line { Key { horizontal-stretch: 1; small: true; label: @tr("Save the trace as the reference"); clicked => { SpectrumLook.reference-save(); } } }
    Line { Tick { horizontal-stretch: 1; label: @tr("Show the reference trace"); on: SpectrumLook.reference-shown; toggled(v) => { SpectrumLook.reference-toggled(v); } } }
    Line { Key { horizontal-stretch: 1; small: true; label: @tr("Clear the reference trace"); enabled: SpectrumLook.reference-set; clicked => { SpectrumLook.reference-clear(); } } }
    Line { Tick { horizontal-stretch: 1; label: @tr("Compact window"); on: SpectrumLook.compact; toggled(v) => { SpectrumLook.compact-toggled(v); } } }
    if SpectrumLook.status != "" : Note { text: SpectrumLook.status; }
    KPanel { rows: LaneK.rows-display; act(id, t) => { LaneK.act(id, t); } }   // screen lane K: averaging, the gradient editor and zoom to a selection (an empty list draws nothing)
    // </content>
}

