        DropKey {
            horizontal-stretch: 1;
            value: Pick.label(root.gps.ports, root.gps.port-index);
            items: root.gps.ports;
            selected: root.gps.port-index;
            label: @tr("GPS serial port");
            popup-min-w: 120px;
            picked(i) => { root.gps-port(i); }
