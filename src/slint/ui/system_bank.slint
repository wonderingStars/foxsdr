            label: root.model.translation-label;
            clicked => { root.language-translation(); }
        }
    }
    Line {
        RowLabel { text: @tr("Country"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: root.model.country-text != "" ? root.model.country-text : Pick.label(root.model.countries, root.model.country-index);
            items: root.model.countries;
            selected: root.model.country-index;
            label: @tr("Country");
            popup-min-w: 250px;
            filter: true;
            filter-value: root.model.country-filter;
            filter-placeholder: root.model.country-hint != "" ? root.model.country-hint : @tr("type a country or code");
            picked(i) => { root.country-selected(i); }
            filter-edited(t) => { root.country-filter(t); }
        }
    }
    if root.model.plan-line != "" : Note { text: root.model.plan-line; color: Theme.fg-soft; }
    if root.model.plan-changed-hint != "" : Note { text: root.model.plan-changed-hint; }
    if root.model.suggest-label != "" : Rectangle {
        height: Theme.key-sm-h;
        clip: true;
        Key {
            x: 0px;
            y: 0px;
            width: parent.width;
            small: true;
            label: root.model.suggest-label;
            clicked => { root.language-suggest(); }
        }
    }
    // </content>
}

