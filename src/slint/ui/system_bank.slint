    country-filter(a) => { SystemEvents.country-filter(a); }
    callback country-selected(int);
    country-selected(a) => { SystemEvents.country-selected(a); }

    spacing: 6px;
    alignment: start;

    // <content>
    Line {
        RowLabel { text: @tr("Language"); horizontal-stretch: 1; }
        DropKey {
            width: 150px;
            value: root.model.language-text != "" ? root.model.language-text : Pick.label(root.model.languages, root.model.language-index);
            items: root.model.languages;
            selected: root.model.language-index;
            label: @tr("Language");
