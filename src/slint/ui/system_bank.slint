export component UpdatesBody inherits VerticalLayout {
    in property <UpdatesModel> model;

    callback updates-check(bool);
    updates-check(a) => { SystemEvents.updates-check(a); }
    callback updates-channel(int);
    updates-channel(a) => { SystemEvents.updates-channel(a); }
