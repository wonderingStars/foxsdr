            small: true;
            on: root.gps.listening;
            enabled: root.gps.key-enabled;
            label: root.gps.key-label;
            clicked => { root.gps-toggle(); }
        }
    }
    if root.gps.status != "" : Note { text: root.gps.status; tone: root.gps.status-tone; }
    if root.gps.satellites != "" : Note { text: root.gps.satellites; }
    if root.gps.refusal != "" : Note { text: root.gps.refusal; tone: ChipTone.warn; }
    // </content>
}

export component SerialPortsBody inherits VerticalLayout {
    in property <SerialPortsModel> model;

    callback serial-refresh();
    serial-refresh() => { SystemEvents.serial-refresh(); }
    callback gps-port(int);
    gps-port(a) => { SystemEvents.gps-port(a); }
    callback gps-baud(int);
    gps-baud(a) => { SystemEvents.gps-baud(a); }
    callback gps-toggle();
    gps-toggle() => { SystemEvents.gps-toggle(); }

    spacing: 6px;
    alignment: start;

    // <content>
    if root.model.intro != "" : Note { text: root.model.intro; }
    Line {
        Mid { Key { label: root.model.refresh-label != "" ? root.model.refresh-label : @tr("Refresh"); small: true; min-w: 0px; clicked => { root.serial-refresh(); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.model.ports.length == 0 : Note { text: root.model.empty-line; }
    // the one-column table of the ports (the kit's .tbl look: a frozen heading on the strip ground, 24 px rows with a hairline under each)
    if root.model.ports.length > 0 : VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 22px;
            background: Theme.strip;
            Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line-strong; }
            Text {
                x: 8px;
                width: max(0px, parent.width - 16px);
                height: parent.height;
                text: (root.model.column-label != "" ? root.model.column-label : @tr("Port")).to-uppercase();
                color: Theme.muted;
                font-family: Theme.font-ui;
                font-size: Theme.font-cap;
                font-weight: Theme.weight-semibold;
                letter-spacing: 0.6px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        for p[i] in root.model.ports : Rectangle {
            height: Theme.table-row-h;
            Rectangle { y: parent.height - Theme.hairline; height: Theme.hairline; width: parent.width; background: Theme.line; }
            Text {
                x: 8px;
                width: max(0px, parent.width - 16px);
                height: parent.height - Theme.hairline;
                text: p;
                color: Theme.fg;
                font-family: Theme.font-mono;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    VerticalLayout {
        spacing: 4px;
        Rectangle { height: Theme.hairline; background: Theme.line-strong; }
        Caption { label: root.model.gps-heading != "" ? root.model.gps-heading : @tr("GPS receiver"); }
    }
    if root.model.gps-hint != "" : Note { text: root.model.gps-hint; }
    GpsRowView {
        gps: root.model.gps;
        gps-port(i) => { root.gps-port(i); }
        gps-baud(i) => { root.gps-baud(i); }
        gps-toggle() => { root.gps-toggle(); }
    }
    if root.model.gps-note != "" : Note { text: root.model.gps-note; }
    // </content>
}

// ================================================ Key bindings ================================================

// One key cap: a pill of ONE width for every row (112 px), the chord in mono 9 px, "Press a key..." in the amber tone while listening. See the file header.
component KeyCap inherits Rectangle {
    in property <string> chord;
    in property <bool> capturing;
    in property <string> name;                          // the action, for the accessible label
    in property <string> prompt;                        // what a listening cap says ("" = Press a key...)
    callback pressed();
    callback cancelled();
    callback cleared();
    callback captured(string);

    pure function is-modifier(t: string) -> bool {
        return t == Key.Shift || t == Key.ShiftR || t == Key.Control || t == Key.ControlR || t == Key.Alt || t == Key.AltGr || t == Key.Meta || t == Key.MetaR;
    }

    width: 112px;
    height: Theme.chip-h;
    border-radius: Theme.radius-chip;
    border-width: Theme.hairline;
    background: root.capturing ? Theme.chip-warn-bg : area.has-hover ? Theme.menu-hot : Theme.chip-bg;
    border-color: root.capturing ? Theme.chip-warn-line : Theme.chip-line;
    accessible-role: button;
    accessible-label: root.name + " " + (root.chord == "" ? @tr("None") : root.chord);
    accessible-action-default => { root.pressed(); }

    // The keyboard. The host tells a row it is listening (`capturing`): the cap asks for the keyboard at once, and, being made already listening (the host
    // publishes whole models) with no window to take it from at its init, asks again every 30 ms until it has it. The keyboard going to another place
    // afterwards ends the listening 80 ms later - not at once: the host moves the listening from one row to another in more than one step, and the
    // row it leaves must have been told by then.
    property <bool> armed;                              // the cap has had the keyboard since it began listening
    property <bool> told;                               // the host has been told the cap lost it
    init => { if (root.capturing) { fs.focus(); } }
    changed capturing => {
        root.armed = false;
        root.told = false;
        if (root.capturing) { fs.focus(); }
        else if (fs.has-focus) {
            // THE KEYBOARD GOES BACK TO THE WINDOW'S SHORTCUTS (docs 6.56): a listening cap held the focus, and clearing it left nothing holding it, so no key - the one
            // just bound, the stock ones - was answered until a click gave the focus to something. The window's root FocusScope takes it back (main.slint, KeyFocus).
            fs.clear-focus();
            KeyFocus.released += 1;
        }
    }
    Timer {
        interval: 30ms;
        running: root.capturing && !root.armed && !fs.has-focus;
        triggered => { fs.focus(); }
    }
    Timer {
        interval: 80ms;
        running: root.capturing && root.armed && !fs.has-focus && !root.told;
        triggered => {
            root.told = true;
            root.cancelled();
        }
    }
    fs := FocusScope {
        key-pressed(e) => {
            if (!root.capturing) { return reject; }
            if (e.text == Key.Escape) { root.cancelled(); return accept; }
            if (e.text == Key.Backspace) { root.cleared(); return accept; }
            if (root.is-modifier(e.text)) { return accept; }
            let n = KeyNames.name(e.text);
            if (n == "") { return accept; }
            root.captured((e.modifiers.control ? "Ctrl+" : "") + (e.modifiers.shift || e.text == Key.Backtab ? "Shift+" : "") + (e.modifiers.alt ? "Alt+" : "") + n);   // not-translated: the chord text
            return accept;
        }
        changed has-focus => { if (self.has-focus) { root.armed = true; } }
    }
    Text {
        x: 4px;
        y: 0px;
        width: parent.width - 8px;
        height: parent.height;
        text: root.capturing ? (root.prompt != "" ? root.prompt : @tr("Press a key...")) : root.chord == "" ? @tr("None") : root.chord;
        color: root.capturing ? Theme.chip-warn-fg : root.chord == "" ? Theme.dim : Theme.chip-fg;
        font-family: Theme.font-mono;
        font-size: Theme.font-tiny;
        font-weight: Theme.weight-semibold;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    // the keyboard is on this cap: the focus ring, 1 px clear of the pill
    if fs.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-width: 2px;
        border-color: Theme.focus;
        border-radius: Theme.radius-chip + 3px;
    }
    area := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { if (root.capturing) { root.cancelled(); } else { root.pressed(); } }
    }
}

// One action: its name at the left, the cap at the right; the clash note under it in the rust tone.
component KeyRowView inherits VerticalLayout {
    in property <KeyRow> info;
    in property <string> prompt;
    callback pressed();
    callback cancelled();
    callback cleared();
    callback captured(string);
    spacing: 6px;
    Rectangle {
        height: Theme.field-h;
        HorizontalLayout {
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.info.action;
                color: Theme.fg;
                font-family: Theme.font-ui;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            VerticalLayout {
                alignment: center;
                KeyCap {
                    prompt: root.prompt;
                    name: root.info.action;
                    chord: root.info.chord;
                    capturing: root.info.capturing;
                    pressed => { root.pressed(); }
                    cancelled => { root.cancelled(); }
                    cleared => { root.cleared(); }
                    captured(c) => { root.captured(c); }
                }
            }
        }
    }
    if root.info.clash != "" : Note { text: root.info.clash; tone: ChipTone.err; }
}

export component KeyBindingsBody inherits VerticalLayout {
    in property <KeyBindingsModel> model;

    callback keys-reset();
    keys-reset() => { SystemEvents.keys-reset(); }
    callback keys-capture(string);
    keys-capture(a) => { SystemEvents.keys-capture(a); }
    callback keys-captured(string, string);
    keys-captured(a, b) => { SystemEvents.keys-captured(a, b); }
    callback keys-cancel();
    keys-cancel() => { SystemEvents.keys-cancel(); }
    callback keys-clear(string);
    keys-clear(a) => { SystemEvents.keys-clear(a); }

    spacing: 6px;
    alignment: start;

    // <content>
    if root.model.help != "" : Note { text: root.model.help; }
    for g[gi] in root.model.groups : VerticalLayout {
        spacing: 6px;
        // the heading: the first group's shares its line with the Reset key; the later ones are a thin rule with the heading under it
        if gi == 0 : Line {
            Caption { horizontal-stretch: 1; label: g.heading; vertical-alignment: center; }
            Mid { Key { label: root.model.reset-label; xs: true; clicked => { root.keys-reset(); } } }
        }
        if gi > 0 : VerticalLayout {
            spacing: 4px;
            Rectangle { height: Theme.hairline; background: Theme.line-strong; }
            Caption { label: g.heading; }
        }
        for r in g.rows : KeyRowView {
            info: r;
            prompt: root.model.prompt;
            pressed => { root.keys-capture(r.id); }
            cancelled => { root.keys-cancel(); }
            cleared => { root.keys-clear(r.id); }
            captured(c) => { root.keys-captured(r.id, c); }
        }
    }
    if root.model.footer != "" : Note { text: root.model.footer; }
    // </content>
}

// ================================================ Diagnostics ================================================

export component DiagnosticsBody inherits VerticalLayout {
    in property <DiagnosticsModel> model;

    callback diag-record(bool);
    diag-record(a) => { SystemEvents.diag-record(a); }
    callback diag-minidump(bool);
    diag-minidump(a) => { SystemEvents.diag-minidump(a); }
    callback diag-what(bool);
    diag-what(a) => { SystemEvents.diag-what(a); }
    callback diag-open-log();
    diag-open-log() => { SystemEvents.diag-open-log(); }
    callback diag-open-reports();
    diag-open-reports() => { SystemEvents.diag-open-reports(); }
    callback diag-ledger(bool);
    diag-ledger(a) => { SystemEvents.diag-ledger(a); }
    callback diag-copy();
    diag-copy() => { SystemEvents.diag-copy(); }
    callback diag-sdrplay();
    diag-sdrplay() => { SystemEvents.diag-sdrplay(); }

    spacing: 6px;
    alignment: start;

    // <content>
    if root.model.offer != "" : Note { text: root.model.offer; tone: ChipTone.warn; }
    if root.model.explanation != "" : Note { text: root.model.explanation; }
    Line {
        Tick {
            horizontal-stretch: 1;
            label: root.model.record-label != "" ? root.model.record-label : @tr("Record crashes and freezes, and send the report next time");
            on: root.model.record;
            toggled(v) => { root.diag-record(v); }
        }
    }
    if root.model.sent-text != "" : Note { text: root.model.sent-text; }
    Line {
        Mid { Key { label: root.model.what-label != "" ? root.model.what-label : @tr("What exactly is in a report?"); xs: true; clicked => { root.diag-what(!root.model.what-open); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.model.what-open && root.model.what-text != "" : Note { text: root.model.what-text; }
    Line {
        Tick {
            horizontal-stretch: 1;
            label: root.model.minidump-label != "" ? root.model.minidump-label : @tr("Also write a full memory dump beside a crash report");
            on: root.model.minidump;
            toggled(v) => { root.diag-minidump(v); }
        }
    }
    if root.model.dump-note != "" : Note { text: root.model.dump-note; }
    if root.model.log-path != "" : MonoNote { text: root.model.log-path; }
    if root.model.reports-path != "" : MonoNote { text: root.model.reports-path; }
    Line { Tick { horizontal-stretch: 1; label: @tr("Show the pointer ledger across the top of the window"); on: root.model.ledger; toggled(v) => { root.diag-ledger(v); } } }
    if root.model.ledger-note != "" : Note { text: root.model.ledger-note; }
    Line {
        Mid { Key { label: @tr("Copy diagnostics"); small: true; min-w: 0px; clicked => { root.diag-copy(); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Line {
        Mid { Key { label: @tr("Open reports folder"); small: true; min-w: 0px; clicked => { root.diag-open-reports(); } } }
        Mid { Key { label: @tr("Open the log"); small: true; min-w: 0px; clicked => { root.diag-open-log(); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.model.bundle-status != "" : Note { text: root.model.bundle-status; }
    if root.model.sdrplay-text != "" : Rectangle { height: Theme.hairline; background: Theme.line; }
    if root.model.sdrplay-text != "" : Note { text: root.model.sdrplay-text; }
    if root.model.sdrplay-text != "" : Line {
        Mid { Key { label: @tr("Run SDRplay diagnostic"); small: true; min-w: 0px; enabled: root.model.sdrplay-enabled; clicked => { root.diag-sdrplay(); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.model.sdrplay-text != "" && root.model.sdrplay-status != "" : Note { text: root.model.sdrplay-status; }
    // </content>
}

// ================================================ Usage reporting ================================================

export component UsageBody inherits VerticalLayout {
    in property <UsageModel> model;

    callback usage-send(bool);
    usage-send(a) => { SystemEvents.usage-send(a); }
    callback usage-what(bool);
    usage-what(a) => { SystemEvents.usage-what(a); }
    callback usage-privacy();
    usage-privacy() => { SystemEvents.usage-privacy(); }

    spacing: 6px;
    alignment: start;

    // <content>
    if root.model.disclosure != "" : Note { text: root.model.disclosure; }
    Line { Tick { horizontal-stretch: 1; label: root.model.send-label != "" ? root.model.send-label : @tr("Send anonymous usage reports"); on: root.model.send; toggled(v) => { root.usage-send(v); } } }
    if root.model.state-line != "" : Note { text: root.model.state-line; }
    if root.model.install-id-line != "" : MonoNote { text: root.model.install-id-line; }
    Line {
        Mid { Key { label: root.model.what-label; xs: true; clicked => { root.usage-what(!root.model.what-open); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    Line {
        Mid { Key { label: root.model.privacy-label; xs: true; clicked => { root.usage-privacy(); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.model.what-open && root.model.what-text != "" : Note { text: root.model.what-text; }
    if root.model.what-open && root.model.payload.length > 0 : Rectangle {
        height: payload-col.preferred-height;
        border-radius: Theme.radius;
        border-width: Theme.hairline;
        border-color: Theme.line;
        background: Theme.field;
        payload-col := VerticalLayout {
            padding: 6px;
            spacing: 3px;
            for p in root.model.payload : MonoNote { text: p; font-size: Theme.font-cap; color: Theme.fg-soft; }
        }
    }
    // </content>
}

// ================================================ Beta tester ================================================

export component TesterBody inherits VerticalLayout {
    in property <TesterModel> model;
    in-out property <bool> revealed;                    // the code field shows its text instead of dots

    callback tester-unlink();
    tester-unlink() => { SystemEvents.tester-unlink(); }
    callback tester-remove-code();
    tester-remove-code() => { SystemEvents.tester-remove-code(); }
    callback tester-code-committed(string);
    tester-code-committed(a) => { SystemEvents.tester-code-committed(a); }
    callback tester-use();
    tester-use() => { SystemEvents.tester-use(); }
    callback tester-show-sent(bool);
    tester-show-sent(a) => { SystemEvents.tester-show-sent(a); }

    spacing: 6px;
    alignment: start;

    // <content>
    if root.model.explanation != "" : Note { text: root.model.explanation; }
    if root.model.linked-line != "" : Line {
        Readout { horizontal-stretch: 1; text: root.model.linked-line; font-family: Theme.font-ui; }
        Mid { Key { label: root.model.unlink-label != "" ? root.model.unlink-label : @tr("Unlink"); xs: true; clicked => { root.tester-unlink(); } } }
    }
    if root.model.code-line != "" : Line {
        Readout { horizontal-stretch: 1; text: root.model.code-line; font-family: Theme.font-ui; }
        Mid { Key { label: root.model.remove-label != "" ? root.model.remove-label : @tr("Remove code"); xs: true; clicked => { root.tester-remove-code(); } } }
    }
    if root.model.invalid-line != "" : Note { text: root.model.invalid-line; tone: ChipTone.err; }
    if root.model.error-line != "" : Note { text: root.model.error-line; tone: ChipTone.err; }
    if root.model.field-shown : VerticalLayout {
        spacing: 6px;
        Line {
            code := LineInput {
                horizontal-stretch: 1;
                mono: true;
                hidden: !root.revealed;
                value: root.model.code-draft;
                placeholder: root.model.field-label != "" ? root.model.field-label : @tr("Tester code");
                name: root.model.field-label != "" ? root.model.field-label : @tr("Tester code");
                committed(t) => { root.tester-code-committed(t); }
            }
            Mid { Key {
                label: root.revealed ? @tr("Hide").to-uppercase() : @tr("SHOW");
                small: true;
                min-w: 0px;
                on: root.revealed;
                tooltip: root.revealed ? @tr("Hide") : @tr("Show");
                accessible-label: root.revealed ? @tr("Hide the password") : @tr("Show the password");
                clicked => { root.revealed = !root.revealed; }
            } }
        }
        Rectangle {
            height: Theme.key-sm-h;
            clip: true;
            Key {
                x: 0px;
                y: 0px;
                width: parent.width;
                small: true;
                label: root.model.use-label != "" ? root.model.use-label : @tr("Use this code");
                clicked => {
                    root.tester-code-committed(code.text);
                    root.tester-use();
                }
            }
        }
    }
    if root.model.sent-text != "" : Note { text: root.model.sent-text; }
    Line {
        Mid { Key {
            label: root.model.sent-open ? (root.model.hide-label != "" ? root.model.hide-label : @tr("Hide what is sent")) : (root.model.show-label != "" ? root.model.show-label : @tr("Show what is sent"));
            xs: true;
            clicked => { root.tester-show-sent(!root.model.sent-open); }
        } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.model.sent-open : Rectangle {
        height: preview.preferred-height + 12px;
        border-radius: Theme.radius;
        border-width: Theme.hairline;
        border-color: Theme.line-strong;
        background: Theme.field;
        preview := MonoNote {
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
            text: root.model.sent-preview;
            font-size: Theme.font-cap;
            color: Theme.fg-soft;
        }
    }
    // </content>
}

// ================================================ the two report pages ================================================

// Request a feature (kind 0) and Report a bug or dislike (kind 1): artboard F, one component. A sheet over the whole element it is placed in; the host
// opens it with `report-open(kind)` and sets `shown`; the close key and the backdrop call `report-closed()`.
export component ReportSheet inherits Rectangle {
    in property <ReportPageModel> model;

    callback report-text(string);
    report-text(a) => { SystemEvents.report-text(a); }
    callback report-contact(string);
    report-contact(a) => { SystemEvents.report-contact(a); }
    callback report-kind(int);
    report-kind(a) => { SystemEvents.report-kind(a); }
    callback report-attach(bool);
    report-attach(a) => { SystemEvents.report-attach(a); }
    callback report-probe(bool);
    report-probe(a) => { SystemEvents.report-probe(a); }
    callback report-preview(bool);
    report-preview(a) => { SystemEvents.report-preview(a); }
    callback report-send();
    report-send() => { SystemEvents.report-send(); }
    callback report-closed();
    report-closed() => { SystemEvents.report-closed(); }

    property <bool> bug: root.model.kind == 1;

    // <content>
    if root.model.shown : SheetFrame {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        title: root.model.title;
        sheet-w: 440px;
        pad: 8px;
        gap: 6px;
        dismissed => { root.report-closed(); }
        // the bug page asks first what is being reported: two radios, neither chosen when the page opens
        if root.bug && root.model.problem-kinds.length > 0 : Text {
            min-width: 0px;
            text: root.model.kind-question != "" ? root.model.kind-question : @tr("What are you reporting?");
            wrap: word-wrap;
            font-family: Theme.font-ui;
            font-size: Theme.font-small;
            color: Theme.fg;
        }
        if root.bug && root.model.problem-kinds.length > 0 : Line {
            gap: 16px;
            for k[ki] in root.model.problem-kinds : RadioChoice {
                label: k.label;
                on: ki == root.model.problem-kind-index;
                chosen => { root.report-kind(ki); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            min-width: 0px;
            text: root.model.prompt != "" ? root.model.prompt : root.bug ? @tr("What went wrong, and what were you doing when it did?") : @tr("What would you like FoxSDR to do?");
            wrap: word-wrap;
            font-family: Theme.font-ui;
            font-size: Theme.font-small;
            color: Theme.fg;
        }
        message := TextBox {
            height: root.bug ? 64px : 56px;
            value: root.model.text;
            name: root.model.prompt != "" ? root.model.prompt : root.bug ? @tr("What went wrong, and what were you doing when it did?") : @tr("What would you like FoxSDR to do?");
            edited(t) => { root.report-text(t); }
        }
        if root.model.counter != "" : Readout { text: root.model.counter; color: Theme.dim; height: 14px; }
        if root.bug && root.model.recognised-line != "" : Note { text: root.model.recognised-line; tone: ChipTone.good; }
        Text {
            min-width: 0px;
            text: root.model.contact-label != "" ? root.model.contact-label : @tr("Email or callsign (optional)");
            wrap: word-wrap;
            font-family: Theme.font-ui;
            font-size: Theme.font-small;
            color: Theme.dim;
        }
        LineInput {
            value: root.model.contact;
            name: root.model.contact-label != "" ? root.model.contact-label : @tr("Email or callsign (optional)");
            edited(t) => { root.report-contact(t); }
            committed(t) => { root.report-contact(t); }
        }
        if root.model.no-email-note != "" : Note { text: root.model.no-email-note; tone: ChipTone.warn; }
        if root.bug : Tick { label: root.model.attach-label != "" ? root.model.attach-label : @tr("Attach the diagnostics log"); on: root.model.attach; toggled(v) => { root.report-attach(v); } }
        if root.bug && root.model.attach && root.model.evidence.length > 0 : VerticalLayout {
            spacing: 2px;
            for line in root.model.evidence : MonoNote { text: line; font-size: Theme.font-cap; }
        }
        if root.bug && root.model.attach && root.model.probe-shown : Tick { label: root.model.probe-label != "" ? root.model.probe-label : @tr("Attach the SDRplay diagnostic too"); on: root.model.probe-on; toggled(v) => { root.report-probe(v); } }
        if root.bug && root.model.attach : Tick { label: root.model.preview-label != "" ? root.model.preview-label : @tr("Show what will be sent"); on: root.model.preview-open; toggled(v) => { root.report-preview(v); } }
        if root.bug && root.model.attach && root.model.preview-open : Rectangle {
            height: 140px;
            border-radius: Theme.radius;
            border-width: Theme.hairline;
            border-color: Theme.line-strong;
            background: Theme.field;
            clip: true;
            Flickable {
                x: 8px;
                y: 4px;
                width: parent.width - 16px;
                height: parent.height - 8px;
                content-width: self.width;
                content-height: max(self.height, shown-text.preferred-height);
                shown-text := MonoNote {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    text: root.model.preview-text;
                    font-size: Theme.font-cap;
                    color: Theme.fg-soft;
                    accessible-role: text;
                    accessible-label: root.model.preview-label != "" ? root.model.preview-label : @tr("Show what will be sent");
                }
            }
        }
        if root.bug && root.model.attach && root.model.preview-open && root.model.local-only-line != "" : Note { text: root.model.local-only-line; }
        if root.model.attach-note != "" : Note { text: root.model.attach-note; }
        Rectangle {
            height: Theme.key-sm-h;
            clip: true;
            Key {
                x: 0px;
                y: 0px;
                width: parent.width;
                small: true;
                label: root.model.send-label != "" ? root.model.send-label : @tr("SEND");
                enabled: root.model.send-enabled && message.text != "";
                clicked => { root.report-send(); }
            }
        }
        if root.model.refusal != "" : Note { text: root.model.refusal; }
        if root.model.sent-line != "" : Note { text: root.model.sent-line; tone: root.model.sent-tone; }
    }
    // </content>
}
