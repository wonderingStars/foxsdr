    updates-team-message() => { SystemEvents.updates-team-message(); }
    callback updates-show-again();
    updates-show-again() => { SystemEvents.updates-show-again(); }
    callback updates-open-site();
    updates-open-site() => { SystemEvents.updates-open-site(); }
    callback updates-withdrawn-dismiss();
    updates-withdrawn-dismiss() => { SystemEvents.updates-withdrawn-dismiss(); }

    spacing: 6px;
    alignment: start;

    property <bool> channels: root.model.channel-index >= 0 && !root.model.packaged;   // a Store copy has no channels

    // <content>
    Line {
        Tick {
            horizontal-stretch: 1;
            label: root.model.check-label != "" ? root.model.check-label : @tr("Check for updates at startup");
            on: root.model.check-at-startup;
            toggled(v) => { root.updates-check(v); }
        }
    }
    if root.channels : Line {
        RadioChoice { horizontal-stretch: 1; label: root.model.stable-label != "" ? root.model.stable-label : @tr("Stable releases"); on: root.model.channel-index == 0; chosen => { root.updates-channel(0); } }
    }
    if root.channels : Line {
        RadioChoice { horizontal-stretch: 1; label: root.model.beta-label != "" ? root.model.beta-label : @tr("Every release (beta)"); on: root.model.channel-index == 1; chosen => { root.updates-channel(1); } }
    }
    if root.channels && root.model.channel-help != "" : Note { text: root.model.channel-help; }
    if root.model.privacy != "" : Note { text: root.model.privacy; }
    if root.model.version-line != "" : Note { text: root.model.version-line; color: Theme.fg-soft; }
    if root.model.team-message != "" : Rectangle {
        height: team-note.preferred-height;
        accessible-role: button;
        accessible-label: root.model.team-message;
        accessible-action-default => { root.updates-team-message(); }
        team-note := Note {
            x: 0px;
            y: 0px;
            width: parent.width;
            text: root.model.team-message;
            color: team-area.has-hover ? Theme.fg : Theme.accent-soft;
        }
        team-area := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.updates-team-message(); }
        }
    }
    if root.model.status-line != "" : Note { text: root.model.status-line; tone: root.model.status-tone; }
    if root.model.withdrawn-advice != "" : Note { text: root.model.withdrawn-advice; tone: root.model.status-tone; }
    if root.model.site-label != "" : Line {
        Mid { Key { label: root.model.site-label; small: true; min-w: 0px; clicked => { root.updates-open-site(); } } }
        if root.model.dismiss-label != "" : Mid { Key { label: root.model.dismiss-label; small: true; min-w: 0px; clicked => { root.updates-withdrawn-dismiss(); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.model.show-again && root.model.show-again-label != "" : Line {
        Mid { Key { label: root.model.show-again-label; small: true; min-w: 0px; clicked => { root.updates-show-again(); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    // </content>
}

