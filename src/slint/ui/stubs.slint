// FoxSDR Slint front end - the PHASE-3 CONTRACTS: the components the pages will draw in phase 3 (an instrument face,
// the map, the globe, the scope tube; the patch canvas became ui/patch_page.slint's PatchPage). Phase 1 only fixes their properties and callbacks, so the host and
// the pages can be written against them now; each is drawn as a well-coloured panel with a cap that names it and the words
// "phase 3". Nothing here fires a callback yet.
//
//   InstrumentFace  kind, caption, value, min, max, unit, needle
//   MapView         lat, lon, zoom, tracks, followed;  target-clicked(int), panned(float, float), zoomed(int)
//   GlobeView       lat, lon, tracks, terminator
//   ScopeTube       trace, caption, persistence
import { Theme } from "theme.slint";
import { TipTimer } from "tooltip.slint";

export struct TrackPoint { id: int, lat: float, lon: float, heading: float, label: string }

// What the four share: the well, its line, the cap naming it, and the words "phase 3".
component StubPlate inherits Rectangle {
    in property <string> cap;
    in property <bool> enabled: true;
    in property <string> tooltip;

    background: Theme.well;
    border-width: Theme.hairline;
    border-color: Theme.line;
    border-radius: Theme.radius-panel;
    accessible-role: none;
    accessible-label: root.cap;

    Text {
        x: 10px;
        y: 8px;
        width: max(0px, parent.width - 20px);
        text: root.cap.to-uppercase();
        color: Theme.muted;
        font-family: Theme.font-ui;
        font-size: Theme.font-cap;
        font-weight: Theme.weight-semibold;
        letter-spacing: Theme.cap-spacing;
        overflow: elide;
    }
    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: @tr("phase 3");
        color: Theme.dim;
        font-family: Theme.font-ui;
        font-size: Theme.font-small;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TouchArea {
        enabled: root.enabled;
    }
    TipTimer {
        x: 0px;
        y: 0px;
        hovered: area.has-hover;
        text: root.tooltip;
        anchor-h: root.height;
    }
}

export component InstrumentFace inherits StubPlate {
    in property <string> kind;
    in property <string> caption;
    in property <float> value;
    in property <float> min;
    in property <float> max;
    in property <string> unit;
    in property <float> needle;
    cap: root.kind == "" ? @tr("INSTRUMENT") : @tr("INSTRUMENT · {}", root.kind);
}

export component MapView inherits StubPlate {
    in property <float> lat;
    in property <float> lon;
    in property <float> zoom;
    in property <[TrackPoint]> tracks;
    in property <int> followed: -1;
    callback target-clicked(id: int);
    callback panned(dx: float, dy: float);
    callback zoomed(notches: int);
    cap: @tr("MAP");
}

export component GlobeView inherits StubPlate {
    in property <float> lat;
    in property <float> lon;
    in property <[TrackPoint]> tracks;
    in property <bool> terminator;
    cap: @tr("GLOBE");
}

export component ScopeTube inherits StubPlate {
    in property <image> trace;
    in property <string> caption;
    in property <float> persistence;
    cap: @tr("SCOPE");
}
