<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0

  THE INTERNET PERMISSION IS BELOW, AND IT ARRIVED WITH THE SLICE THAT NEEDS
  IT. This file used to carry, in place of it, the rule that nothing may be
  transmitted before PRIVACY.md describes it field by field. It now does - see
  the OS row of both tables there, which lists the Android value - and
  tests/test_telemetry.cpp still holds the payload to that inventory,
  unchanged, because an Android build sends the SAME fields to the SAME
  endpoints as every other build. Only the transport differs.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Crash reports and the usage record, and nothing else. Both go through
      Java's HttpsURLConnection over JNI
      (android/app/src/main/java/com/foxsdr/app/Net.java) rather than through
      native code, because the NDK ships no OpenSSL and so cpp-httplib has no
      TLS on this platform - see core/net_post.hpp.

      WHAT THIS PERMISSION IS NOT FOR, yet: the plugin catalogue
      (core/plugin_repo.cpp) is still refused here. It needs SHA-256 as well
      as HTTPS, and there is no crypto library on this platform either; see
      its own ANDROID-TODO(uploads-via-java) note.

      AND IT DECIDES NOTHING ON ITS OWN. The permission says what is POSSIBLE;
      core/telemetry.cpp and core/crash_upload.cpp say what happens, and both
      are governed by the user's switch, which is what it always was.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      USB host, for the radios. Declared required="false" ON PURPOSE: a phone
      without USB host support must still be able to install this, because the
      signal generator, recorded I/Q files and (later) a network receiver all
      work without any hardware attached. required="true" would make the Play
      Store hide the app from every device that cannot do OTG, which is a lot
      of them and none of them are useless to this application.
    -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!--
      Landscape is not a preference. The desktop interface is a bench panel:
      a function rail down one side, a spectrum well beside it and a status
      plate under both, and every hard-coded width in it was measured against
      a landscape window. A portrait phone would fold that layout into a column
      that nothing in the code knows how to draw.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.FoxSDR">

        <activity
            android:name="com.foxsdr.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|density|uiMode|navigation"
            android:theme="@style/Theme.FoxSDR">

            <!--
              The name of the .so the NativeActivity loads, WITHOUT the "lib"
              prefix and the ".so" suffix. It must match the CMake target in
              src/platform/android/CMakeLists.txt; a mismatch is an
              UnsatisfiedLinkError the moment the activity starts, with nothing
              on screen to say so.
            -->
            <meta-data android:name="android.app.lib_name" android:value="foxsdr" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              THE RECEIVERS, and the filter is no longer empty. This is what
              makes Android offer to launch FoxSDR when one is plugged in, and
              what grants permission to that device without a dialog - which
              is the difference between "plug it in and it works" and "plug it
              in, find the app, tap through a dialog".

              THE LIST IS GENERATED, never hand-written: res/xml/usb_device_filter.xml
              comes from installer/linux/99-foxsdr-sdr.rules through
              tools/gen-android-usb-ids.py, and tests/test_usb_android_ids.cpp
              pins it to that file, to the Java table in
              java/com/foxsdr/app/UsbIds.java and to the drivers' own
              compiled-in id tables. A radio a driver here can open and this
              filter does not list would be invisible on a phone with nothing
              anywhere to say why.

              IT DOES NOT, ON ITS OWN, OPEN ANYTHING. The descriptor still has
              to be obtained in Java (Usb.java) and handed to the native
              transport; this filter only decides what Android launches us for
              and what it hands us permission for. Everything else about the
              sequence - asking, opening, registering, closing - is in
              Usb.java's own comment.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
