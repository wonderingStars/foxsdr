# udev rules for FoxSDR's native USB radio drivers (src/usb/usbfs_device.cpp).
#
# WHAT THIS FILE IS FOR. FoxSDR's native RTL-SDR, HackRF, RX888 mk2 and
# Mirics MSi2500 drivers talk to the device node at /dev/bus/usb/BBB/DDD
# directly through usbfs (open() + USBDEVFS_* ioctls) - no libusb, no
# SoapySDR module. By default that node is owned by root:root, mode 0664 or
# tighter, so a desktop user's `open()` fails EACCES the moment the dongle is
# plugged in. TAG+="uaccess" is systemd-logind's mechanism for granting the
# user who is logged in at the seat (graphically or at a text console)
# read/write access to exactly that device node for exactly as long as their
# session owns the seat - the same mechanism every other desktop USB
# permission (webcams, printers, most SDR tools) already relies on. The
# MODE/GROUP pair is kept alongside it as a fallback for headless or
# non-logind setups (systemd-less init, an SSH-only box with no seat): add
# the user to the `plugdev` group and the 0660 mode still lets them through.
#
# INSTALLATION.
#   sudo cp 99-foxsdr-sdr.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
# Then unplug and replug the radio (a rule reload does not retroactively
# re-tag a device node that is already sitting there). No reboot needed.
# See installer/linux/README.md for the RTL-SDR kernel-driver note below.
#
# One line per VID:PID, matching exactly the id tables each driver enumerates
# against (see rtlSdrUsbIds() in src/source/rtlsdr_source.cpp, hackrf::kUsbVid
# / kPidHackRfOne / kPidJawbreaker / kPidRad1o in src/source/hackrf_protocol.hpp,
# rx888::kUsbVid / kPidStreamer / kPidBootloader in src/source/rx888_protocol.hpp,
# and msi2500::deviceModels() in src/source/msi2500.cpp) - a device this file
# does not list still enumerates (sysfs needs no permission to read), it just
# cannot be opened until a matching line exists here.

# --- RTL2832U-based RTL-SDR dongles -----------------------------------------
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="0413", ATTR{idProduct}=="6680", TAG+="uaccess", MODE="0660", GROUP="plugdev"
