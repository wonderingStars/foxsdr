# --- HackRF (One, Jawbreaker, rad1o) -----------------------------------------
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6089", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="604b", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="cc15", TAG+="uaccess", MODE="0660", GROUP="plugdev"

# --- RX888 mk2 (SDDC/FX3 firmware) - the bootloader id AND the streamer id --
# it re-enumerates under after firmware load, so both need the rule or the
# second stage is unreachable even though the first opened fine.
SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", ATTR{idProduct}=="00f1", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="04b4", ATTR{idProduct}=="00f3", TAG+="uaccess", MODE="0660", GROUP="plugdev"

# --- Mirics MSi2500 + MSi001 (and the television sticks built on it) -------
# NOT the SDRplay RSP1/RSP2 rows below the MSi2500 in msi2500.cpp's device
# table by driver identity - they enumerate under the same VID and two
# further PIDs and share a rule for the same reason: FoxSDR's native driver
# opens them with a different tuner band plan, not a different transport.
SUBSYSTEM=="usb", ATTR{idVendor}=="1df7", ATTR{idProduct}=="2500", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1df7", ATTR{idProduct}=="3000", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="1df7", ATTR{idProduct}=="3010", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="2040", ATTR{idProduct}=="d300", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="07ca", ATTR{idProduct}=="8591", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="04bb", ATTR{idProduct}=="0537", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="0511", ATTR{idProduct}=="0037", TAG+="uaccess", MODE="0660", GROUP="plugdev"

# --- RTL-SDR and the in-tree DVB driver --------------------------------------
# NO BLACKLIST IS NEEDED HERE, on purpose. Every RTL2832U in the list above
# ships bound to dvb_usb_rtl28xxu (the kernel's own DVB-T driver for this
# silicon) the first time it is plugged in - Linux's equivalent of "an
# RTL-SDR needs Zadig on Windows". openWinUsb() (src/usb/usbfs_device.cpp)
# detaches it automatically at open time with USBDEVFS_DISCONNECT_CLAIM, the
# same ioctl libusb's own Linux backend uses for the same purpose, so this
# transport does not need the device pre-unbound and does not need the
# module blacklisted to work. See installer/linux/README.md if you want the
# module blacklisted anyway (a fully offline DVB-never machine, or a kernel
# old enough that DISCONNECT_CLAIM is unavailable - pre-4.10, not expected on
# anything this ships to and not verified against one).

# Airspy R2 / Airspy Mini (src/source/airspy_protocol.hpp) and Airspy HF+
# Discovery / Dual (src/source/airspyhf_protocol.hpp). Added at integration
# (2026-09-15) when both drivers were routed through the usbfs transport.
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="60a1", TAG+="uaccess", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="03eb", ATTR{idProduct}=="800c", TAG+="uaccess", MODE="0660", GROUP="plugdev"
